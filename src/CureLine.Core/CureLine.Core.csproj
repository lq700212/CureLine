<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- net472 子模块程序集引用产生 NU1701（框架兼容性警告），Windows 上运行已验证，压制 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!--通讯子模块 extern/kaleidoscope（net472）：直接引用其编译输出，不改子模块源码。
      传递依赖必须显式列出，SDK 风格不会自动复制 netfx 引用链的附属 DLL。-->
  <ItemGroup>
    <Reference Include="Kaleidoscope">
      <HintPath>..\..\extern\kaleidoscope\Kaleidoscope\bin\Debug\Kaleidoscope.dll</HintPath>
    </Reference>
    <Reference Include="HslCommunication">
      <HintPath>..\..\extern\kaleidoscope\Kaleidoscope\libs\HslCommunication.dll</HintPath>
    </Reference>
    <Reference Include="NModbus">
      <HintPath>..\..\extern\kaleidoscope\Kaleidoscope\libs\NModbus.dll</HintPath>
    </Reference>
    <Reference Include="NModbus.Serial">
      <HintPath>..\..\extern\kaleidoscope\Kaleidoscope\libs\NModbus.Serial.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- 软件授权设备指纹：kaleidoscope 子模块 LicenseGate 用 WMI 读 MachineGuid/主板/
         磁盘/CPU 序列号，.NET 8 运行时需 System.Management 包（net472 装机自带）。
         位于 net8 系统仅 Windows 可用，本工程 net8.0-windows 无跨平台问题。 -->
    <PackageReference Include="System.Management" Version="10.0.10" />
    <!-- 扫码枪（串口）：子模块 ScannerService 用 System.IO.Ports 读虚拟串口，
         该类库在 net472 是框架内置（Reference），net8 需显式引包。
         现场接线=网口扫码枪经 USB 转接线接入，系统表现为虚拟串口。 -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CureLine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

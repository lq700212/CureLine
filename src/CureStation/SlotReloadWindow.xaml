<Window x:Class="CureStation.SlotReloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SlotReloadViewModel, IsDesignTimeCreatable=False}"
        Title="放回产品固化口径" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Fresh.FgStrong}"
        FontSize="13" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（与其它弹窗同族）：头条即拖动区，系统按钮全关 -->
        <shell:WindowChrome CaptionHeight="36" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <!--
      放回产品固化口径确认窗（V0.0.99）：
      三个决策——接着之前固化继续（累计达标）/ 完全重新开始 / 取消。
      两个数字（已固化多久、还要固化多久）由 VM 算好摆出来，不让操作员心算。
    -->
    <Grid Margin="12">
        <Border CornerRadius="10" Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                Effect="{StaticResource Fx.WinShadow}">
            <!-- 三行 Grid（标题 Auto / 正文 * / 底栏 Auto）：
                 不用 DockPanel——"最后一个子元素填充剩余空间"的规则会把正文
                 撑满并把底栏按钮挤出可视区（SizeToContent 高度按内容算）。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题条：Grid 两列（左标题* / 右关闭钮Auto，
                     避免 DockPanel.LastChildFill 把 ✕ 拉伸飘到中间） -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.LfHeadGrad}"
                        BorderBrush="{DynamicResource Brush.TopbarBorder}" BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0" Height="36" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="放回产品：确认固化时长口径"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.LfHeadFg}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource WinTitleClose}"
                                Height="36" Foreground="{DynamicResource Brush.LfHeadFg}"
                                Content="✕" Click="OnCloseClick" ToolTip="关闭（等同取消）"/>
                    </Grid>
                </Border>

                <!-- 正文 -->
                <StackPanel Grid.Row="1" Margin="18,16,18,14">
                    <TextBlock Text="{Binding Message, FallbackValue='产品放回：请确认本盘固化时长口径'}"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Fresh.FgStrong}"
                               LineHeight="21"/>
                    <!-- 两个口径按钮的说明（把数字摆出来） -->
                    <Border Margin="0,14,0,0" Style="{StaticResource FreshHintBorder}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResumeText, FallbackValue='接着之前固化继续'}"
                                       FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{DynamicResource Brush.Fresh.FgMuted}"/>
                            <TextBlock Text="{Binding FreshText, FallbackValue='完全重新开始固化'}"
                                       Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{DynamicResource Brush.Fresh.FgMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 底栏：三个决策 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.DimLine}"
                        BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FreshButton}"
                                Command="{Binding CancelCommand}" Content="取消"
                                MinWidth="84" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource FreshButton}"
                                Command="{Binding FreshCommand}" Content="完全重新开始固化"
                                MinWidth="150" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource FreshPrimaryButton}"
                                Command="{Binding ResumeCommand}" Content="接着之前固化继续"
                                MinWidth="150"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Light 主题色板（G2 · 浅色渐变浸染，alexruix_lucky-dingo-81 血统）：
      - 主基调：清透浅底 + 品牌蓝渐变顶栏 + 仓位卡"状态色浸染"（8~12% 透明状态色 + 顶部渐变头带）；
      - 键名与 Dark.xaml（G1 深空玻璃舱）完全同名异值——ThemeManager 切字典即换肤，
        主窗/日志悬浮窗全部 DynamicResource 取色，窗体 XAML 零主题分支；
      - 划红线：本字典只放语义键，不含 Fresh.*（弹窗固定浅色键收在 App.xaml 主字典，
        切主题不影响弹窗——拍板"其余弹窗维持浅色，第 2 期再跟主题"）；
      - α 十六进制前缀 = AARRGGBB（#1A=10%、#29=16%、#55=33%、#CC=80%）。
    -->

    <!-- ── 窗底 / 品牌条 ── -->
    <!-- 主窗底：清透浅空（纵向微渐变） -->
    <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDF3FA" Offset="0"/>
        <GradientStop Color="#FBFDFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- 顶栏品牌条：品牌蓝渐变（G2 拍板特征） -->
    <LinearGradientBrush x:Key="Brush.HeaderGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E90FF" Offset="0"/>
        <GradientStop Color="#3D8FE8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.HeaderSubFg" Color="#CFE6FF"/>
    <SolidColorBrush x:Key="Brush.HeaderChipBg" Color="#2EFFFFFF"/>

    <!-- ── 面板玻璃（顶栏行/统计条/组标题条共用"白玻璃"） ── -->
    <LinearGradientBrush x:Key="Brush.PanelGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#EAF4FCFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PanelBg2" Color="#EFF6FD"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#B8D4EE"/>
    <SolidColorBrush x:Key="Brush.PanelBorder2" Color="#8FC1EC"/>

    <!-- ── 仓位卡 ── -->
    <SolidColorBrush x:Key="Brush.CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBg2" Color="#F8FBFF"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#CFE3F6"/>
    <SolidColorBrush x:Key="Brush.CardBorderHover" Color="#8FC1EC"/>

    <!-- ── 文字 ── -->
    <SolidColorBrush x:Key="Brush.FgStrong" Color="#17324F"/>
    <SolidColorBrush x:Key="Brush.FgMid" Color="#476D94"/>
    <SolidColorBrush x:Key="Brush.FgDim" Color="#8FA9C1"/>
    <SolidColorBrush x:Key="Brush.FgOnAccent" Color="#FFFFFF"/>

    <!-- ── 主色 ── -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#1E90FF"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E3F0FC"/>

    <!-- ── 状态色（浅色下取稳重版） ── -->
    <SolidColorBrush x:Key="Brush.StateIdle" Color="#8FA9C1"/>
    <SolidColorBrush x:Key="Brush.StateRed" Color="#E2585F"/>
    <SolidColorBrush x:Key="Brush.StateYellow" Color="#E8A13D"/>
    <SolidColorBrush x:Key="Brush.StateGreen" Color="#2FB677"/>
    <SolidColorBrush x:Key="Brush.StatePurple" Color="#7A5CF0"/>
    <SolidColorBrush x:Key="Brush.StateBlue" Color="#3E9BE0"/>

    <!-- ── 卡内浸染底（状态色 8~10% —— G2"浸染"特征） ── -->
    <SolidColorBrush x:Key="Brush.TintIdle" Color="#1A8FA9C1"/>
    <SolidColorBrush x:Key="Brush.TintGate" Color="#1A7A5CF0"/>
    <SolidColorBrush x:Key="Brush.TintCuring" Color="#1AE8A13D"/>
    <SolidColorBrush x:Key="Brush.TintDone" Color="#1A2FB677"/>
    <SolidColorBrush x:Key="Brush.TintAlarm" Color="#1AE2585F"/>
    <SolidColorBrush x:Key="Brush.TintNotConfigured" Color="#143E9BE0"/>

    <!-- ── 卡顶 5px 状态渐变头带（状态色 → 透明，纵向 80%→0） ── -->
    <LinearGradientBrush x:Key="Brush.HeadIdle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC8FA9C1" Offset="0"/><GradientStop Color="#008FA9C1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadGate" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC7A5CF0" Offset="0"/><GradientStop Color="#007A5CF0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadCuring" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCE8A13D" Offset="0"/><GradientStop Color="#00E8A13D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadDone" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC2FB677" Offset="0"/><GradientStop Color="#002FB677" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadAlarm" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCE2585F" Offset="0"/><GradientStop Color="#00E2585F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadNotConfigured" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC3E9BE0" Offset="0"/><GradientStop Color="#003E9BE0" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── 卡边框浸染（状态色 33% —— 随状态描边） ── -->
    <SolidColorBrush x:Key="Brush.SlotBorderIdle" Color="#558FA9C1"/>
    <SolidColorBrush x:Key="Brush.SlotBorderGate" Color="#557A5CF0"/>
    <SolidColorBrush x:Key="Brush.SlotBorderCuring" Color="#55E8A13D"/>
    <SolidColorBrush x:Key="Brush.SlotBorderDone" Color="#552FB677"/>
    <SolidColorBrush x:Key="Brush.SlotBorderAlarm" Color="#55E2585F"/>
    <SolidColorBrush x:Key="Brush.SlotBorderNotConfigured" Color="#443E9BE0"/>

    <!-- ── 统计条 pill（状态色 16% 底） ── -->
    <SolidColorBrush x:Key="Brush.StatPillIdle" Color="#298FA9C1"/>
    <SolidColorBrush x:Key="Brush.StatPillGate" Color="#297A5CF0"/>
    <SolidColorBrush x:Key="Brush.StatPillCuring" Color="#29E8A13D"/>
    <SolidColorBrush x:Key="Brush.StatPillDone" Color="#292FB677"/>
    <SolidColorBrush x:Key="Brush.StatPillAlarm" Color="#29E2585F"/>
    <!-- ⚡ 下口最短剩余 pill -->
    <SolidColorBrush x:Key="Brush.NextCloseBg" Color="#FFF4DE"/>
    <SolidColorBrush x:Key="Brush.NextCloseBorder" Color="#F0D9A8"/>
    <SolidColorBrush x:Key="Brush.NextCloseFg" Color="#A06B10"/>

    <!-- ── 进度条 / 分隔 ── -->
    <SolidColorBrush x:Key="Brush.BarTrack" Color="#E7F0F8"/>
    <SolidColorBrush x:Key="Brush.DimLine" Color="#E4EEF7"/>

    <!-- ── 幽灵按钮（主窗顶栏专用，随主题双值） ── -->
    <SolidColorBrush x:Key="Brush.GhostBg" Color="#F5FAFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorder" Color="#B8D4EE"/>
    <SolidColorBrush x:Key="Brush.GhostFg" Color="#1F4E79"/>
    <SolidColorBrush x:Key="Brush.GhostHoverBg" Color="#E3F0FC"/>
    <SolidColorBrush x:Key="Brush.GhostBorderHover" Color="#8FC1EC"/>
    <SolidColorBrush x:Key="Brush.GhostPressedBg" Color="#D0E6F9"/>
</ResourceDictionary>

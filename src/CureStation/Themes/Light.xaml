<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Light 主题色板（设计图三段式复刻，V0.0.35 起 2026-10-30 设计图口径）：
      - 主基调：白卡（空闲=浅灰降权）+ 状态色描边（非空闲加厚 1.5px）+ 状态色向白 58% 纵向浸染
        渐变 + 16px 大圆角 + 光圈式大投影（Fx.CardShadow DropShadow），
        品牌蓝渐变顶栏（#1E90FF→#3AA9F7）；旧"5px 状态头带/灯点霓虹"已随设计图退役；
      - 键名与 Dark.xaml（G1 深空玻璃舱）完全同名异值——ThemeManager 切字典即换肤，
        主窗/日志悬浮窗全部 DynamicResource 取色，窗体 XAML 零主题分支；几何量
        （圆角/点发光）用键值（Fn.CardRadius）随主题分流；
      - 划红线：本字典只放语义键，不含 Fresh.*（弹窗固定浅色键收在 App.xaml 主字典，
        切主题不影响弹窗——拍板"其余弹窗维持浅色，第 2 期再跟主题"）；
      - 键名勿改：主窗/LogWindow/XAML 触发器全部按键名取色（改键名要同步两字典 +
        所有 DynamicResource 引用点）。
    -->

    <!-- ══════════ 窗底 / 品牌顶栏 ══════════ -->
    <!-- 主窗底 = G2 stage：160° 淡蓝下的白（HTML linear-gradient(160deg,#EAF1FA,#F5F8FC)） -->
    <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="0.45,1">
        <GradientStop Color="#EAF1FA" Offset="0"/>
        <GradientStop Color="#F5F8FC" Offset="1"/>
    </LinearGradientBrush>
    <!-- 品牌顶栏：品牌蓝横渐变（HTML linear-gradient(90deg,#1E90FF,#3AA9F7)） -->
    <LinearGradientBrush x:Key="Brush.HeaderGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E90FF" Offset="0"/>
        <GradientStop Color="#3AA9F7" Offset="1"/>
    </LinearGradientBrush>
    <!-- 顶栏底边（G2 无边=全透明；Dark 同名键给深色底边） -->
    <SolidColorBrush x:Key="Brush.TopbarBorder" Color="#00FFFFFF"/>
    <!-- 顶栏字：主字白（策略/按钮）、连接文本淡蓝白（HTML #FFFFFF / #EAF5FF） -->
    <SolidColorBrush x:Key="Brush.TopbarFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.HeaderSubFg" Color="#EAF5FF"/>
    <SolidColorBrush x:Key="Brush.HeaderChipBg" Color="#33FFFFFF"/>

    <!-- ══════════ 文字三阶（HTML 深 #17334F / 中 #52739C / 淡 #7A8CA0） ══════════ -->
    <SolidColorBrush x:Key="Brush.FgStrong" Color="#17334F"/>
    <SolidColorBrush x:Key="Brush.FgMid" Color="#52739C"/>
    <SolidColorBrush x:Key="Brush.FgDim" Color="#7A8CA0"/>
    <SolidColorBrush x:Key="Brush.FgOnAccent" Color="#FFFFFF"/>

    <!-- ══════════ 主色 ══════════ -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#1E90FF"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E3F0FC"/>

    <!-- ══════════ 面板玻璃（弹层共用，主窗主要走 G2 专用键） ══════════ -->
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#CBD9E6"/>

    <!-- ══════════ 组标题条 grpbar（N号固化架） ══════════ -->
    <!-- HTML .g2-stage .grpbar：linear-gradient(90deg,#DCEBFA,#F0F6FD) 边 #B9D4EF 字 #1F4E79 竖条 #1E90FF -->
    <LinearGradientBrush x:Key="Brush.RibbonGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DCEBFA" Offset="0"/>
        <GradientStop Color="#F0F6FD" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.RibbonBorder" Color="#B9D4EF"/>
    <SolidColorBrush x:Key="Brush.RibbonFg" Color="#1F4E79"/>
    <SolidColorBrush x:Key="Brush.RibbonBar" Color="#1E90FF"/>

    <!-- ══════════ 仓位卡：几何 / 底 / 边 ══════════ -->
    <!-- 大圆角 16（HTML .g2-card border-radius:16px；CornerRadius 类型资源，Style 借 DynamicResource 取） -->
    <CornerRadius x:Key="Fn.CardRadius">16</CornerRadius>
    <!-- 卡底白、边 rgba(190,210,235,.5)、悬停提亮（G2 白站基因） -->
    <SolidColorBrush x:Key="Brush.CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#80BED2EB"/>
    <SolidColorBrush x:Key="Brush.CardBorderHover" Color="#8FC1EC"/>

    <!-- 状态浸染底（HTML 卡内 linear-gradient(to bottom,状态染 #0%, 白 58%)）；
         Idle 特例=浅灰纯底（设计图空闲卡浅灰降权，V0.0.35） -->
    <LinearGradientBrush x:Key="Brush.TintIdle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5F7FA" Offset="0"/><GradientStop Color="#F5F7FA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.TintGate" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0EAFB" Offset="0"/><GradientStop Color="#FFFFFF" Offset="0.58"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.TintCuring" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6E0" Offset="0"/><GradientStop Color="#FFFFFF" Offset="0.58"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.TintDone" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E7F6EC" Offset="0"/><GradientStop Color="#FFFFFF" Offset="0.58"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.TintAlarm" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDEAEA" Offset="0"/><GradientStop Color="#FFFFFF" Offset="0.58"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.TintNotConfigured" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E3F0FC" Offset="0"/><GradientStop Color="#FFFFFF" Offset="0.58"/>
    </LinearGradientBrush>

    <!-- 状态描边（设计图口径，V0.0.35：idle/未配置=默认 #E3E8EE；gate 紫 / curing 黄 /
         done 绿 / alarm 红，非空闲卡在模板层加厚 1.5px）/-->
    <SolidColorBrush x:Key="Brush.SlotBorderIdle" Color="#FFE3E8EE"/>
    <SolidColorBrush x:Key="Brush.SlotBorderGate" Color="#FFB39DDB"/>
    <SolidColorBrush x:Key="Brush.SlotBorderCuring" Color="#FFFFD54F"/>
    <SolidColorBrush x:Key="Brush.SlotBorderDone" Color="#FFA5D6A7"/>
    <SolidColorBrush x:Key="Brush.SlotBorderAlarm" Color="#FFEF9A9A"/>
    <SolidColorBrush x:Key="Brush.SlotBorderNotConfigured" Color="#FFE3E8EE"/>

    <!-- 卡内左上光斑（HTML .g1-card::before —— G2 无光斑，同名键给全透明；Dark 同名异值径向） -->
    <SolidColorBrush x:Key="Brush.CardGlow" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardGlowGate" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardGlowCuring" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardGlowDone" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardGlowAlarm" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardGlowNotConfigured" Color="#00FFFFFF"/>

    <!-- ══════════ 卡内状态字/数字色（设计图口径，V0.0.35） ══════════ -->
    <SolidColorBrush x:Key="Brush.NumCuring" Color="#F59E0B"/>   <!-- 计时大数字/词（设计图橙） -->
    <SolidColorBrush x:Key="Brush.NumDone" Color="#1B7A38"/>     <!-- ✓ 已放行 -->
    <SolidColorBrush x:Key="Brush.NumGate" Color="#5E35B1"/>     <!-- 待门控 -->
    <SolidColorBrush x:Key="Brush.NumAlarm" Color="#C62828"/>    <!-- ⚠ 占用 -->
    <SolidColorBrush x:Key="Brush.NumIdle" Color="#AEB9C4"/>     <!-- 空闲（淡灰：词/库位码/胶囊字兜底用） -->
    <SolidColorBrush x:Key="Brush.NumSmall" Color="#7A8CA0"/>    <!-- 副文小字（共 X 分·已固化/请检查） -->

    <!-- 状态胶囊 idle 底（卡顶 pill：亮态直接用 Brush.State*，空闲灰底单独一键） -->
    <SolidColorBrush x:Key="Brush.PillIdleBg" Color="#FFEDF1F5"/>

    <!-- ══════════ 状态点色（三色灯语义；HTML .g2-dot 系） ══════════ -->
    <SolidColorBrush x:Key="Brush.StateIdle" Color="#C3CBD3"/>   <!-- 灭灯 -->
    <SolidColorBrush x:Key="Brush.StateRed" Color="#D32F2F"/>    <!-- 红灯亮 -->
    <SolidColorBrush x:Key="Brush.StateYellow" Color="#F59E0B"/> <!-- 黄灯亮 -->
    <SolidColorBrush x:Key="Brush.StateGreen" Color="#43A047"/>  <!-- 绿灯亮 -->
    <SolidColorBrush x:Key="Brush.StatePurple" Color="#7E57C2"/> <!-- 待门控强调（统计条点） -->
    <SolidColorBrush x:Key="Brush.StateBlue" Color="#3E9BE0"/>   <!-- 未配置点 -->

    <!-- ══════════ 卡投影（HTML box-shadow 直译，双主题同名异值） ══════════ -->
    <!-- 亮点 glow 已随设计图退役（V0.0.35：灯点→状态胶囊，胶囊无 glow） -->
    <!-- 卡光圈式大投影（HTML .g2-card box-shadow:0 0 16px 3px rgba(170,195,220,.55)；alarm 卡换红光圈） -->
    <DropShadowEffect x:Key="Fx.CardShadow" Color="#AAC3DC" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="Fx.CardShadowAlarm" Color="#D32F2F" BlurRadius="14" ShadowDepth="0" Opacity="0.32"/>

    <!-- ══════════ 统计胶囊条（HTML .b-stat/.g2-stat：白底圆 18、细边、字 #52739C、数字 #17334F） ══════════ -->
    <SolidColorBrush x:Key="Brush.StatBg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.StatBorder" Color="#FFCBD9E6"/>
    <SolidColorBrush x:Key="Brush.StatFg" Color="#FF52739C"/>
    <SolidColorBrush x:Key="Brush.StatNumFg" Color="#FF17334F"/>
    <!-- ⚡剩余最短提示字色（白胶囊同底边，字走金橙提醒） -->
    <SolidColorBrush x:Key="Brush.NextCloseFg" Color="#B26A00"/>

    <!-- ══════════ 工单双卡（HTML .d-wo/.g2-wo 家族） ══════════ -->
    <CornerRadius x:Key="Fn.WoCardRadius">14</CornerRadius>
    <SolidColorBrush x:Key="Brush.WoBg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.WoBorder" Color="#FFCBD9E6"/>
    <SolidColorBrush x:Key="Brush.WoHeadFg" Color="#FF52739C"/>   <!-- "R 工位 · "前缀 -->
    <SolidColorBrush x:Key="Brush.WoNoFg" Color="#FF17334F"/>     <!-- 单号（粗） -->
    <SolidColorBrush x:Key="Brush.WoBadgeBg" Color="#FFE7F6EC"/>
    <SolidColorBrush x:Key="Brush.WoBadgeFg" Color="#FF1B7A38"/>
    <SolidColorBrush x:Key="Brush.WoBadgeBorder" Color="#FFBBDFC8"/>
    <SolidColorBrush x:Key="Brush.WoNumR" Color="#FF1E90FF"/>     <!-- 已产出数字 R（蓝） -->
    <SolidColorBrush x:Key="Brush.WoNumL" Color="#FF7E57C2"/>     <!-- 已产出数字 L（紫） -->
    <SolidColorBrush x:Key="Brush.WoFootFg" Color="#FF8B95A0"/>   <!-- 计划 N 件小字 -->
    <LinearGradientBrush x:Key="Brush.WoBarR" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E90FF" Offset="0"/><GradientStop Color="#64C4FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.WoBarL" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6A46C2" Offset="0"/><GradientStop Color="#9B7BE8" Offset="1"/>
    </LinearGradientBrush>
    <!-- 工单进度条 glow：G2 无（HTML .g2-wo-bar 无 box-shadow）——x:Null 明确"无"语义（Dark 同名键给霓虹光） -->
    <x:Null x:Key="Fx.WoBarGlowR"/>
    <x:Null x:Key="Fx.WoBarGlowL"/>

    <!-- ══════════ 顶栏按钮（HTML .btn→半透明白玻璃 4px 圆角；【日志】=白底蓝字） ══════════ -->
    <SolidColorBrush x:Key="Brush.GhostBg" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorder" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostHoverBg" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorderHover" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostPressedBg" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBorder" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostFg" Color="#1E90FF"/>

    <!-- ══════════ 进度/分隔 ══════════ -->
    <SolidColorBrush x:Key="Brush.BarTrack" Color="#FFE7EDF4"/>   <!-- 工单进度槽（HTML .g2-wo-bar #E7EDF4） -->
    <SolidColorBrush x:Key="Brush.DimLine" Color="#FFEFEFF1"/>    <!-- 虚线/分隔线 -->

    <!-- ══════════ 日志悬浮窗标题条（HTML .g2-lf .lfhead：linear-gradient(90deg,#1E90FF,#4EC3FF) 白字） ══════════ -->
    <LinearGradientBrush x:Key="Brush.LfHeadGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E90FF" Offset="0"/>
        <GradientStop Color="#4EC3FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.LfHeadFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.LfHeadSubFg" Color="#CCFFFFFF"/>

    <!-- ══════════ 弹窗键板 Fresh.*（V0.0.27 第 2 期起弹窗跟主题） ══════════ -->
    <!-- 功能弹窗（登录/工单/策略/权限/点表/过账配置/IO 测试）共用的样式 Setter 全部
         DynamicResource 指向本段键。此前 Fresh.* 收在 App.xaml 固定浅色（弹窗不随主题
         ——拍板"弹窗维持浅色，第 2 期再统一"），本期起键值搬进两主题字典同名异值：
         本文件（Light）=原 Fresh 固定浅色值一字未动（浅色弹窗视觉零回归），Dark.xaml
         给同名键 G1 深空玻璃口径。键名勿改：App.xaml 弹窗样式的 DynamicResource
         引用点与本段须同步，改键名两处都要动。 -->
    <SolidColorBrush x:Key="Brush.Fresh.CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.HintBg" Color="#EFF6FD"/>
    <SolidColorBrush x:Key="Brush.Fresh.Border" Color="#B8D4EE"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgStrong" Color="#1F4E79"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgMid" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgDim" Color="#888888"/>          <!-- 辅助说明字（原 #888/#666/#999 硬编码统一） -->
    <SolidColorBrush x:Key="Brush.Fresh.ButtonBg" Color="#F5FAFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBg" Color="#E3F0FC"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBorder" Color="#8FC1EC"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonPressedBg" Color="#D0E6F9"/>
    <SolidColorBrush x:Key="Brush.Fresh.Accent" Color="#1E90FF"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentBorder" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentHover" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentPressed" Color="#135EA8"/>
    <SolidColorBrush x:Key="Brush.Fresh.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.Danger" Color="#D9534F"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerBorder" Color="#C9302C"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerHover" Color="#C9302C"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerPressed" Color="#AC2925"/>
    <SolidColorBrush x:Key="Brush.Fresh.Success" Color="#5CB85C"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessBorder" Color="#449D44"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessHover" Color="#449D44"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessPressed" Color="#398439"/>
    <SolidColorBrush x:Key="Brush.Fresh.InputBg" Color="#FFFFFF"/>
    <!-- 窗体骨架（V0.0.27 起弹窗 WindowStyle=None 自绘：底 / 标题条字 / 关闭钮悬停红） -->
    <SolidColorBrush x:Key="Brush.Fresh.WinBg" Color="#F2F7FC"/>          <!-- 窗底（比白卡蓝灰一档，衬托白卡） -->
    <SolidColorBrush x:Key="Brush.Fresh.CloseHoverBg" Color="#E81123"/>   <!-- 关闭钮悬停红（Win32 惯例色，双主题同值） -->
    <!-- 变体面板（分区底/边 + 只读框 + 子卡） -->
    <SolidColorBrush x:Key="Brush.Fresh.PanelBorder" Color="#D7E4F2"/>    <!-- 分区淡边（画布/IO 分区，比卡边更淡一档） -->
    <SolidColorBrush x:Key="Brush.Fresh.SubCardBg" Color="#FBFDFF"/>      <!-- 卡内子区底（IO 测试仓位格） -->
    <SolidColorBrush x:Key="Brush.Fresh.LockedBg" Color="#F5F5F5"/>       <!-- 只读框底（工单已生产数） -->
    <!-- 提示条三族（警示黄 / 错误红 / 成功绿：底-边-字） -->
    <SolidColorBrush x:Key="Brush.Fresh.WarnBg" Color="#FFF8E1"/>
    <SolidColorBrush x:Key="Brush.Fresh.WarnBorder" Color="#F0D48A"/>
    <SolidColorBrush x:Key="Brush.Fresh.WarnFg" Color="#8A6D3B"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrBg" Color="#FDECEA"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrBorder" Color="#F5C6CB"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrFg" Color="#C8102E"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkBg" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkBorder" Color="#C8E6C9"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkFg" Color="#2E7D32"/>
    <!-- 策略可视化画布：画布底（凹面工作区）+ 时长分档四色（浅色块直译原稿）+ 块上双阶字 -->
    <SolidColorBrush x:Key="Brush.Fresh.CanvasBg" Color="#F4F7FA"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierGreen" Color="#C8E6C9"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierYellow" Color="#FFF59D"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierOrange" Color="#FFCC80"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierRed" Color="#EF9A9A"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierFg" Color="#37474F"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierFgSub" Color="#607D8B"/>
    <!-- IO 测试灯珠（OFF 灰 / 未读到浅灰 / 灯边框；ON=Success、ON边=SuccessBorder 复用） -->
    <SolidColorBrush x:Key="Brush.Fresh.DotOff" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Brush.Fresh.DotNoRead" Color="#ECEFF1"/>
    <SolidColorBrush x:Key="Brush.Fresh.DotBorder" Color="#90A4AE"/>
    <!-- DataGrid（列头底 / 选中底 / 网线；字色走 FgStrong/FgMid 复用） -->
    <SolidColorBrush x:Key="Brush.Fresh.GridHeaderBg" Color="#F5FAFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.GridSelBg" Color="#E3F0FC"/>
    <SolidColorBrush x:Key="Brush.Fresh.GridLine" Color="#E7EDF4"/>
    <!-- 滚动条胶囊（常态/悬停） -->
    <SolidColorBrush x:Key="Brush.Fresh.ScrollThumb" Color="#BFD3E8"/>
    <SolidColorBrush x:Key="Brush.Fresh.ScrollThumbHover" Color="#8FC1EC"/>
</ResourceDictionary>

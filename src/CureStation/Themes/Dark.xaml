<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Dark 主题色板（G1 · 深空玻璃舱，CureLine 对比稿 #g/g1 血统）：
      - 主基调：#0B1522 深空蓝底 + rgba(白,5.5%) 玻璃面板 + 霓虹状态色浸染
        （卡底状态色玻璃 + 状态色头带 + 状态色描边，暗底上α比浅色更足才可辨）；
      - 键名与 Light.xaml（G2 浅色渐变浸染）完全同名异值——ThemeManager 切字典
        即换肤，主窗/日志悬浮窗全部 DynamicResource 取色，窗体 XAML 零主题分支；
      - 划红线：本字典只放语义键，不含 Fresh.*（弹窗固定浅色键收在 App.xaml
        主字典，切主题不影响弹窗——拍板"其余弹窗维持浅色，第 2 期再跟主题"）；
      - α 十六进制前缀 = AARRGGBB（#14=8%、#24=14%、#2E=18%、#99=60%）。
    -->

    <!-- ── 窗底 / 品牌条 ── -->
    <!-- 主窗底：深空蓝（纵向微渐变，模拟舱内光） -->
    <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1522" Offset="0"/>
        <GradientStop Color="#101E33" Offset="1"/>
    </LinearGradientBrush>
    <!-- 顶栏品牌条：深玻璃蓝 + 左端亮蓝起手 -->
    <LinearGradientBrush x:Key="Brush.HeaderGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1B2C4A" Offset="0"/>
        <GradientStop Color="#101E33" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.HeaderSubFg" Color="#9FB6D9"/>
    <SolidColorBrush x:Key="Brush.HeaderChipBg" Color="#22FFFFFF"/>

    <!-- ── 面板玻璃（顶栏行/统计条/组标题条共用"白 5.5%"玻璃） ── -->
    <LinearGradientBrush x:Key="Brush.PanelGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12FFFFFF" Offset="0"/>
        <GradientStop Color="#07FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#12203A"/>
    <SolidColorBrush x:Key="Brush.PanelBg2" Color="#0F1C33"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#1F3350"/>
    <SolidColorBrush x:Key="Brush.PanelBorder2" Color="#2E4768"/>

    <!-- ── 仓位卡 ── -->
    <SolidColorBrush x:Key="Brush.CardBg" Color="#132238"/>
    <SolidColorBrush x:Key="Brush.CardBg2" Color="#0F1C31"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#24405E"/>
    <SolidColorBrush x:Key="Brush.CardBorderHover" Color="#3D6088"/>

    <!-- ── 文字 ── -->
    <SolidColorBrush x:Key="Brush.FgStrong" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="Brush.FgMid" Color="#B9C6DE"/>
    <SolidColorBrush x:Key="Brush.FgDim" Color="#7E8AA5"/>
    <SolidColorBrush x:Key="Brush.FgOnAccent" Color="#FFFFFF"/>

    <!-- ── 主色 ── -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#56B4FF"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#2E8FE0"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#3856B4FF"/>

    <!-- ── 状态色（深色下提亮成霓虹） ── -->
    <SolidColorBrush x:Key="Brush.StateIdle" Color="#7E8AA5"/>
    <SolidColorBrush x:Key="Brush.StateRed" Color="#FF5A68"/>
    <SolidColorBrush x:Key="Brush.StateYellow" Color="#FFC24D"/>
    <SolidColorBrush x:Key="Brush.StateGreen" Color="#3DDC97"/>
    <SolidColorBrush x:Key="Brush.StatePurple" Color="#B69CFF"/>
    <SolidColorBrush x:Key="Brush.StateBlue" Color="#56B4FF"/>

    <!-- ── 卡内浸染底（状态色 14% 玻璃 —— 暗底可辨口径） ── -->
    <SolidColorBrush x:Key="Brush.TintIdle" Color="#247E8AA5"/>
    <SolidColorBrush x:Key="Brush.TintGate" Color="#24B69CFF"/>
    <SolidColorBrush x:Key="Brush.TintCuring" Color="#24FFC24D"/>
    <SolidColorBrush x:Key="Brush.TintDone" Color="#243DDC97"/>
    <SolidColorBrush x:Key="Brush.TintAlarm" Color="#26FF5A68"/>
    <SolidColorBrush x:Key="Brush.TintNotConfigured" Color="#1956B4FF"/>

    <!-- ── 卡顶 5px 状态渐变头带（状态色 → 透明，纵向 80%→0） ── -->
    <LinearGradientBrush x:Key="Brush.HeadIdle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC7E8AA5" Offset="0"/><GradientStop Color="#007E8AA5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadGate" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCB69CFF" Offset="0"/><GradientStop Color="#00B69CFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadCuring" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFC24D" Offset="0"/><GradientStop Color="#00FFC24D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadDone" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC3DDC97" Offset="0"/><GradientStop Color="#003DDC97" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadAlarm" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFF5A68" Offset="0"/><GradientStop Color="#00FF5A68" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HeadNotConfigured" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC56B4FF" Offset="0"/><GradientStop Color="#0056B4FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── 卡边框浸染（状态色 60% —— 暗底描边要足） ── -->
    <SolidColorBrush x:Key="Brush.SlotBorderIdle" Color="#997E8AA5"/>
    <SolidColorBrush x:Key="Brush.SlotBorderGate" Color="#99B69CFF"/>
    <SolidColorBrush x:Key="Brush.SlotBorderCuring" Color="#99FFC24D"/>
    <SolidColorBrush x:Key="Brush.SlotBorderDone" Color="#993DDC97"/>
    <SolidColorBrush x:Key="Brush.SlotBorderAlarm" Color="#99FF5A68"/>
    <SolidColorBrush x:Key="Brush.SlotBorderNotConfigured" Color="#8856B4FF"/>

    <!-- ── 统计条 pill（状态色 18% 底） ── -->
    <SolidColorBrush x:Key="Brush.StatPillIdle" Color="#2E7E8AA5"/>
    <SolidColorBrush x:Key="Brush.StatPillGate" Color="#2EB69CFF"/>
    <SolidColorBrush x:Key="Brush.StatPillCuring" Color="#2EFFC24D"/>
    <SolidColorBrush x:Key="Brush.StatPillDone" Color="#2E3DDC97"/>
    <SolidColorBrush x:Key="Brush.StatPillAlarm" Color="#30FF5A68"/>
    <!-- ⚡ 下口最短剩余 pill -->
    <SolidColorBrush x:Key="Brush.NextCloseBg" Color="#26FFC24D"/>
    <SolidColorBrush x:Key="Brush.NextCloseBorder" Color="#55FFC24D"/>
    <SolidColorBrush x:Key="Brush.NextCloseFg" Color="#FFC24D"/>

    <!-- ── 进度条 / 分隔 ── -->
    <SolidColorBrush x:Key="Brush.BarTrack" Color="#14283F"/>
    <SolidColorBrush x:Key="Brush.DimLine" Color="#1C3050"/>

    <!-- ── 幽灵按钮（主窗顶栏专用，随主题双值） ── -->
    <SolidColorBrush x:Key="Brush.GhostBg" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorder" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostFg" Color="#D9E6FF"/>
    <SolidColorBrush x:Key="Brush.GhostHoverBg" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorderHover" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostPressedBg" Color="#2CFFFFFF"/>
</ResourceDictionary>

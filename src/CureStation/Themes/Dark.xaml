<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Dark 主题色板（G1 · 深空玻璃舱，docs/UI设计_固化架显示区优化_对比稿.html #g/g1 直译）：
      - 主基调：#0E1626 深空底（左上径向冷光）+ rgba(白 5.5%) 玻璃卡 + 状态色浸染玻璃 +
        状态色外描边 + 霓虹数字发光；报警卡整卡红光圈（Fx.CardShadowAlarm）；
        卡无头带/无灯点（Brush.Head*/Fx.DotGlow* 已随设计图退役，V0.0.35 与 Light 同架构）；
      - 键名与 Light.xaml（设计图三段式复刻）完全同名异值——ThemeManager 切字典即换肤,
        主窗/日志悬浮窗全部 DynamicResource 取色，窗体 XAML 零主题分支；几何量
        （圆角）用键值（Fn.CardRadius）随主题分流；
      - 划红线：本字典只放语义键，不含 Fresh.*（弹窗固定浅色键收在 App.xaml
        主字典，切主题不影响弹窗——拍板"其余弹窗维持浅色，第 2 期再统一"）；
      - 键名勿改：主窗/LogWindow/XAML 触发器全部按键名取色（改键名要同步两字典 +
        所有 DynamicResource 引用点）；
      - α 十六进制前缀 = AARRGGBB（#14=8%、#26=15%、#29=16%、#2E=18%、#61=38%、#80=50%）。
    -->

    <!-- ══════════ 窗底 / 品牌顶栏 ══════════ -->
    <!-- 主窗底 = G1 stage：ellipse at 18% 12% 的深蓝冷光晕开到 #0E1626（HTML g1-stage 直译） -->
    <RadialGradientBrush x:Key="Brush.WindowBg" Center="0.18,0.12" GradientOrigin="0.18,0.12"
                         RadiusX="1.35" RadiusY="1.2">
        <GradientStop Color="#1B2A45" Offset="0"/>
        <GradientStop Color="#0E1626" Offset="0.55"/>
        <GradientStop Color="#0E1626" Offset="1"/>
    </RadialGradientBrush>
    <!-- 品牌顶栏：深蓝黑实底（HTML .topbar #101A2C）+ 底边弱蓝框 -->
    <LinearGradientBrush x:Key="Brush.HeaderGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#101A2C" Offset="0"/>
        <GradientStop Color="#101A2C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.TopbarBorder" Color="#4078A0DC"/>
    <SolidColorBrush x:Key="Brush.TopbarFg" Color="#9DB8DC"/>
    <SolidColorBrush x:Key="Brush.HeaderSubFg" Color="#9DB8DC"/>
    <SolidColorBrush x:Key="Brush.HeaderChipBg" Color="#22FFFFFF"/>

    <!-- ══════════ 文字三阶（HTML #EAF3FF / #9DB8DC / #7E9BBF） ══════════ -->
    <SolidColorBrush x:Key="Brush.FgStrong" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="Brush.FgMid" Color="#9DB8DC"/>
    <SolidColorBrush x:Key="Brush.FgDim" Color="#7E9BBF"/>
    <SolidColorBrush x:Key="Brush.FgOnAccent" Color="#FFFFFF"/>

    <!-- ══════════ 主色 ══════════ -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#2E8FE0"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#3856B4FF"/>

    <!-- ══════════ 面板玻璃（弹层共用） ══════════ -->
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#12203A"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#1F3350"/>

    <!-- ══════════ 组标题条 grpbar（N号固化架） ══════════ -->
    <!-- HTML .g1-stage .grpbar：rgba(255,255,255,.05) 边 rgba(120,160,220,.25) 字 #9DB8DC 竖条 #4FC3F7 -->
    <SolidColorBrush x:Key="Brush.RibbonGrad" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.RibbonBorder" Color="#4078A0DC"/>
    <SolidColorBrush x:Key="Brush.RibbonFg" Color="#9DB8DC"/>
    <SolidColorBrush x:Key="Brush.RibbonBar" Color="#4FC3F7"/>

    <!-- ══════════ 仓位卡：几何 / 底 / 边 ══════════ -->
    <CornerRadius x:Key="Fn.CardRadius">14</CornerRadius>
    <!-- 玻璃卡底 rgba(255,255,255,.055)、边 rgba(148,180,225,.16)、悬停提亮 -->
    <SolidColorBrush x:Key="Brush.CardBg" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#2994B4E1"/>
    <SolidColorBrush x:Key="Brush.CardBorderHover" Color="#5294B4E1"/>

    <!-- 状态浸染底（HTML .g1-card 状态玻璃纯色；gate/idle 无特化=默认玻璃） -->
    <SolidColorBrush x:Key="Brush.TintIdle" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.TintGate" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.TintCuring" Color="#17FFB300"/>
    <SolidColorBrush x:Key="Brush.TintDone" Color="#1400E676"/>
    <SolidColorBrush x:Key="Brush.TintAlarm" Color="#21FF1744"/>
    <SolidColorBrush x:Key="Brush.TintNotConfigured" Color="#1956B4FF"/>

    <!-- 状态描边（HTML .g1-card 状态边 rgba；idle/gate 回默认玻璃边） -->
    <SolidColorBrush x:Key="Brush.SlotBorderIdle" Color="#2994B4E1"/>
    <SolidColorBrush x:Key="Brush.SlotBorderGate" Color="#2994B4E1"/>
    <SolidColorBrush x:Key="Brush.SlotBorderCuring" Color="#61FFB300"/>
    <SolidColorBrush x:Key="Brush.SlotBorderDone" Color="#6100E676"/>
    <SolidColorBrush x:Key="Brush.SlotBorderAlarm" Color="#80FF1744"/>
    <SolidColorBrush x:Key="Brush.SlotBorderNotConfigured" Color="#4D56B4FF"/>

    <!-- 卡内左上光斑（HTML .g1-card::before 径向冷光斑；状态色跟随，拉伸补偿长卡） -->
    <RadialGradientBrush x:Key="Brush.CardGlow" Center="-0.30,-0.40" GradientOrigin="-0.30,-0.40"
                         RadiusX="0.75" RadiusY="1.15">
        <GradientStop Color="#334FC3F7" Offset="0"/>
        <GradientStop Color="#004FC3F7" Offset="0.7"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.CardGlowGate" Center="-0.30,-0.40" GradientOrigin="-0.30,-0.40"
                         RadiusX="0.75" RadiusY="1.15">
        <GradientStop Color="#334FC3F7" Offset="0"/>
        <GradientStop Color="#004FC3F7" Offset="0.7"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.CardGlowCuring" Center="-0.30,-0.40" GradientOrigin="-0.30,-0.40"
                         RadiusX="0.75" RadiusY="1.15">
        <GradientStop Color="#38FFB300" Offset="0"/>
        <GradientStop Color="#00FFB300" Offset="0.7"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.CardGlowDone" Center="-0.30,-0.40" GradientOrigin="-0.30,-0.40"
                         RadiusX="0.75" RadiusY="1.15">
        <GradientStop Color="#3300E676" Offset="0"/>
        <GradientStop Color="#0000E676" Offset="0.7"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.CardGlowAlarm" Center="-0.30,-0.40" GradientOrigin="-0.30,-0.40"
                         RadiusX="0.75" RadiusY="1.15">
        <GradientStop Color="#4DFF1744" Offset="0"/>
        <GradientStop Color="#00FF1744" Offset="0.7"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.CardGlowNotConfigured" Center="-0.30,-0.40" GradientOrigin="-0.30,-0.40"
                         RadiusX="0.75" RadiusY="1.15">
        <GradientStop Color="#2656B4FF" Offset="0"/>
        <GradientStop Color="#0056B4FF" Offset="0.7"/>
    </RadialGradientBrush>

    <!-- ══════════ 卡内状态字/数字色（HTML .g1-num 五分支，霓虹口径） ══════════ -->
    <!-- NumCuring 双主题异值：Light=设计图橙 #F59E0B / Dark=G1 霓虹浅白（G1 无设计图，保持原拍板） -->
    <SolidColorBrush x:Key="Brush.NumCuring" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="Brush.NumDone" Color="#00E676"/>
    <SolidColorBrush x:Key="Brush.NumGate" Color="#B39DDB"/>
    <SolidColorBrush x:Key="Brush.NumAlarm" Color="#FF5252"/>
    <SolidColorBrush x:Key="Brush.NumIdle" Color="#4A5B78"/>
    <SolidColorBrush x:Key="Brush.NumSmall" Color="#7E9BBF"/>

    <!-- ══════════ 状态点色（三色灯语义；HTML .g1-dot 系霓虹） ══════════ -->
    <SolidColorBrush x:Key="Brush.StateIdle" Color="#3A4A63"/>
    <SolidColorBrush x:Key="Brush.StateRed" Color="#FF1744"/>
    <SolidColorBrush x:Key="Brush.StateYellow" Color="#FFB300"/>
    <SolidColorBrush x:Key="Brush.StateGreen" Color="#00E676"/>
    <SolidColorBrush x:Key="Brush.StatePurple" Color="#7E57C2"/>
    <SolidColorBrush x:Key="Brush.StateBlue" Color="#56B4FF"/>

    <!-- 状态胶囊 idle 底（卡顶 pill，与 Light 同名异值：亮态直接用 Brush.State*） -->
    <SolidColorBrush x:Key="Brush.PillIdleBg" Color="#14FFFFFF"/>

    <!-- ══════════ 霓虹发光 / 卡投影（HTML box-shadow 直译，双主题同名异值） ══════════ -->
    <!-- 灯点 glow 已随设计图退役（V0.0.35：灯点→状态胶囊） -->
    <!-- 卡投影（HTML .g1-card 0 3px 10px rgba(0,0,0,.35)；alarm 卡换红光圈 0 0 14px rgba(255,23,68,.28)） -->
    <DropShadowEffect x:Key="Fx.CardShadow" Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.38"/>
    <DropShadowEffect x:Key="Fx.CardShadowAlarm" Color="#FF1744" BlurRadius="14" ShadowDepth="1" Opacity="0.30"/>

    <!-- ══════════ 统计胶囊条（HTML .g1-stat：白 5% 玻璃、边 rgba(148,180,225,.18)、字 #9DB8DC、数字 #EAF3FF） ══════════ -->
    <SolidColorBrush x:Key="Brush.StatBg" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.StatBorder" Color="#2E94B4E1"/>
    <SolidColorBrush x:Key="Brush.StatFg" Color="#FF9DB8DC"/>
    <SolidColorBrush x:Key="Brush.StatNumFg" Color="#FFEAF3FF"/>
    <!-- ⚡剩余最短提示字色 -->
    <SolidColorBrush x:Key="Brush.NextCloseFg" Color="#FFC24D"/>

    <!-- ══════════ 工单双卡（HTML .g1-wo 家族） ══════════ -->
    <CornerRadius x:Key="Fn.WoCardRadius">12</CornerRadius>
    <SolidColorBrush x:Key="Brush.WoBg" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.WoBorder" Color="#2E94B4E1"/>
    <SolidColorBrush x:Key="Brush.WoHeadFg" Color="#FF9DB8DC"/>
    <SolidColorBrush x:Key="Brush.WoNoFg" Color="#FFEAF3FF"/>
    <SolidColorBrush x:Key="Brush.WoBadgeBg" Color="#2400E676"/>
    <SolidColorBrush x:Key="Brush.WoBadgeFg" Color="#FF00E676"/>
    <SolidColorBrush x:Key="Brush.WoBadgeBorder" Color="#4D00E676"/>
    <SolidColorBrush x:Key="Brush.WoNumR" Color="#FF64D2FF"/>
    <SolidColorBrush x:Key="Brush.WoNumL" Color="#FFCE93D8"/>
    <SolidColorBrush x:Key="Brush.WoFootFg" Color="#FF7E9BBF"/>
    <LinearGradientBrush x:Key="Brush.WoBarR" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0A84FF" Offset="0"/><GradientStop Color="#64D2FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.WoBarL" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#9C27B0" Offset="0"/><GradientStop Color="#CE93D8" Offset="1"/>
    </LinearGradientBrush>
    <!-- G1 工单进度条霓虹光（HTML .g1-wo-bar i box-shadow 0 0 8px；Light 同名键=x:Null 即无光） -->
    <DropShadowEffect x:Key="Fx.WoBarGlowR" Color="#64D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.55"/>
    <DropShadowEffect x:Key="Fx.WoBarGlowL" Color="#CE93D8" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>

    <!-- ══════════ 顶栏按钮（HTML .btn #1B2740 底 #33486B 边 #9DB8DC 字；【日志】=蓝玻璃亮字） ══════════ -->
    <SolidColorBrush x:Key="Brush.GhostBg" Color="#FF1B2740"/>
    <SolidColorBrush x:Key="Brush.GhostBorder" Color="#FF33486B"/>
    <SolidColorBrush x:Key="Brush.GhostFg" Color="#FF9DB8DC"/>
    <SolidColorBrush x:Key="Brush.GhostHoverBg" Color="#FF22345A"/>
    <SolidColorBrush x:Key="Brush.GhostBorderHover" Color="#FF4C6E9B"/>
    <SolidColorBrush x:Key="Brush.GhostPressedBg" Color="#FF182348"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBg" Color="#2E0A84FF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBorder" Color="#6664D2FF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostFg" Color="#FF64D2FF"/>

    <!-- ══════════ 进度/分隔 ══════════ -->
    <SolidColorBrush x:Key="Brush.BarTrack" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Brush.DimLine" Color="#2978A0DC"/>

    <!-- ══════════ 日志悬浮窗标题条（HTML .g1-lf .lfhead：蓝玻璃横渐变 #EAF3FF 字） ══════════ -->
    <LinearGradientBrush x:Key="Brush.LfHeadGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#380A84FF" Offset="0"/>
        <GradientStop Color="#1464D2FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.LfHeadFg" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="Brush.LfHeadSubFg" Color="#B3EAF3FF"/>

    <!-- ══════════ 弹窗键板 Fresh.*（V0.0.27 第 2 期起弹窗跟主题） ══════════ -->
    <!-- 与 Light.xaml 同名异值的弹窗深色版：G1 深空玻璃口径——实底深蓝卡（#12203A，
         对齐 PanelBg）+ 板岩蓝边（#33486B，对齐 GhostBorder）+ 亮色文字三阶
         （#EAF3FF/#9DB8DC/#7E9BBF）。 α 十六进制前缀 = AARRGGBB（#26=15%、#33=20%、
         #4D=30%——状态浸染块用低透明底贴深空，与主窗 G1 卡同款做法）。键名勿改。 -->
    <SolidColorBrush x:Key="Brush.Fresh.CardBg" Color="#FF12203A"/>
    <SolidColorBrush x:Key="Brush.Fresh.HintBg" Color="#FF16263F"/>
    <SolidColorBrush x:Key="Brush.Fresh.Border" Color="#FF33486B"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgStrong" Color="#FFEAF3FF"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgMid" Color="#FF9DB8DC"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgDim" Color="#FF7E9BBF"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonBg" Color="#FF1B2740"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBg" Color="#FF22345A"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBorder" Color="#FF4C6E9B"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonPressedBg" Color="#FF182348"/>
    <SolidColorBrush x:Key="Brush.Fresh.Accent" Color="#FF2E8FE0"/>        <!-- 主按钮蓝底压暗一档，保白字对比 -->
    <SolidColorBrush x:Key="Brush.Fresh.AccentBorder" Color="#FF47AEFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentHover" Color="#FF389BEB"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentPressed" Color="#FF2568C4"/>
    <SolidColorBrush x:Key="Brush.Fresh.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.Danger" Color="#FFE5473F"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerBorder" Color="#FFFF8A80"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerHover" Color="#FFFF6E63"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerPressed" Color="#FFB32720"/>
    <SolidColorBrush x:Key="Brush.Fresh.Success" Color="#FF34A853"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessBorder" Color="#FF7ED9A5"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessHover" Color="#FF4CC97B"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessPressed" Color="#FF208142"/>
    <SolidColorBrush x:Key="Brush.Fresh.InputBg" Color="#FF0F1D33"/>
    <!-- 窗体骨架（深空窗底 / 关闭钮悬停红沿用 Win32 惯例双主题同值） -->
    <SolidColorBrush x:Key="Brush.Fresh.WinBg" Color="#FF0F1B30"/>
    <SolidColorBrush x:Key="Brush.Fresh.CloseHoverBg" Color="#E81123"/>
    <!-- 变体面板 -->
    <SolidColorBrush x:Key="Brush.Fresh.PanelBorder" Color="#FF1F3350"/>
    <SolidColorBrush x:Key="Brush.Fresh.SubCardBg" Color="#FF142238"/>
    <SolidColorBrush x:Key="Brush.Fresh.LockedBg" Color="#FF16263F"/>
    <!-- 提示条三族（低透明状态浸染底 + 字走主窗状态数字色 NumAlarm/NumDone 口径） -->
    <SolidColorBrush x:Key="Brush.Fresh.WarnBg" Color="#26FFB300"/>
    <SolidColorBrush x:Key="Brush.Fresh.WarnBorder" Color="#4DFFB300"/>
    <SolidColorBrush x:Key="Brush.Fresh.WarnFg" Color="#FFC24D"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrBg" Color="#26FF1744"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrBorder" Color="#4DFF1744"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrFg" Color="#FF5252"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkBg" Color="#2600E676"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkBorder" Color="#4D00E676"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkFg" Color="#FF00E676"/>
    <!-- 策略可视化画布：画布底（近深空更凹一档）+ 分档四色改低透明霓虹浸染（块上字换亮字） -->
    <SolidColorBrush x:Key="Brush.Fresh.CanvasBg" Color="#FF0B1322"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierGreen" Color="#2600E676"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierYellow" Color="#26FFB300"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierOrange" Color="#26FF9100"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierRed" Color="#26FF1744"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierFg" Color="#FFEAF3FF"/>
    <SolidColorBrush x:Key="Brush.Fresh.TierFgSub" Color="#FF9DB8DC"/>
    <!-- IO 测试灯珠（OFF 深灰蓝 / 未读到近底 / 灯边框） -->
    <SolidColorBrush x:Key="Brush.Fresh.DotOff" Color="#FF4A5B78"/>
    <SolidColorBrush x:Key="Brush.Fresh.DotNoRead" Color="#FF22334D"/>
    <SolidColorBrush x:Key="Brush.Fresh.DotBorder" Color="#FF4A5B78"/>
    <!-- DataGrid -->
    <SolidColorBrush x:Key="Brush.Fresh.GridHeaderBg" Color="#FF16263F"/>
    <SolidColorBrush x:Key="Brush.Fresh.GridSelBg" Color="#FF2E3D5E"/>
    <SolidColorBrush x:Key="Brush.Fresh.GridLine" Color="#FF293A56"/>
    <!-- 滚动条胶囊 -->
    <SolidColorBrush x:Key="Brush.Fresh.ScrollThumb" Color="#FF33486B"/>
    <SolidColorBrush x:Key="Brush.Fresh.ScrollThumbHover" Color="#FF4C6E9B"/>
</ResourceDictionary>

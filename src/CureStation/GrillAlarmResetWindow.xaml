<Window x:Class="CureStation.GrillAlarmResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GrillAlarmResetCoordinator, IsDesignTimeCreatable=False}"
        Title="光栅报警 · 人工复位 - 固化程控"
        Width="480" Height="430" MinWidth="420" MinHeight="300"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.FgMid}"
        FontSize="12">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（与日志窗/各弹窗同族）：头条即命中拖动区（CaptionHeight=36
             与条高对齐），边沿 6px 缩放；系统按钮全关，✕ 内置于头条右端 -->
        <shell:WindowChrome CaptionHeight="36" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <!--
      光栅报警·人工复位悬浮窗（V0.0.69，用户拍板）：
      - 人工复位模式下光栅让空不复位（红灯+蜂鸣保持），列出正在报警的库位，
        操作员逐行【解除报警】或一键【全部解除】后才停蜂鸣灭红灯；
      - 清单热更（用户拍板）：绑 coordinator.Items 差分集合——报警期间新库位
        加入/解除即删行，窗开着不用重开；全解除自动收窗（CloseGrillAlarmReset）；
      - 非模态单例（DialogService.ShowGrillAlarmReset 防重复开）；Owner=主窗，
        主窗退出联动关闭；显示位置=屏幕工作区右下角（code-behind
        PositionBottomRight，不记忆位置——日志窗同款拍板口径）；
      - 全部取色走语义键（Brush.*）→ ThemeManager 切主题本窗自动跟换。
    -->
    <Grid Margin="14">
        <Border CornerRadius="10" Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                Effect="{StaticResource Fx.WinShadow}">
            <DockPanel>
                <!-- 标题条（与弹窗族同构：红点=报警警示 + 标题；右侧计数 + ✕） -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.LfHeadGrad}"
                        BorderBrush="{DynamicResource Brush.TopbarBorder}" BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0"
                        Height="36" Padding="12,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 红点：报警警示（区别于日志窗绿点=日常） -->
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource Brush.StateRed}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="光栅报警 · 人工复位" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.LfHeadFg}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource WinTitleClose}"
                                Height="36" Foreground="{DynamicResource Brush.LfHeadFg}"
                                Content="✕" Click="OnCloseClick" ToolTip="关闭窗（报警不消失，红卡仍可见）"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding AlarmCountText, FallbackValue=暂无正在报警的库位}"
                                   Foreground="{DynamicResource Brush.LfHeadSubFg}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </DockPanel>
                </Border>

                <!-- 底部操作条：全部解除 + 说明（先声明靠 Dock 底部） -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.DimLine}"
                        BorderThickness="0,1,0,0" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="解除蜂鸣与红灯需逐库位确认；固化计时不受影响。"
                                   Foreground="{DynamicResource Brush.FgDim}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Style="{StaticResource FreshDangerButton}"
                                Command="{Binding ResetAllCommand}"
                                Content="全部解除" MinWidth="96" ToolTip="对当前清单内全部库位执行人工复位"/>
                    </Grid>
                </Border>

                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 提示行：模式说明（文本固定， isVisible 由报警行数无关） -->
                    <Border Grid.Row="0" CornerRadius="6" Padding="10,7" Margin="0,0,0,8"
                            Background="{DynamicResource Brush.PanelBg}"
                            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.FgMid}">
                            <Run Text="人工复位模式：正在报警的库位在下方清单中，逐一确认现场已无人手后点击"/>
                            <Run Text="【解除报警】" FontWeight="Bold"/>
                            <Run Text="。新报警会自动加入清单，处理完的自动移除。"/>
                        </TextBlock>
                    </Border>

                    <!-- 报警清单（差分热更集合；行卡） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items, FallbackValue={x:Null}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                                            Background="{DynamicResource Brush.PanelBg}"
                                            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 库位编码+架层号（主窗卡片标题同源，一眼对上现场） -->
                                            <TextBlock Text="{Binding Caption, FallbackValue=A03 · 架1-层3}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.FgStrong}"
                                                       VerticalAlignment="Center"/>
                                            <!-- 正在报警胶囊（红字醒目） -->
                                            <Border Grid.Column="1" CornerRadius="9" Padding="8,3"
                                                    Background="{DynamicResource Brush.PanelBg}"
                                                    BorderBrush="{DynamicResource Brush.StateRed}"
                                                    BorderThickness="1" Margin="12,0,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="正在报警" FontSize="11"
                                                           Foreground="{DynamicResource Brush.StateRed}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="2" Style="{StaticResource FreshPrimaryButton}"
                                                    Command="{Binding Reset}"
                                                    Content="解除报警" MinWidth="92" ToolTip="人工确认现场已处理：红灯灭、黄灯复亮（蜂鸣停）"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>

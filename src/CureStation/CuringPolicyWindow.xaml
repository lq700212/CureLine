<Window x:Class="CureStation.CuringPolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:local="clr-namespace:CureStation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CuringPolicyViewModel, IsDesignTimeCreatable=False}"
        Title="工艺策略（固化时长 / 光栅门控）"
        Height="760" Width="1280"
        WindowStartupLocation="CenterScreen" MinWidth="1180" MinHeight="660"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Fresh.FgMid}"
        Icon="Assets/app.ico"
        FontSize="12">
    <Window.Resources>
        <!-- 点选浮层显隐（与 MesPostConfigWindow 同款窗内转换器） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 策略库"生效中"徽标：本项策略名 == VM.ActiveName → true。
             DataTrigger 的 Condition 只认静态值，两段动态绑定不能直接互比，
             用 MultiBinding 一并喂给转换器返回 bool（详见转换器类头注释）。 -->
        <local:StringEqualsConverter x:Key="StringEquals"/>

        <!-- ===== 光栅条控件样式（V0.0.74；V0.0.91 触摸屏放大）=====
             开关=轨道+滑块+文字（开=蓝底白字/滑块靠右；关=浅底灰字/滑块靠左），
             分段按钮=两枚并排胶囊（选中蓝底反白，未选浅底）。
             V0.0.91 客户实机反馈：触摸屏上按钮太小难点准——开关/胶囊统一放大
             （视觉高 22→34px、字 11→13、轨道 30×14→40×20/Padding 加厚），
             多占的宽度由竖分隔 Margin 16→8 补回，整条带总宽基本不变。
             色全走 Brush.Fresh.* 语义键，深浅主题自动跟随。 -->
        <Style x:Key="GrillSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" Padding="12,6"
                                Background="{DynamicResource Brush.Fresh.ButtonBg}"
                                BorderBrush="{DynamicResource Brush.Fresh.Border}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                        Background="{DynamicResource Brush.Fresh.DotOff}" VerticalAlignment="Center">
                                    <Ellipse x:Name="Knob" Width="16" Height="16"
                                             Fill="{DynamicResource Brush.Fresh.CardBg}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.AccentBorder}"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Fresh.OnAccent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GrillSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- 单枚胶囊不带边框：外框由使用处的"分段容器"Border 提供，
                             本枚只负责底色/悬停/选中三态（悬停微底、选中蓝底反白） -->
                        <Border x:Name="Bd" CornerRadius="4" Padding="14,4" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（V0.0.27 弹窗统一）：标题条命中拖动 + 边沿 6px 缩放 -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <!--★★ 工艺策略窗（对齐 AgingTestSystem 配方管理"模板+即改即落"+ 本项目 Fresh 风）：
         V0.0.44 布局重排（用户拍板：画布能直接改后，原"策略编辑面板+每仓位覆盖表"
         两个区域整体删除）——
         左：策略库（预置策略带【预置】标记，激活一个生效）+ 每层覆盖折叠（高级）；
         右上：参数条（策略名/全局时长+时间单位 时·分/断电续算，
         长说明收 ToolTip；单位只换显示口径，存储恒为分钟，V0.0.56 秒档删除）；
         画布下方：光栅控制带（V0.0.74 从参数条下移；V0.0.96 统一跟随策略）——标志物 + 门控开关 +
          信号类型（常开/常闭）+ 报警解除（人工/自动）四项全部随选中策略保存/激活；
          右主：仓位时长画布（全宽，主编辑区，傻瓜式）——左键单击选格直接浮层输
         时长、左键拖框批量选（橡皮筋透明只描边，Ctrl 叠加）、Ctrl+单击加选/减选、
         中键平移、滚轮缩放、双击空白复位、右键适应图像、Esc 清选择；普通格=
         时长四档色（绿/黄/橙/红），特殊格（SlotMinutes 配了独立覆盖，VM 真识别）
         特殊格（SlotMinutes 配了独立覆盖，VM 真识别）
         =主题蓝；选中=FgStrong 描边；浮层【清除】删覆盖恢复跟随层/全局。
         底部按钮：预置选中→【套用目标▾ + 套用所选模板】（目标=自定义或用户
         自建策略，列表项带"生效中"徽标=当前激活策略）；自定义选中→
         【激活并生效】【仅保存】。
         「自定义」恒存在（防删 + 载入缺时自愈补回——系统缺省策略）；预置
         不能直接保存/激活/删除（出厂模板保证可回溯）。
         取色全走 Brush.Fresh.*（Tier* 四键双主题同名异值：Light=原稿浅色块、
         Dark=低透明霓虹浸染+亮字）；窗口骨架统一自绘标题条。-->
    <!-- 圆角弹窗骨架（全弹窗统一）：透明窗 + 外层圆角 Border（10px）+ Fx.WinShadow 浮层投影，
         根 Grid Margin=14 给阴影渲染留白 -->
    <Grid Margin="14">
    <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
            Effect="{StaticResource Fx.WinShadow}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                <Grid>
                    <TextBlock Style="{StaticResource WinTitleText}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=工艺策略（固化时长 / 光栅门控）}"/>
                    <Button Style="{StaticResource WinTitleClose}" Content="✕" HorizontalAlignment="Right"
                            Click="OnCloseClick" ToolTip="关闭"/>
                </Grid>
            </Border>
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列：策略库 + 每层覆盖（折叠） -->
                <Border Grid.Column="0" Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   Text="策略库（激活一个生效）"/>
                        <Button Tag="{StaticResource Geo.Plus}" DockPanel.Dock="Top" Style="{StaticResource FreshButton}"
                                Content="＋ 添加策略" Command="{Binding AddPolicyCommand}" Margin="0,8"/>
                        <Button Tag="{StaticResource Geo.Trash}" DockPanel.Dock="Top" Style="{StaticResource FreshButton}"
                                Content="－ 删除选中策略" Command="{Binding RemovePolicyCommand}" Margin="0,0,0,8"/>
                        <!-- 每层覆盖（V0.0.44 收进左列折叠区）：整层同时长推荐画布拖选
                             整行批量设置（写仓位覆盖与层覆盖解析等效）；精确配层才展开 -->
                        <Expander DockPanel.Dock="Bottom" Margin="0,8,0,2"
                                  Header="{Binding LevelHeaderText, FallbackValue='每层覆盖（分钟，空=用全局）'}">
                            <StackPanel Margin="0,6,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="上层(层1)：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FreshInput}" Text="{Binding EditLevel1Min}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="中层(层2)：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FreshInput}" Text="{Binding EditLevel2Min}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="下层(层3)：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FreshInput}" Text="{Binding EditLevel3Min}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="层4(预留)：" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FreshInput}" Text="{Binding EditLevel4Min}"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <ListBox ItemsSource="{Binding Policies, FallbackValue={x:Null}}"
                                 SelectedItem="{Binding SelectedPolicy}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- "生效中"徽标（V0.0.57）：本项 == 当前生效策略才亮。
                                             缺省 Collapsed 写进 Style Setter（触发器死区口诀：
                                             写在元素标签上=本地值，触发器永远盖不动）；
                                             比对走 MultiBinding+StringEqualsConverter。 -->
                                        <Border Background="{DynamicResource Brush.Fresh.Accent}" CornerRadius="3" Padding="4,1"
                                                VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger>
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource StringEquals}">
                                                                    <Binding Path="Name"/>
                                                                    <Binding Path="DataContext.ActiveName"
                                                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <DataTrigger.Value>True</DataTrigger.Value>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="生效中" FontSize="10" Foreground="{DynamicResource Brush.Fresh.OnAccent}"/>
                                        </Border>
                                        <!-- 预置策略带灰蓝标记（IsPreset 是配置后不变量，非 INPC 绑定初值够用） -->
                                        <Border Background="{DynamicResource Brush.Fresh.ButtonHoverBg}" CornerRadius="3" Padding="4,1"
                                                VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPreset, FallbackValue=False}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="预置" FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name, FallbackValue=策略名}" Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 右列：参数条（策略属性）+ 画布（主编辑区）+ 光栅条（光栅配置）+
                     底部按钮。V0.0.74 用户拍板：光栅门控/信号类型/报警解除从参数条
                     下移到画布下方成一条独立控制带（图标+开关+分段按钮），参数条
                     只留纯工艺项（策略名/全局时长/时间单位/断电续算），语义分区：
                     上面=这条策略的时长，下面=光栅怎么用。 -->
                <DockPanel Grid.Column="1">
                    <!-- 参数条（V0.0.44 精简：原"策略编辑"面板只剩这几项，一行横排；
                         长说明收 ToolTip 不占版面。保留 WrapPanel：窗口缩到最小宽时
                         自动换行，不挤出右边界。 -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource FreshCardBorder}" Padding="10,8" Margin="0,0,0,8">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="策略名：" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource FreshInput}" Width="150"
                                     Text="{Binding EditName, FallbackValue=标准固化}"
                                     ToolTip="库内唯一；改名后按新名保存/激活"/>
                            <TextBlock Text="　全局时长：" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBox Style="{StaticResource FreshInput}" Width="86"
                                     Text="{Binding EditGlobalMinutes, FallbackValue=2}"
                                     ToolTip="{Binding GlobalMinutesToolTip, FallbackValue=全局固化时长（小时）——所有仓位的打底值，被每层/每仓位覆盖}"/>
                            <!-- 时间单位切换（V0.0.53）：只换页面显示/输入口径，策略存储恒为分钟。
                                 切换即把编辑区/画布/图例/浮层全部文本换算（VM 一处处理）。
                                 V0.0.73 精简：删掉时长框后的单位后缀与"单位："标签——
                                 下拉本身显示"时/分"，用户一眼看懂，不再重复两处文案。 -->
                            <ComboBox Style="{StaticResource FreshCombo}" Width="64" VerticalAlignment="Center"
                                      Margin="18,0,0,0"
                                      ItemsSource="{Binding TimeUnitOptions, FallbackValue={x:Null}}"
                                      SelectedIndex="{Binding TimeUnitIndex, FallbackValue=0}"
                                      ToolTip="仅换显示单位，计时精度恒为分钟"/>
                            <CheckBox IsChecked="{Binding EditPersistMinutes, FallbackValue=False}"
                                      Content="断电续算" Margin="18,0,0,0"
                                      ToolTip="开=断电时间计入固化时长；关（缺省）=重启后重新计时"/>
                        </WrapPanel>
                    </Border>
                    <!-- 底部按钮：预置→套用目标+套用所选模板；自定义→激活/仅保存（两组按选中项互斥显示） -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <!-- 预置策略专用出口（缺省 Collapsed 整组收起——设计器与缺省态显示激活/保存）：
                             套用目标下拉（名单=全部非预置策略：「自定义」+用户自建，缺省选「自定义」）
                             + 套用按钮。套用=编辑内容整体替换目标策略并激活它（保存并生效一条链）。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIsPreset, FallbackValue=False}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="套用目标：" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Fresh.FgMid}"/>
                            <ComboBox Style="{StaticResource FreshCombo}" Width="120" VerticalAlignment="Center" Margin="0,0,8,0"
                                      ItemsSource="{Binding ApplyTargets, FallbackValue={x:Null}}"
                                      SelectedItem="{Binding ApplyTargetName, FallbackValue=自定义}"
                                      ToolTip="预置模板整体替换并激活所选策略"/>
                            <Button Tag="{StaticResource Geo.Check}" Content="套用所选模板（保存并激活）"
                                    Command="{Binding ApplyTemplateCommand}" Width="230" Height="36"/>
                        </StackPanel>
                        <Button Tag="{StaticResource Geo.Check}" Content="激活并生效（保存 + 启用选中策略）"
                                Command="{Binding ActivateCommand}" Width="280" Height="36" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FreshButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIsPreset, FallbackValue=False}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="仅保存" Command="{Binding SaveCommand}" Width="140" Height="36">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FreshButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIsPreset, FallbackValue=False}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- ===== 光栅控制带（V0.0.74 用户拍板：从参数条下移到库位画布下方）=====
                         一条横带收拢全部光栅配置，左→右：标志物｜门控开关｜光栅报警｜信号类型｜报警解除。
                         语义：V0.0.96 用户拍板"统一跟随策略"——门控/报警/信号类型/报警解除
                         四项全部是选中策略的字段，随【仅保存】/【激活并生效】/【套用所选
                         模板】落库，激活策略即运行期唯一真源（不再有全局 ini 键）。
                         标志物=两根立柱+三道光束，门控开=蓝光束常亮、关=整体压暗——
                         不读文字也能一眼看出光栅用没在用。DockPanel 顺序：声明在底部
                         按钮之后 → 停在按钮上方、画布正下方。 -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource FreshCardBorder}"
                            Padding="12,7" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 0 光栅标志物：门控关（缺省）整体半透明，开=满亮度 -->
                            <Grid Grid.Column="0" Width="42" Height="38" Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  ToolTip="亮=门控已启用，暗=已关闭。">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="0.35"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditGrillGate, FallbackValue=False}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Width="6" Height="36" RadiusX="3" RadiusY="3"
                                           Fill="{DynamicResource Brush.Fresh.FgStrong}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Rectangle Width="6" Height="36" RadiusX="3" RadiusY="3"
                                           Fill="{DynamicResource Brush.Fresh.FgStrong}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="30" Height="2" RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource Brush.Fresh.Accent}"/>
                                    <Rectangle Width="30" Height="2" RadiusX="1" RadiusY="1" Margin="0,6,0,0"
                                               Fill="{DynamicResource Brush.Fresh.Accent}"/>
                                    <Rectangle Width="30" Height="2" RadiusX="1" RadiusY="1" Margin="0,6,0,0"
                                               Fill="{DynamicResource Brush.Fresh.Accent}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1 标题+状态副文（开关按钮本身显示已启用/已关闭；整条光栅带四项都随策略保存） -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="光栅门控" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                                    <TextBlock Text="随策略保存" FontSize="10" Margin="7,1,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Fresh.FgDim}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GrillGateDetailText, FallbackValue=托盘到位即开计时（不检测光栅）}"
                                           FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.Fresh.FgDim}"/>
                            </StackPanel>

                            <!-- 2 门控开关（ToggleButton：文字+轨道滑块，按钮自身就是状态显示） -->
                            <ToggleButton Grid.Column="2" Style="{StaticResource GrillSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding EditGrillGate, FallbackValue=False}"
                                          Content="{Binding GrillGateSwitchText, FallbackValue=已关闭}"
                                          ToolTip="开=两侧光栅让空才计时；关=托盘到位即计时（随策略保存）。"/>

                            <!-- 3 竖分隔 -->
                            <Border Grid.Column="3" Width="1" Margin="8,3"
                                    Background="{DynamicResource Brush.Fresh.PanelBorder}"/>

                            <!-- 4 报警总开关（策略字段，V0.0.96 起随策略保存/激活）：开=被挡即报警（缺省），
                                 关=整条报警链静默（激活该策略时已挂的当场解除；门控放行不受影响），
                                 滑块开关与门控同款按钮样式=一眼"这是个总闸" -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="光栅报警" VerticalAlignment="Center"
                                           ToolTip="{Binding GrillAlarmSwitchToolTip, FallbackValue='开：计时中光栅被挡即报警（仓位红灯+机台蜂鸣）。随策略保存，激活后生效。'}"/>
                                <ToggleButton Style="{StaticResource GrillSwitch}"
                                              VerticalAlignment="Center" Margin="8,0,0,0"
                                              IsChecked="{Binding IsGrillAlarmEnabled, FallbackValue=True}"
                                              Content="{Binding GrillAlarmSwitchText, FallbackValue=已开启}"
                                              ToolTip="关=不报警（门控不受影响）；开=被挡即报警。随策略保存，激活后生效。"/>
                            </StackPanel>

                            <!-- 5 竖分隔 -->
                            <Border Grid.Column="5" Width="1" Margin="8,3"
                                    Background="{DynamicResource Brush.Fresh.PanelBorder}"/>

                            <!-- 6 信号类型（策略字段，随策略保存/激活）：常开/常闭一体式分段控件——
                                 外框浅底圆角胶囊，选中一枚蓝底反白；触摸目标高≈35px -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="信号类型" VerticalAlignment="Center"
                                           ToolTip="{Binding GrillSignalToolTip, FallbackValue='常开：遮挡=ON（缺省）。随策略保存，激活后生效。'}"/>
                                <Border CornerRadius="5" BorderThickness="1" Padding="3" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Fresh.CanvasBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource GrillSegment}" Content="常开"
                                                     GroupName="GrillPolarity"
                                                     IsChecked="{Binding IsGrillNormallyOpen, FallbackValue=True}"
                                                     ToolTip="常开：被挡=ON、让空=OFF（缺省）。随策略保存。"/>
                                        <RadioButton Style="{StaticResource GrillSegment}" Content="常闭" Margin="2,0,0,0"
                                                     GroupName="GrillPolarity"
                                                     IsChecked="{Binding IsGrillNormallyClosed, FallbackValue=False}"
                                                     ToolTip="常闭：被挡=OFF、让空=ON（常闭安全光栅）。随策略保存。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 7 竖分隔 -->
                            <Border Grid.Column="7" Width="1" Margin="8,3"
                                    Background="{DynamicResource Brush.Fresh.PanelBorder}"/>

                            <!-- 8 报警解除（策略字段，随策略保存/激活）：人工/自动一体式分段控件，同信号类型 -->
                            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="报警解除" VerticalAlignment="Center"
                                           ToolTip="{Binding GrillResetModeToolTip, FallbackValue='人工：报警后不自动解除，在报警复位窗确认。随策略保存，激活后生效。'}"/>
                                <Border CornerRadius="5" BorderThickness="1" Padding="3" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Fresh.CanvasBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource GrillSegment}" Content="人工"
                                                     GroupName="GrillReset"
                                                     IsChecked="{Binding IsGrillManualReset, FallbackValue=True}"
                                                     ToolTip="人工：报警后不自动解除，在报警复位窗确认。随策略保存。"/>
                                        <RadioButton Style="{StaticResource GrillSegment}" Content="自动" Margin="2,0,0,0"
                                                     GroupName="GrillReset"
                                                     IsChecked="{Binding IsGrillAutoReset, FallbackValue=False}"
                                                     ToolTip="自动：两侧光栅让空即解除报警。随策略保存。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 仓位时长画布（主编辑区）：交互（点选/框选/平移/缩放）在 xaml.cs -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- 图例列宽 236：图例改为"色块+可换行文本"两列后，210 会把
                                 "120 ~ 179 分钟"折成两行（V0.0.53 目检修）；236 保证
                                 分钟/时两档最长文案单行可读，画布 680 定宽仍放得下。 -->
                            <ColumnDefinition Width="236"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CanvasHost" Grid.Column="0" Background="{DynamicResource Brush.Fresh.CanvasBg}"
                                BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}" BorderThickness="1" CornerRadius="4"
                                ClipToBounds="True"
                                MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                MouseDown="OnCanvasMouseDown"
                                MouseUp="OnCanvasMouseUp"
                                MouseMove="OnCanvasMouseMove"
                                MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                                MouseLeave="OnCanvasMouseLeave"
                                PreviewMouseWheel="OnCanvasPreviewMouseWheel">
                            <Border.ContextMenu>
                                <!-- 右键菜单：适应图像=显示恢复至窗口打开时的原始大小（与双击复位同效） -->
                                <ContextMenu>
                                    <MenuItem Header="适应图像" ToolTip="恢复至窗口打开时的原始大小"
                                              Click="OnFitImageClick"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <!-- 三层：CanvasContent（随缩放平移变换）→ OverlayCanvas（框选矩形，
                                 host 坐标系不随变换，IsHitTestVisible=False 纯视觉）→ QuickEdit
                                 （点选浮层：host 坐标系随选区定位，可交互——点浮层自己不吃清选择） -->
                            <Grid>
                                <Grid x:Name="CanvasContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CanvasScale"/>
                                            <TranslateTransform x:Name="CanvasTranslate"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <ItemsControl x:Name="PreviewItems"
                                                  ItemsSource="{Binding SlotPreviewItems, FallbackValue={x:Null}}"
                                                  Width="{Binding PreviewGridWidth, FallbackValue=680}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- 行优先铺格（VM 已按 层外架内 生成，与主窗仓位网格同布局）。
                                                     ItemsControl 定宽=VM PreviewGridWidth（列数×68）——
                                                     格子尺寸锁定不随窗口/文字浮动（V0.0.44 用户定调） -->
                                                <UniformGrid Columns="{Binding DataContext.RackCount,
                                                    RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=10}"
                                                    Rows="{Binding DataContext.LevelCount,
                                                    RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=3}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 格子三态色：普通=时长四档底色；特殊（单独设过覆盖，
                                                     VM 真识别）=主题蓝；选中=FgStrong 描边（底色不变）。
                                                     BorderThickness 恒 2（透明占位）防选中跳版；
                                                     尺寸锁定 64×58（定宽画布配套，想调改此处+
                                                     VM PreviewGridWidth 的 68 步进） -->
                                                <Border Margin="2" Width="64" Height="58" CornerRadius="4" BorderThickness="2"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding Tip, FallbackValue=架1 层1：固化 120 分钟}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Fresh.TierGreen}"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tier, FallbackValue=Yellow}" Value="Yellow">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Fresh.TierYellow}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier, FallbackValue=Yellow}" Value="Orange">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Fresh.TierOrange}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tier, FallbackValue=Yellow}" Value="Red">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Fresh.TierRed}"/>
                                                                </DataTrigger>
                                                                <!-- 特殊仓位（单独设过时长）：主题蓝盖过四档色 -->
                                                                <DataTrigger Binding="{Binding IsSpecial, FallbackValue=False}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                                                </DataTrigger>
                                                                <!-- 悬停淡描边（可点暗示） -->
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.AccentBorder}"/>
                                                                </Trigger>
                                                                <!-- 选中描边（后声明优先级最高，盖过悬停） -->
                                                                <DataTrigger Binding="{Binding IsSelected, FallbackValue=False}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding MinutesText, FallbackValue=2}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   HorizontalAlignment="Center">
                                                            <!-- 字色：普通=TierFg；特殊（蓝底）=OnAccent。
                                                                 触发器在元素 Style 上才能盖缺省 Setter（本地值不行） -->
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.TierFg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSpecial, FallbackValue=False}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.OnAccent}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding PositionText, FallbackValue=架1-层1}"
                                                                   FontSize="9" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.TierFgSub}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSpecial, FallbackValue=False}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.OnAccent}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <!-- 框选橡皮筋（V0.0.44 改透明框：只留主题蓝描边不糊格子；
                                     host 坐标系不随变换；IsHitTestVisible=False 不挡命中与浮层） -->
                                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                                    <Border x:Name="RubberBand" Visibility="Collapsed"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource Brush.Fresh.Accent}"
                                            BorderThickness="1.5" CornerRadius="2"/>
                                </Canvas>
                                <!-- 点选浮层（傻瓜式核心：单击/框选后在选区旁浮出，直接输时长
                                     回车应用——不需要旁边常驻编辑框）。显隐绑 HasSelection；
                                     定位由 xaml.cs 算选区包围盒（host 坐标系），随缩放/平移重定位；
                                     【清除】删该批覆盖恢复跟随层/全局（设了能删，闭环） -->
                                <Border x:Name="QuickEdit" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Fresh.CardBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.AccentBorder}" BorderThickness="1.5"
                                        CornerRadius="6" Padding="10,8"
                                        MouseLeftButtonDown="OnQuickEditMouseDown"
                                        IsVisibleChanged="OnQuickEditVisibleChanged"
                                        Effect="{StaticResource Fx.WinShadow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectionSummaryText, FallbackValue=架3-层2 · 当前 2小时}"
                                                   FontSize="11" Foreground="{DynamicResource Brush.Fresh.FgMid}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBox x:Name="QuickEditBox" Style="{StaticResource FreshInput}" Width="88"
                                                     Text="{Binding SelectionMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="OnQuickEditKeyDown"
                                                     ToolTip="{Binding SelectionInputToolTip, FallbackValue='时长（小时，计时精度为分钟），回车应用'}"/>
                                            <TextBlock Text="{Binding TimeUnitSuffix, FallbackValue=时}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                            <Button Style="{StaticResource FreshPrimaryButton}" Content="应用"
                                                    Width="56" Command="{Binding ApplySelectionCommand}"
                                                    Click="OnQuickEditApply"/>
                                            <Button Style="{StaticResource FreshButton}" Content="清除" Margin="8,0,0,0"
                                                    Width="56" Command="{Binding ClearSelectionOverrideCommand}"
                                                    ToolTip="删除该批仓位的单独设置，恢复跟随层/全局"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- 图例与操作说明（画布=主编辑区口径） -->
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Fresh.CardBg}" BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}" BorderThickness="1"
                                CornerRadius="4" Margin="8,0,0,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="仓位时长画布" FontWeight="Bold" Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                                <TextBlock Text="点格子直接改时长（仓位＞层＞全局）" FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}"
                                           Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Rectangle Width="18" Height="12" Fill="{DynamicResource Brush.Fresh.Accent}" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="特殊仓位（单独设过）" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- 图例四档：Grid 两列（色块 + 自动换行文本）——小时档文案
                                     较长（"1 ~ 1.98 小时"），水平 StackPanel 不约束宽度会
                                     截断，换行保证任何单位下全可见（V0.0.53 目检修）。 -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="18" Height="12" Fill="{DynamicResource Brush.Fresh.TierGreen}" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="{Binding LegendGreenText, FallbackValue='跟随层/全局：&lt; 60 分钟'}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="18" Height="12" Fill="{DynamicResource Brush.Fresh.TierYellow}" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="{Binding LegendYellowText, FallbackValue=跟随层/全局：60 ~ 119 分钟}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="18" Height="12" Fill="{DynamicResource Brush.Fresh.TierOrange}" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="{Binding LegendOrangeText, FallbackValue=跟随层/全局：120 ~ 179 分钟}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="18" Height="12" Fill="{DynamicResource Brush.Fresh.TierRed}" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                               Text="{Binding LegendRedText, FallbackValue=跟随层/全局：≥ 180 分钟}" VerticalAlignment="Center"/>
                                </Grid>
                                <Separator Margin="0,8"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}" Text="左键单击：选格子，直接输时长"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}" Text="左键拖框：批量选格（Ctrl 叠加）" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}" Text="Ctrl+单击：加选 / 减选" Margin="0,2,0,0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}" Text="中键拖动：平移画布" Margin="0,2,0,0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}" Text="滚轮：放大 / 缩放" Margin="0,2,0,0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}" Text="双击空白：复位视图" Margin="0,2,0,0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Fresh.FgDim}" Text="Esc：清除选择　右键：适应图像" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>

<Application x:Class="CureStation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      CureStation（固化程控）资源字典：
      风格呼应主程序 Fresh 卡片风（浅蓝边药丸/白底卡片），骨架阶段保持最小集，
      Phase 2 统一换肤与语言服务时再收编进共享字典。
    -->
    <Application.Resources>
        <Style x:Key="FreshCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8D4EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="FreshHintBorder" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FD"/>
            <Setter Property="BorderBrush" Value="#B8D4EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FreshButton" TargetType="Button">
            <Setter Property="Background" Value="#F5FAFF"/>
            <Setter Property="BorderBrush" Value="#B8D4EE"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridTextColumn">
            <Setter Property="Foreground" Value="#333"/>
        </Style>
    </Application.Resources>
</Application>

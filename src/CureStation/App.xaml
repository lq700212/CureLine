<Application x:Class="CureStation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!--
      CureStation（固化程控）资源字典：
      双主题架构（2026-10-29 UI 重画，V0.0.27 第 2 期弹窗跟主题）：
      - Themes/Light.xaml（G2 浅色渐变浸染）/ Themes/Dark.xaml（G1 深空玻璃舱）
        各持一套【语义键】（Brush.WindowBg / Brush.CardBg / Brush.StateRed …），
        ThemeManager 替换 MergedDictionaries[0] 即全程序换皮（主窗 + 日志悬浮窗 +
        各功能弹窗全键化）；缺省挂 Light，App.OnStartup 按 configparser[setting] Theme 再应用。
      - Fresh.* 键板（Brush.Fresh.*）已从本文件迁入两主题字典（V0.0.27 起）：
        Light=原固定浅色值一字未动，Dark=G1 深空玻璃口径——弹窗样式 Setter 全部
        DynamicResource，切主题即换弹窗（"弹窗维持浅色"的旧口径已废止）。
      - 弹窗窗体统一 WindowStyle=None + WindowChrome（CaptionHeight 命中拖动 +
        ResizeBorderThickness 缩放）+ 自绘标题条（WinTitleBar 三样式，色复用主窗
        HeaderGrad/TopbarFg——品牌渐变条全程序一 Yi 贯之）。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 缺省浅色（XAML 期兜底）；运行时 ThemeManager 按 ini 覆换 -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ 图标几何库（Geo.*，来源 galaxy 本地镜像） ============ -->
            <!-- 全部取自 E:\Project\galaxy（uiverse-io/galaxy 本地镜像）按钮样例内嵌
                 SVG 的 path d（24×24 stroke 线性风格，来源文件见每条注释）；配色不走
                 固定值——按钮模板里 Path.Stroke 绑定 TemplateBinding Foreground，
                 自动跟随各按钮样式的主题前景键（GhostFg/PrimaryGhostFg/FgStrong）。
                 WPF Path 与 SVG path 语法兼容（含紧凑弧参数），原样搬 d。 -->
            <Geometry x:Key="Geo.Login">M11.68 14.62 L14.24 12.06 L11.68 9.5 M4 12.06 H14.17 M12 4 C16.42 4 20 7 20 12 C20 17 16.42 20 12 20</Geometry>             <!-- galaxy/Buttons/catraco_blue-bulldog-58 -->
            <Geometry x:Key="Geo.WorkOrder">M15.5 3 H5 A2 2 0 0 0 3 5 V19 A2 2 0 0 0 5 21 H19 A2 2 0 0 0 21 19 V8.5 L15.5 3 Z M15 3 v6 h6</Geometry>             <!-- galaxy/Buttons/0x3ther_heavy-dragon-56 -->
            <Geometry x:Key="Geo.Permission">M12 5.9c1.16 0 2.1.94 2.1 2.1s-.94 2.1-2.1 2.1S9.9 9.16 9.9 8s.94-2.1 2.1-2.1m0 9c2.97 0 6.1 1.46 6.1 2.1v1.1H5.9V17c0-.64 3.13-2.1 6.1-2.1M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 9c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4z</Geometry> <!-- galaxy/Buttons/Praashoo7_chilly-baboon-67 -->
            <Geometry x:Key="Geo.Policy">M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0z</Geometry>                                                             <!-- galaxy/Buttons/EcheverriaJesus_hungry-dingo-62 -->
            <Geometry x:Key="Geo.Posting">M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2 M7 9l5-5 5 5 M12 4v12</Geometry>                                              <!-- galaxy/Buttons/Itskrish01_chatty-lionfish-23 -->
            <Geometry x:Key="Geo.IoTest">M11 15H6L13 1V9H18L11 23V15Z</Geometry>                                                                                  <!-- galaxy/Buttons/SelfMadeSystem_white-stingray-85 -->
            <Geometry x:Key="Geo.PointTable">m3 7h17c.5523 0 1 .44772 1 1v11c0 .5523-.4477 1-1 1h-16c-.55228 0-1-.4477-1-1z m3-2.5c0-.27614.22386-.5.5-.5h6.29289c.13261 0 .25981.05268.35351.14645l2.8536 2.85355h-10z</Geometry> <!-- galaxy/Buttons/andrew-demchenk0_swift-octopus-68 -->
            <Geometry x:Key="Geo.Reconnect">M8.288 14.212A5.25 5.25 0 1 1 17.25 10.5 M15.042 21.672 13.684 16.6l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672z</Geometry> <!-- galaxy/Buttons/seyed-mohsen-mousavi_weak-parrot-44 -->
            <Geometry x:Key="Geo.Log">M5 7h14 M5 12h14 M5 17h14</Geometry>                                                                                        <!-- galaxy/Buttons/LeryLey_white-monkey-16 -->
            <Geometry x:Key="Geo.Exit">M17 8l4 4m0 0l-4 4m4-4H3</Geometry>                                                                                        <!-- galaxy/Buttons/HecktorViegas_green-cow-45 -->
            <Geometry x:Key="Geo.Save">m19 21H5c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2h11l5 5v11c0 1.1-.9 2-2 2z M7 3v5h8 M17 20v-7H7v7z</Geometry>                     <!-- galaxy/Buttons/ilkhoeri_chilly-sloth-36 -->
            <Geometry x:Key="Geo.Check">M4.5 12.75l6 6 9-13.5</Geometry>                                                                                          <!-- galaxy/Buttons/Creatlydev_dull-chicken-81 -->
            <Geometry x:Key="Geo.Trash">M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16</Geometry> <!-- galaxy/Buttons/seyed-mohsen-mousavi_warm-dingo-23 -->
            <Geometry x:Key="Geo.Plus">M12 5v14 M5 12h14</Geometry>                                                                                               <!-- galaxy/Buttons/andrew-demchenk0_mighty-moose-66 -->
            <Geometry x:Key="Geo.Eye">M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0z</Geometry>                                 <!-- galaxy/Buttons/barisdogansutcu_wet-otter-24 -->
            <Geometry x:Key="Geo.Edit">M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z</Geometry>                                                         <!-- galaxy/Buttons/barisdogansutcu_lovely-walrus-42 -->
            <Geometry x:Key="Geo.CloseX">M6 18L18 6M6 6l12 12</Geometry>                                                                                          <!-- galaxy/Buttons/Creatlydev_dull-chicken-81 -->

            <!-- ============ 主窗专用样式（色走语义键，随主题换皮） ============ -->
            <!-- 幽灵按钮：主窗顶栏胶囊（HTML .btn 直译 padding 5px 13px ≈ 27px 高）；
                 VerticalAlignment=Center 必守——顶栏按钮组与 Height=44 的系统三钮同池
                 （水平 StackPanel 子元素垂直默认 Stretch，不居中会被拉到 44 高"顶到顶"） -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.GhostBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.GhostBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.GhostFg}"/>
                <Setter Property="Padding" Value="13,5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <!-- 主窗无边框化（V0.0.28）后整个品牌顶栏都是 caption 拖动区，
                     顶栏里的按钮必须声明"chrome 可命中"否则点不到（样式级一次声明） -->
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <!-- 图标位（可选）：Tag 挂 Geo.* 几何即显示（Stroke 跟随按钮前景，
                                     随主题/悬停联动），不挂 Tag 时由触发器折叠——向后兼容纯文字钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Margin="0,0,5,0"
                                          VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostHoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GhostBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostPressedBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 主按钮态幽灵按钮（顶栏【日志】高亮，HTML .lfbtn 直译）：
                 Light=白底蓝字 / Dark=蓝玻璃底 + 霓虹蓝字；悬停边框沿用 Ghost 分键随主题变 -->
            <Style x:Key="PrimaryGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryGhostBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryGhostBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryGhostFg}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <!-- 细进度条（4px 圆角胶囊）：仓位卡计时 / 工单带产出共用。
                 Foreground 由使用处定（本样式统一给状态绿）；模板依赖 ProgressBar
                 约定名 PART_Track / PART_Indicator——勿改名。 -->
            <Style x:Key="SlotProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="4"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.StateGreen}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="2"
                                        Background="{DynamicResource Brush.BarTrack}"/>
                                <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 弹窗样式（色全部 DynamicResource 走主题字典 Fresh.* 键板） ============ -->
            <Style x:Key="FreshCardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
            <Style x:Key="FreshHintBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.HintBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <!-- 次级按钮（淡底浅蓝边）：圆角 + 悬停加深，弹窗内全局默认按钮观感 -->
            <Style x:Key="FreshButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.ButtonBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <!-- 图标位（可选）：Tag 挂 Geo.* 几何即显示（Stroke 跟随前景键），
                                     不挂 Tag 时折叠——与 GhostButton 同构，见其注释 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Margin="0,0,5,0"
                                          VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonPressedBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 实色主按钮（CTA）：登录/新增等主操作，蓝底白字悬停变深 -->
            <Style x:Key="FreshPrimaryButton" TargetType="Button" BasedOn="{StaticResource FreshButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.AccentBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.OnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.AccentPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 危险操作按钮（删除账号等）：红底白字 -->
            <Style x:Key="FreshDangerButton" TargetType="Button" BasedOn="{StaticResource FreshPrimaryButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.Danger}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.DangerBorder}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.DangerHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.DangerPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 成功操作按钮（重置密码等）：绿底白字 -->
            <Style x:Key="FreshSuccessButton" TargetType="Button" BasedOn="{StaticResource FreshDangerButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.Success}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.SuccessBorder}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.SuccessHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.SuccessPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 统一输入框（弹窗表单）：圆角 4、聚焦变主蓝边。
                 注意：PART_ContentHost 必须 Stretch 填满内容区，文字垂直居中交给
                 VerticalContentAlignment（TextBoxView 自己算）——模板里给 ScrollViewer
                 设 VerticalAlignment=Center 会收缩内容宿主、裁掉文字下半截（实测教训） -->
            <Style x:Key="FreshInput" TargetType="TextBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="6,0,8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 下拉框统一：与 FreshInput/按钮同高（32）同字号（继承窗口）——
                 全项目输入区"框=按钮=32"口径。完整自绘模板：透明 ToggleButton 全框命中
                 （ClickMode=Press 点哪都展开）+ 非可编辑态 SelectionBoxItem 展示 +
                 可编辑态 PART_EditableTextBox（叠在 ToggleButton 之上接住文本区点击）+
                 PART_Popup（主题弹层：CardBg 底 / Border 边 / 圆角 4 / MaxHeight 220 滚动）。
                 非可编辑态 ContentPresenter IsHitTestVisible=False 让点击穿透到 ToggleButton。 -->
            <Style x:Key="FreshCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Bd" Background="{DynamicResource Brush.Fresh.InputBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}"
                                        BorderThickness="1" CornerRadius="4"/>
                                <!-- 非可编辑态：显示选中项（可编辑态隐藏） -->
                                <ContentPresenter x:Name="Selected" Margin="10,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{DynamicResource Brush.Fresh.FgMid}"
                                                  IsHitTestVisible="False"/>
                                <!-- 点哪都开（透明命中铺满全框） -->
                                <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- 可编辑态文本框（登录窗用户名下拉：叠在 Toggle 之上接住文本区） -->
                                <TextBox x:Name="PART_EditableTextBox" Margin="8,0,26,0" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                         Padding="0" CaretBrush="{DynamicResource Brush.Fresh.FgMid}"
                                         Foreground="{DynamicResource Brush.Fresh.FgMid}" Visibility="Collapsed"/>
                                <!-- 箭头 -->
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Brush.Fresh.FgMid}"
                                      HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                                      IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                       Focusable="False">
                                    <Border Background="{DynamicResource Brush.Fresh.CardBg}"
                                            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="2" Margin="0,2,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 下拉项（隐式）：圆角 3 胶囊行，悬停/选中=ButtonHoverBg（Fresh.AccentSoft 未入键板——
                 本样式随弹层走 Fresh 键板，借按钮悬停底色一档即可） -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 密码输入框：与 FreshInput 同款（PasswordBox 是独立控件需独立模板）。
                 Padding 左 3 非 6 是实测校准值：PasswordBox 内部渲染无 TextBoxView 的
                 额外内缩，同抄 6 会让密码首字符比用户名编辑框文本（模板 Margin 8）
                 靠右约 3 逻辑 px——登录窗"账号/密码文本左缘对齐" UI 契约（AGENTS.md），
                 动此值须跑目检截图像素比对两框首字符左缘 -->
            <Style x:Key="FreshPwdInput" TargetType="PasswordBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="3,0,8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 数据网格（弹窗通用，随主题换皮） ============ -->
            <!-- 行底透明露卡底（嵌在 FreshCardBorder 内）；行宽横线走 GridLine 键；
                 单元格字色走 Cell Foreground（TextElement.Foreground 沿树继承到 TextBlock）；
                 选中格=GridSelBg + FgStrong（行模板的系统蓝选中底会被透明格底盖住） -->
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="Transparent"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Fresh.GridLine}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Fresh.GridLine}"/>
            </Style>
            <!-- 列头（不重模板：默认模板 Background/Foreground 走 TemplateBinding，setter 即生效） -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.GridHeaderBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.GridLine}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Fresh.GridSelBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ============ 通用控件主题化（隐式，全程序弹窗+日志窗共用） ============ -->
            <!-- ListBox 容器本体：缺省 Aero2 底是白（dark 下刺眼大白块）——V0.0.27 换 CardBg
                 无边框，与卡片面板融底；滚动条/列表行走下方各自样式。 -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            <!-- 列表行：选中=ButtonHoverBg 淡底；hover 提亮不换底(日志流连点不闪)。
                 显式 ItemContainerStyle（如 LogWindow 日志行）会整体覆盖本隐式样式，不受影响。 -->
            <Style TargetType="ListBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 复选框（简约方框勾）：未选=InputBg 底 Border 边、选中=Accent 蓝底白勾 -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                        Background="{DynamicResource Brush.Fresh.InputBg}" VerticalAlignment="Center">
                                    <Path x:Name="Check" Data="M2.5,7.5 L6,11 L12,3.5"
                                          Stroke="{DynamicResource Brush.Fresh.OnAccent}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.AccentBorder}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 折叠面板（点表窗"设备高级参数"）：标题行简绘箭头（展开=下指，折叠=右旋 -90°），
                 只做向下展开一种方向（全部使用处皆缺省方向） -->
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,2">
                                                <Path x:Name="Arrow" Data="M1,1 L4,4 L7,1"
                                                      Stroke="{DynamicResource Brush.Fresh.FgMid}" StrokeThickness="1.5"
                                                      VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  TextElement.Foreground="{DynamicResource Brush.Fresh.FgStrong}"
                                                                  TextElement.FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 提示气泡：深浅跟随主题（CardBg 底/PanelBorder 边/FgMid 字——原系统白气泡深色下刺眼） -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.PanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 滚动条（胶囊化，4px 圆角拇指；默认隐藏轨道/分页区透明） ============ -->
            <!-- 透明 RepeatButton：Track 上下分页区（点击=翻页）不留视觉 -->
            <Style TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Bd" CornerRadius="4" Margin="2"
                                                            Background="{DynamicResource Brush.Fresh.ScrollThumb}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ScrollThumbHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- 横向：条高 8、分页方向不反转（纵向才反——右上往左下天经地义）。
                     属性元素纪律：Style.Triggers 只能有一个且置于全部 Setter 之后 -->
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False"
                                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="Bd" CornerRadius="4" Margin="2"
                                                                    Background="{DynamicResource Brush.Fresh.ScrollThumb}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ScrollThumbHover}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ============ 弹窗自绘标题条（WindowStyle=None + WindowChrome 窗体公用） ============ -->
            <!-- 色复用主窗品牌键：HeaderGrad 渐变条（Light 蓝渐变 / Dark 深蓝实底）+ TopbarFg 字，
                 底边 TopbarBorder——全程序一条品牌线。高 34（各窗 CaptionHeight 与其对齐）。
                 顶部圆角 10 与各弹窗外层圆角 Border 对齐（方角标题条会盖住外框圆角）。
                 阴影资源 Fx.WinShadow：圆角透明窗的浮层投影（窗根 Grid 需留 Margin≈14 给阴影渲染）。 -->
            <DropShadowEffect x:Key="Fx.WinShadow" Color="#000000" BlurRadius="24"
                              ShadowDepth="2" Opacity="0.55" Direction="270"/>
            <Style x:Key="WinTitleBar" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.HeaderGrad}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.TopbarBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="10,10,0,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>
            <Style x:Key="WinTitleText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TopbarFg}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- 关闭钮：命中区在标题条要 IsHitTestVisibleInChrome=True（落 caption 拖动区外）；
                 悬停红换白字（Win32 惯例）；焦点策略关闭（Alt 遍历不路过纯装饰钮） -->
            <Style x:Key="WinTitleClose" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TopbarFg}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.CloseHoverBg}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 主窗顶栏系统钮（V0.0.28 无边框化专用，弹窗对齐口径） ============ -->
            <!-- 主窗品牌顶栏 44 高（弹窗标题条 34），系统钮铺满行高：宽 40 高 44；
                 hover 用主窗幽灵键（品牌条半透明白，与顶栏按钮 hover 同源），关闭沿用红色惯例。 -->
            <Style x:Key="WinSysBtn" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TopbarFg}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostPressedBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 关闭钮：业界惯例 hover 红（Fresh.CloseHoverBg）换白字，与弹窗 WinTitleClose 一致 -->
            <Style x:Key="WinSysClose" TargetType="Button" BasedOn="{StaticResource WinSysBtn}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.CloseHoverBg}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

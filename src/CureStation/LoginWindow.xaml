<Window x:Class="CureStation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=False}"
        Title="操作员登录" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" FontSize="13"
        Foreground="{DynamicResource Brush.Fresh.FgMid}">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（V0.0.27 弹窗统一）：CaptionHeight 撑标题条命中拖动，
             NoResize 窗缩放边沿不需要；系统按钮全关（自绘 ✕ 走 VM 取消链） -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <!--★★ 登录窗（V0.0.20 对齐 HJVision mFormLogin 功能清单，配色走主题 Fresh 键板；
         V0.0.49 起回归纯登录——改密面板删除，操作员无改密权，改密全走用户管理窗）：
         用户名下拉（在册账号，可手输）+ 密码 + 记住密码勾选。PasswordBox 密码经
         事件转交 VM（不可绑定，官方 workaround），VM 侧改密码经 PropertyChanged
         回写框（见 xaml.cs Wire）；键盘链（回车跳框/密码回车=登录/Esc 关窗）在
         xaml.cs PreviewKeyDown，按钮不用 IsDefault/IsCancel。
         VM 与门禁链零改动（LoginName/Role 输出、OkCommand/CancelCommand 原样）。
         取色全走 Brush.Fresh.*（两主题字典同名异值，ThemeManager 切字典即换肤）；
         标题条/关闭钮走 App.xaml WinTitleBar/WinTitleClose 共享样式。-->
    <!-- 圆角弹窗骨架（全弹窗统一）：透明窗 + 外层圆角 Border（10px）+ Fx.WinShadow 浮层投影，
         根 Grid Margin=14 给阴影渲染留白 -->
    <Grid Margin="14">
    <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
            Effect="{StaticResource Fx.WinShadow}">
        <DockPanel>
            <!-- 品牌标题条：WinTitleBar 共享样式（主窗品牌渐变同源），右侧关闭钮 -->
            <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                <Grid>
                    <Button Style="{StaticResource WinTitleClose}" Content="✕"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick" ToolTip="关闭（Esc）"/>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <StackPanel Margin="36,18,36,18">
                <!-- 居中横幅 -->
                <TextBlock Text="账号登录" FontSize="20"
                           FontWeight="Bold" Foreground="{DynamicResource Brush.Fresh.FgStrong}"
                           HorizontalAlignment="Center"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="用户名" VerticalAlignment="Center" Margin="0,0,12,10"/>
                    <!-- 在册账号下拉（可编辑：点选或手输），Text 变化即跟随账号回填记住的密码；
                         Padding 与 FreshPwdInput（边框1+8）对齐出同款文本左缘；ItemContainerStyle
                         让下拉列表项文本左缘跟编辑框文本对齐（下拉项默认更靠左，实测补 19px） -->
                    <ComboBox Style="{StaticResource FreshCombo}" x:Name="UserCombo" Grid.Row="0" Grid.Column="1"
                              Height="32" VerticalContentAlignment="Center" Padding="17,0"
                              IsEditable="True" StaysOpenOnEdit="False"
                              ItemsSource="{Binding HistoryUsers}"
                              Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,10"
                              ToolTip="下拉选在册账号或直接输入；换账号自动跟出该账号记住的密码">
                        <ComboBox.ItemContainerStyle>
                            <!-- BasedOn 隐式主题样式（App.xaml）：不带 BasedOn 会整体覆盖回
                                 系统默认模板（白底黑字），深色模式下拉弹层刺眼——只补 Padding 对齐 -->
                            <Style TargetType="ComboBoxItem"
                                   BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="Padding" Value="19,3"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="密码" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <PasswordBox x:Name="PwdBox" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource FreshPwdInput}"/>
                </Grid>
                <CheckBox Content="记住密码（按账号各记各的）" IsChecked="{Binding Remember}"
                          FontSize="12" Cursor="Hand"
                          HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <!-- 密码忘记/遗失找管理员在用户管理窗重置（操作员无改密入口——V0.0.49 口径） -->
                <Button Tag="{StaticResource Geo.Login}" Style="{StaticResource FreshPrimaryButton}" Content="登 录"
                        Command="{Binding OkCommand}" Width="128" Height="32" Margin="0,18,0,0"
                        HorizontalAlignment="Right"/>

                <!-- 提示条：错误=浅红底红字（登录失败；底/边/字全走 AlertErr* 键，
                     Dark=低透明状态浸染）。登录成功即关窗，无成功绿条场景 -->
                <Border CornerRadius="4" Padding="10,6" Margin="0,12,0,0"
                        Background="{DynamicResource Brush.Fresh.AlertErrBg}"
                        BorderBrush="{DynamicResource Brush.Fresh.AlertErrBorder}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <!-- Tip 为空整条收起（登录失败才显示） -->
                                <DataTrigger Binding="{Binding Tip, FallbackValue=提示占位}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Tip}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Fresh.AlertErrFg}"/>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
    </Grid>
</Window>

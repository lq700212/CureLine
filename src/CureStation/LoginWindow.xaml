<Window x:Class="CureStation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=False}"
        Title="操作员登录" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="White" FontSize="13">
    <!--★★ 登录窗（V0.0.20 对齐 HJVision mFormLogin 功能清单，配色按本项目 Fresh 风）：
         双面板同窗切换（登录 ⇄ 修改密码，横幅随面板换文案）；
         登录面板=用户名下拉（在册账号，可手输）+ 密码 + 记住密码勾选；
         改密面板=原密码/新密码/确认三框（四道闸在 VM：在册→原密码验对→
         ≥6位且不与旧同→两次一致）。PasswordBox 密码经事件转交 VM（不可绑定，
         官方 workaround），VM 侧改密码经 PropertyChanged 回写框（见 xaml.cs Wire）；
         键盘链（回车跳框/Esc 回面板/下拉展开放行回车）在 xaml.cs PreviewKeyDown，
         故按钮不用 IsDefault/IsCancel（双面板下会吃错回车）。
         VM 与门禁链零改动（LoginName/Level 输出、OkCommand/CancelCommand 原样）。-->
    <Border BorderBrush="#B8D4EE" BorderThickness="1">
        <DockPanel>
            <!-- 品牌标题条：拖动移动窗体，右侧关闭钮（悬停变红） -->
            <Border DockPanel.Dock="Top" Background="#1E90FF" Height="38"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <!-- 标题条只留色条+关闭钮（V0.0.20 口径：文字删除，拖动/关闭不受影响） -->
                    <Button HorizontalAlignment="Right" Width="40" Height="38" Content="✕"
                            Foreground="White" FontSize="13" Cursor="Hand"
                            Click="OnCloseClick" ToolTip="关闭（Esc）">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <StackPanel Margin="36,18,36,18">
                <!-- 居中横幅：随面板切换（"账号登录" / "修改密码（xxx）"） -->
                <TextBlock Text="{Binding BannerText, FallbackValue=账号登录}" FontSize="20"
                           FontWeight="Bold" Foreground="#1F4E79" HorizontalAlignment="Center"/>

                <!-- ===== 登录面板（缺省可见；进改密面板时收起） ===== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChangePwd, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="用户名" VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <!-- 在册账号下拉（可编辑：点选或手输），Text 变化即跟随账号回填记住的密码；
                             Padding 与 FreshPwdInput（边框1+8）对齐出同款文本左缘；ItemContainerStyle
                             让下拉列表项文本左缘跟编辑框文本对齐（下拉项默认更靠左，实测补 19px） -->
                        <ComboBox Style="{StaticResource FreshCombo}" x:Name="UserCombo" Grid.Row="0" Grid.Column="1"
                                  Height="32" VerticalContentAlignment="Center" Padding="17,0"
                                  IsEditable="True" StaysOpenOnEdit="False"
                                  ItemsSource="{Binding HistoryUsers}"
                                  Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,10"
                                  ToolTip="下拉选在册账号或直接输入；换账号自动跟出该账号记住的密码">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="19,3"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="密码" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <PasswordBox x:Name="PwdBox" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FreshPwdInput}"/>
                    </Grid>
                    <CheckBox Content="记住密码（按账号各记各的）" IsChecked="{Binding Remember}"
                              FontSize="12" Foreground="#666" Cursor="Hand"
                              HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <!-- 按钮行：修改密码（次级灰，左）+ 登录（实色蓝主按钮，右） -->
                    <Grid Margin="0,18,0,0">
                        <Button Style="{StaticResource FreshButton}" Content="修改密码"
                                Command="{Binding ChangePwdCommand}" Width="96" Height="32"
                                HorizontalAlignment="Left"
                                ToolTip="改用户名框里这个账号的密码（要验原密码）"/>
                        <Button Style="{StaticResource FreshPrimaryButton}" Content="登 录"
                                Command="{Binding OkCommand}" Width="128" Height="32"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- ===== 修改密码面板（缺省收起——双面板不重叠红线：缺省只留一个 Visible） ===== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChangePwd, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="原密码" VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <PasswordBox x:Name="OldPwdBox" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource FreshPwdInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="新密码" VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <PasswordBox x:Name="NewPwdBox" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FreshPwdInput}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="确认新密码" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <PasswordBox x:Name="NewPwd2Box" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource FreshPwdInput}"/>
                    </Grid>
                    <TextBlock Text="新密码至少 6 位，且不得与旧密码相同。"
                               FontSize="11" Foreground="#999" Margin="0,8,0,0"/>
                    <!-- 按钮行：返回（次级灰，左）+ 保存修改（实色蓝主按钮，右） -->
                    <Grid Margin="0,18,0,0">
                        <Button Style="{StaticResource FreshButton}" Content="返 回"
                                Command="{Binding BackCommand}" Width="96" Height="32"
                                HorizontalAlignment="Left" ToolTip="回到登录（Esc）"/>
                        <Button Style="{StaticResource FreshPrimaryButton}" Content="保存修改"
                                Command="{Binding SavePwdCommand}" Width="128" Height="32"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- 共用提示条：错误=浅红底红字 / 成功=浅绿底绿字（改密成功走绿条） -->
                <Border CornerRadius="4" Padding="10,6" Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FDECEA"/>
                            <Setter Property="BorderBrush" Value="#F5C6CB"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <!-- Tip 为空整条收起（登录/改密两面板共用一条） -->
                                <DataTrigger Binding="{Binding Tip, FallbackValue=提示占位}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- 成功提示换绿（改密成功走绿条，错误保持红条） -->
                                <DataTrigger Binding="{Binding TipIsError, FallbackValue=True}" Value="False">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- 文字颜色全交给 Style（本地属性优先级高于 Trigger，直接写
                         Foreground 会压住绿色 Setter——踩过：改密成功字仍红） -->
                    <TextBlock Text="{Binding Tip}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#C8102E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TipIsError, FallbackValue=True}" Value="False">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

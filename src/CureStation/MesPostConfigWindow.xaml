<Window x:Class="CureStation.MesPostConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MesPostConfigViewModel, IsDesignTimeCreatable=False}"
        Title="过账配置" Width="720" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Fresh.FgMid}"
        Icon="Assets/app.ico" FontSize="12">
    <Window.Resources>
        <!-- 双工位专属区块显隐（与 IoTestWindow 同款窗内转换器） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（V0.0.27 弹窗统一）；V0.0.93 起定高自适应（SizeToContent=Height
             + MaxHeight 兜底），缩放边沿不再需要 -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <!--★★ 过账配置窗（P3.2 后半；V0.0.93 简化重排——配置项与保存口径零变化，
         只降文字密度）：W68 终版未定 → 全部配置化，现场"点点鼠标"改完保存即
         生效（主窗热更新过账服务，不重启）。左列=开关与口径（双工位开关——
         单工位时过账工位/架号映射/L 专用参数整块隐藏）+ 静态参数（低频，收
         折叠 Expander）；右列=三个接口 URL。原右列"口径说明"整段撤下（关键
         口径进顶部提示条与各字段 ToolTip），字段标签去 (MAC_NO) 等键名括号
         （键名与 API 号进 ToolTip），下拉选项文案去英文前缀。门禁：主窗 L4。
         纵排纪律（V0.0.37）：长标签一律"标签一行+控件一行"，勿改回两列式
         （定宽列装不下长标签会截断/溢出重叠）。取色全走 Brush.Fresh.*；
         窗口骨架统一自绘标题条。-->
    <!-- 圆角弹窗骨架（全弹窗统一）：透明窗 + 外层圆角 Border（10px）+ Fx.WinShadow 浮层投影，
         根 Grid Margin=14 给阴影渲染留白 -->
    <Grid Margin="14">
    <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
            Effect="{StaticResource Fx.WinShadow}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                <Grid>
                    <TextBlock Style="{StaticResource WinTitleText}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=过账配置}"/>
                    <Button Style="{StaticResource WinTitleClose}" Content="✕" HorizontalAlignment="Right"
                            Click="OnCloseClick" ToolTip="关闭（不保存）"/>
                </Grid>
            </Border>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶：保存即生效（原"口径说明"六条浓缩成一行，细节进 ToolTip） -->
                <Border Grid.Row="0" Style="{StaticResource FreshHintBorder}" Margin="0,0,0,8" Padding="8,4"
                        ToolTip="出站被 MES 接受（STATUS=1）后对应工位『已生产数量』自动 +1；过账失败只记日志与顶栏状态，不弹框不重传（防重复过账）。">
                    <TextBlock Text="保存即生效，不需要重启程序；总开关关闭时不产生任何网络请求。"
                               Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左列：开关与口径 + 静态参数（低频折叠） -->
                    <Border Grid.Column="0" Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="过账"/>
                                <CheckBox IsChecked="{Binding EditEnabled, FallbackValue=False}"
                                          Content="启用过账" Cursor="Hand" Margin="0,8,0,0"
                                          ToolTip="关闭=只程控不过账，不产生任何网络请求"/>
                                <!-- 双工位开关（缺省关=单工位）：勾选才显示下面过账工位/架号映射/L 专用参数 -->
                                <CheckBox IsChecked="{Binding EditDualSide, FallbackValue=False}"
                                          Content="双工位模式" Cursor="Hand" Margin="0,10,0,0"
                                          ToolTip="工单窗 R/L 双面板分开记账；现场单工位保持不勾"/>
                                <!-- 过账工位（仅双工位模式显示，2026-10-31 用户拍板）：单工位
                                     下控件隐藏但 Side 值仍随配置往返（ini [CuringMes] Side 缺省 R
                                     照常生效） -->
                                <StackPanel Visibility="{Binding EditDualSide, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                            Margin="0,10,0,0">
                                    <TextBlock Text="过账工位：" ToolTip="自动进/出站取哪侧工单（单工位恒用此项，与勾不勾双工位无关）"/>
                                    <ComboBox Style="{StaticResource FreshCombo}" ItemsSource="{Binding SideOptions, FallbackValue={x:Null}}"
                                              SelectedItem="{Binding EditSide}" Width="120" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- 上报口径：低频校准参数（W68 终版到位才动）收折叠面板——
                                     日常不可见，也避免与工艺策略窗的显示单位（时/分，纯本地
                                     口径）并排出现造成"两处单位不一致"的观感困扰（用户拍板
                                     2026-11-10）。注意两者不同轴：这里配的是 MES 报文契约，
                                     策略窗配的是界面显示，互相独立，ToolTip 讲清防误改。 -->
                                <Expander Header="上报口径（W68 终版校准用，一般默认）" Margin="0,12,0,0" IsExpanded="False">
                                    <StackPanel Margin="14,8,0,0">
                                        <!-- 纵排（标签一行+控件一行）：两列式列宽装不下长选项会被
                                             钳住尾部截断（V0.0.28/V0.0.37 两修，勿改回两列式） -->
                                        <TextBlock Text="固化时间单位：" Margin="0,0,0,0"
                                                   ToolTip="API0027 上报给 MES 的固化时间单位——这是与 MES 的报文约定（老项目口径=秒），不是界面显示单位；与工艺策略窗的『时/分』显示口径互相独立。W68 终版到位后如需调整在此改"/>
                                        <ComboBox Style="{StaticResource FreshCombo}" ItemsSource="{Binding TimeUnitOptions, FallbackValue={x:Null}}"
                                                  SelectedIndex="{Binding EditTimeUnitIndex, FallbackValue=0}"
                                                  Width="Auto" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                  ToolTip="API0027 上报给 MES 的固化时间单位——这是与 MES 的报文约定（老项目口径=秒），不是界面显示单位；与工艺策略窗的『时/分』显示口径互相独立。W68 终版到位后如需调整在此改"/>
                                        <TextBlock Text="进站上传时机：" Margin="0,10,0,0"
                                                   ToolTip="API0030 进站(I) 的触发点：托盘到位 或 开计时"/>
                                        <ComboBox Style="{StaticResource FreshCombo}" ItemsSource="{Binding InAtOptions, FallbackValue={x:Null}}"
                                                  SelectedIndex="{Binding EditInAtIndex, FallbackValue=0}"
                                                  Width="Auto" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                  ToolTip="API0030 进站(I) 的触发点：托盘到位 或 开计时"/>
                                    </StackPanel>
                                </Expander>
                                <CheckBox IsChecked="{Binding EditPostAbortOut, FallbackValue=True}"
                                          Content="计时中取件照常传出站" Cursor="Hand" Margin="0,10,0,0"
                                          ToolTip="计时中强制取料离开（托盘 OFF）时，仍补传固化时间与出站，防漏账"/>

                                <!-- 双工位专属（开关关=单工位→整块隐藏：现场没有另一侧，这两组参数无意义） -->
                                <StackPanel Visibility="{Binding EditDualSide, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="架号映射：" FontWeight="SemiBold"
                                               ToolTip="格式：架号段:工位，分号分隔多段。架号段支持 '11-20' 闭区间或单号 '11'。例：11-20:L；留空=全部用上面的过账工位"/>
                                    <TextBlock Text="架号段:工位，分号分隔（例 11-20:L）；留空=全部用过账工位。"
                                               Foreground="{DynamicResource Brush.Fresh.FgDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditRackSides}"
                                             ToolTip="格式：架号段:工位，分号分隔。架号段支持 '11-20' 闭区间或单号 '11'。例：11-20:L"/>
                                </StackPanel>

                                <!-- 静态参数：低频（留空=用 MES 参数记忆），收折叠面板 -->
                                <Expander Header="静态参数（留空=用 MES 参数记忆）" Margin="0,14,0,0" IsExpanded="False">
                                    <StackPanel Margin="14,8,0,0">
                                        <TextBlock Text="机台编号：" Margin="0,0,0,2" ToolTip="MES 字段 MAC_NO"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacNo}"
                                                 ToolTip="MES 字段 MAC_NO"/>
                                        <StackPanel Visibility="{Binding EditDualSide, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                                    Margin="0,6,0,0">
                                            <TextBlock Text="机台编号-L工位：" Margin="0,0,0,2"
                                                       ToolTip="MES 字段 MAC_NO_L；可选，双架映射到 L 工位时用，留空=同机台编号"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacNoL}"
                                                     ToolTip="MES 字段 MAC_NO_L；可选，双架映射到 L 工位时用，留空=同机台编号"/>
                                        </StackPanel>
                                        <TextBlock Text="机台位置号：" Margin="0,6,0,2" ToolTip="MES 字段 MAC_LOC_NO"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacLocNo}"
                                                 ToolTip="MES 字段 MAC_LOC_NO"/>
                                        <StackPanel Visibility="{Binding EditDualSide, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                                    Margin="0,6,0,0">
                                            <TextBlock Text="机台位置号-L工位：" Margin="0,0,0,2"
                                                       ToolTip="MES 字段 MAC_LOC_NO_L；可选，双架映射到 L 工位时用，留空=同机台位置号"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacLocNoL}"
                                                     ToolTip="MES 字段 MAC_LOC_NO_L；可选，双架映射到 L 工位时用，留空=同机台位置号"/>
                                        </StackPanel>
                                        <TextBlock Text="厂别：" Margin="0,6,0,2" ToolTip="MES 字段 PLANT"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditPlant}"
                                                 ToolTip="MES 字段 PLANT"/>
                                        <TextBlock Text="参数编码：" Margin="0,6,0,2" ToolTip="MES 字段 PRA_CODE"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditPraCode}"
                                                 ToolTip="MES 字段 PRA_CODE"/>
                                        <TextBlock Text="检测结果：" Margin="0,6,0,2" ToolTip="MES 字段 CHECK_RESULT"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditCheckResult}"
                                                 ToolTip="MES 字段 CHECK_RESULT"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右列：接口 URL（键名/API 号进 ToolTip） -->
                    <Border Grid.Column="1" Style="{StaticResource FreshCardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="接口 URL"/>
                                <TextBlock Text="固化时间上传：" Margin="0,8,0,2"
                                           ToolTip="API0027 · W68 终版到位后在此改"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditUrl27}"
                                         ToolTip="API0027 · W68 终版到位后在此改"/>
                                <TextBlock Text="进出站：" Margin="0,10,0,2"
                                           ToolTip="API0030 进站(I) / 出站(O) · W68 终版到位后在此改"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditUrl30}"
                                         ToolTip="API0030 进站(I) / 出站(O) · W68 终版到位后在此改"/>
                                <TextBlock Text="物料上传：" Margin="0,10,0,2"
                                           ToolTip="API0032 批次物料上报 · W68 终版到位后在此改"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditUrl32}"
                                         ToolTip="API0032 批次物料上报 · W68 终版到位后在此改"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 底：保存 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Tag="{StaticResource Geo.Save}" Style="{StaticResource FreshButton}" Content="保存配置"
                            Command="{Binding SaveCommand}" Width="160" Height="34"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>

<Window x:Class="CureStation.MesPostConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MesPostConfigViewModel, IsDesignTimeCreatable=False}"
        Title="过账配置（单线 MES 上报）" Height="800" Width="880"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Fresh.FgMid}"
        Icon="Assets/app.ico" FontSize="12">
    <Window.Resources>
        <!-- 双工位专属区块显隐（与 IoTestWindow 同款窗内转换器） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（V0.0.27 弹窗统一）：标题条命中拖动 + 边沿 6px 缩放 -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <!--★★ 过账配置窗（P3.2 后半）：W68 终版未定 → 全部配置化，现场"点点鼠标"
         改完保存即生效（主窗热更新过账服务，不重启）。左列开关与口径（含
         双工位开关——单工位时架号映射/L 专用参数整块隐藏）+ 静态参数；
         右列三个接口 URL + 说明。门禁：主窗 L4。
         取色全走 Brush.Fresh.*；窗口骨架统一自绘标题条。-->
    <!-- 圆角弹窗骨架（全弹窗统一）：透明窗 + 外层圆角 Border（10px）+ Fx.WinShadow 浮层投影，
         根 Grid Margin=14 给阴影渲染留白 -->
    <Grid Margin="14">
    <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
            Effect="{StaticResource Fx.WinShadow}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                <Grid>
                    <TextBlock Style="{StaticResource WinTitleText}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=过账配置（单线 MES 上报）}"/>
                    <Button Style="{StaticResource WinTitleClose}" Content="✕" HorizontalAlignment="Right"
                            Click="OnCloseClick" ToolTip="关闭"/>
                </Grid>
            </Border>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左列：开关与口径 + 静态参数 -->
                    <Border Grid.Column="0" Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="过账开关与口径"/>
                                <CheckBox IsChecked="{Binding EditEnabled, FallbackValue=False}"
                                          Content="启用单线过账（关闭=只程控不过账）" Margin="0,6,0,0"/>
                                <!-- 双工位开关（缺省关=单工位）：勾选才显示下面架号映射与 L 工位专用参数 -->
                                <CheckBox IsChecked="{Binding EditDualSide, FallbackValue=False}"
                                          Content="双工位模式（工单窗 R/L 双面板分开记账；现场单工位保持不勾）"
                                          Margin="0,10,0,0"/>
                                <!-- 纵排（标签一行+控件一行）：两列式列宽装不下长标签，
                                     会把 220 宽下拉挤溢到右列形成重叠（V0.0.37 修，
                                     与"固化时间单位"纵排同因同治） -->
                                <TextBlock Text="过账工位（自动进/出站取哪侧工单）：" Margin="0,10,0,0"/>
                                <ComboBox Style="{StaticResource FreshCombo}" ItemsSource="{Binding SideOptions, FallbackValue={x:Null}}"
                                          SelectedItem="{Binding EditSide}" Width="120" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                                <!-- 固化时间单位单独纵排（标签一行+下拉一行）：两列式列宽 ~164 装不下
                                     最宽选项"Seconds（秒，老项目口径）"（自然宽 ~206）——定宽 220 与 Auto
                                     都被列宽钳住尾部截断（V0.0.28 修）；独占整卡宽后 Auto 自然舒展 -->
                                <TextBlock Text="固化时间单位（API0027）：" Margin="0,8,0,0"/>
                                <ComboBox Style="{StaticResource FreshCombo}" ItemsSource="{Binding TimeUnitOptions, FallbackValue={x:Null}}"
                                          SelectedIndex="{Binding EditTimeUnitIndex, FallbackValue=0}"
                                          Width="Auto" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                                <TextBlock Text="进站上传时机（API0030 I）：" Margin="0,8,0,0"/>
                                <ComboBox Style="{StaticResource FreshCombo}" ItemsSource="{Binding InAtOptions, FallbackValue={x:Null}}"
                                          SelectedIndex="{Binding EditInAtIndex, FallbackValue=0}"
                                          Width="220" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                                <CheckBox IsChecked="{Binding EditPostAbortOut, FallbackValue=True}"
                                          Content="计时中取件（强制出料）照常传出站" Margin="0,10,0,0"/>

                                <!-- 双工位专属（开关关=单工位→整块隐藏：现场没有另一侧，这两组参数无意义） -->
                                <StackPanel Visibility="{Binding EditDualSide, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="双架工位映射（仅双工位模式生效）" Margin="0,14,0,0"/>
                                    <TextBlock Text="架号段:工位，分号分隔多段（例 11-20:L = 第二台固化架报 L 工位）；留空=全部用上面的过账工位。"
                                               Foreground="{DynamicResource Brush.Fresh.FgDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditRackSides}"
                                             ToolTip="格式：架号段:工位，分号分隔。架号段支持 '11-20' 闭区间或单号 '11'。例：11-20:L"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="静态参数（留空=用 MES 参数记忆）" Margin="0,14,0,0"/>
                                <!-- 纵排逐项（标签一行+输入一行）：原两列式列宽 ~157px 装不下
                                     "机台位置号-L工位(MAC_LOC_NO_L)："这类长标签——尾部整段
                                     被裁还与右邻输入框挤在一行（V0.0.37 修，短标签浪费不了） -->
                                <TextBlock Text="机台编号(MAC_NO)：" Margin="0,6,0,0"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacNo}"/>
                                <StackPanel Visibility="{Binding EditDualSide, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                            Margin="0,6,0,0">
                                    <TextBlock Text="机台编号-L工位(MAC_NO_L)：" ToolTip="可选：L 工位专用机台号（双架映射到 L 时用）；留空=同 MAC_NO"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacNoL}"/>
                                </StackPanel>
                                <TextBlock Text="机台位置号(MAC_LOC_NO)：" Margin="0,6,0,0"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacLocNo}"/>
                                <StackPanel Visibility="{Binding EditDualSide, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                            Margin="0,6,0,0">
                                    <TextBlock Text="机台位置号-L工位(MAC_LOC_NO_L)：" ToolTip="可选：L 工位专用机台位置号；留空=同 MAC_LOC_NO"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditMacLocNoL}"/>
                                </StackPanel>
                                <TextBlock Text="厂别(PLANT)：" Margin="0,6,0,0"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditPlant}"/>
                                <TextBlock Text="参数编码(PRA_CODE)：" Margin="0,6,0,0"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditPraCode}"/>
                                <TextBlock Text="检测结果(CHECK_RESULT)：" Margin="0,6,0,0"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditCheckResult}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右列：接口 URL + 说明 -->
                    <Border Grid.Column="1" Style="{StaticResource FreshCardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="接口 URL（W68 终版到位后在此改）"/>
                                <TextBlock Text="API0027（固化时间上传）：" Margin="0,8,0,2"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditUrl27}"/>
                                <TextBlock Text="API0030（进出站）：" Margin="0,10,0,2"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditUrl30}"/>
                                <TextBlock Text="API0032（物料上传）：" Margin="0,10,0,2"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditUrl32}"/>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="口径说明" Margin="0,16,0,0"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Fresh.FgDim}"
                                           Text="• 托盘到位=进站（ACTION=I），托盘离开=出站（先固化时间后出站）——与老项目『装载/卸载』命令字同义。&#x0a;• 双工位开关关（缺省，单工位）=全部按『过账工位』报本侧；勾开才有 R/L 两套工单与架号映射。&#x0a;• 出站被 MES 接受（STATUS=1）后，对应工位『已生产数量』自动 +1。&#x0a;• BC_NO 取工单『物料条码』（批次级过账）；板级产品 ID 上报走程序②整线网关。&#x0a;• 过账失败只记日志与顶栏状态，不弹框不重传（防重复过账，人工处理）。&#x0a;• 保存即生效（无需重启）；总开关关闭时不产生任何网络请求。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 底：保存 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Tag="{StaticResource Geo.Save}" Style="{StaticResource FreshButton}" Content="保存配置"
                            Command="{Binding SaveCommand}" Width="160" Height="34"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>

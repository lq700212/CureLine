<Window x:Class="CureStation.PointTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PointTableViewModel, IsDesignTimeCreatable=False}"
        Title="IO 点表配置（点点鼠标，无需改代码）"
        Height="880" Width="1400" MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Fresh.FgMid}"
        Icon="Assets/app.ico"
        FontSize="12">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（V0.0.27 弹窗统一）：标题条命中拖动 + 边沿 6px 缩放 -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <!--★★ 点表配置窗（现场人员的配置主场）：
         左：设备列表 + 设备编辑/高级参数 + 批量生成机台耦合器（10 台现场口径
         一键配完）+ 单台缺省模板（下半部包 ScrollViewer，小窗只滚动不裁剪）；
         右：绑定表**直编**（V0.0.45 用户拍板傻瓜式——原"选中行→右下编辑面板"
         两步操作删除，方向/块/角色/架/层/功能名全部行内改，写穿 Raw 所见即
         所得）+ 加/删行按钮 + 测试连接/测试全部（不存盘直测，结果列表逐台
         定位）+ 保存（校验不过不落盘）。
         取色全走 Brush.Fresh.*；Expander/ListBox/DataGrid 走 App.xaml 主题化样式。-->
    <!-- 圆角弹窗骨架（全弹窗统一）：透明窗 + 外层圆角 Border（10px）+ Fx.WinShadow 浮层投影，
         根 Grid Margin=14 给阴影渲染留白 -->
    <Grid Margin="14">
    <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
            Effect="{StaticResource Fx.WinShadow}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                <Grid>
                    <TextBlock Style="{StaticResource WinTitleText}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=IO 点表配置（点点鼠标，无需改代码）}"/>
                    <Button Style="{StaticResource WinTitleClose}" Content="✕" HorizontalAlignment="Right"
                            Click="OnCloseClick" ToolTip="关闭"/>
                </Grid>
            </Border>
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列：设备管理 + 高级参数 + 生成模板（内容多，包 ScrollViewer
                     防小窗/小屏挤压裁剪——此前底部模板区把设备编辑区挤出可视区） -->
                <Border Grid.Column="0" Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   Text="设备（IO 耦合器）"/>
                        <Button Tag="{StaticResource Geo.Plus}" DockPanel.Dock="Top" Style="{StaticResource FreshButton}"
                                Content="＋ 添加设备" Command="{Binding AddDeviceCommand}" Margin="0,8"/>
                        <ListBox DockPanel.Dock="Top" Height="148"
                                 ItemsSource="{Binding Devices, FallbackValue={x:Null}}"
                                 SelectedItem="{Binding SelectedDevice}" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, FallbackValue=设备}" Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Ip, FallbackValue=192.168.1.20}" Foreground="{DynamicResource Brush.Fresh.FgDim}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Tag="{StaticResource Geo.Trash}" DockPanel.Dock="Top" Style="{StaticResource FreshButton}"
                                Content="－ 删除选中设备" Command="{Binding RemoveDeviceCommand}" Margin="0,0,0,10"/>
                        <!-- 其余内容进滚动区：设备编辑 → 高级参数 → 批量生成 → 单台模板，
                             动线=选设备→改名/调参→批量生成→单台模板；窗口再小也只滚动不裁剪 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,2,0">
                                <!-- 设备级编辑（选中设备回显，V0.0.45 修切换不跟随） -->
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <TextBlock Text="设备名：" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding DeviceName, FallbackValue=IO耦合器1}"/>
                                    <TextBlock Text="IP：" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding DeviceIp, FallbackValue=192.168.1.20}"/>
                                </UniformGrid>
                                <!-- 设备高级参数（V0.0.20 全 UI 化，此前只能手编 pointtable.json）：
                                     地址段/端口/轮询/取反——真机联调"点点鼠标"校准，缺省即缺省模板口径 -->
                                <Expander Header="设备高级参数（端口/地址段/轮询/取反，缺省不用动）"
                                          Margin="0,0,0,8">
                                    <StackPanel Margin="0,4,0,0">
                                        <UniformGrid Columns="2">
                                            <TextBlock Text="端口：" VerticalAlignment="Center" ToolTip="Modbus TCP 端口，缺省 502"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDevicePort, FallbackValue=502}"/>
                                            <TextBlock Text="从站号(UnitId)：" VerticalAlignment="Center" Margin="0,6,0,0"
                                                       ToolTip="Modbus 从站地址，缺省 1"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDeviceUnitId, FallbackValue=1}" Margin="0,6,0,0"/>
                                            <TextBlock Text="DI 起始地址：" VerticalAlignment="Center" Margin="0,6,0,0"
                                                       ToolTip="输入(DI)寄存器首地址，支持 0x 十六进制或十进制；缺省 0x1000=4096"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDeviceDiStart, FallbackValue=0x1000}" Margin="0,6,0,0"/>
                                            <TextBlock Text="DO 起始地址：" VerticalAlignment="Center" Margin="0,6,0,0"
                                                       ToolTip="输出(DO)保持寄存器首地址；缺省 0x1010=4112"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDeviceDoStart, FallbackValue=0x1010}" Margin="0,6,0,0"/>
                                            <TextBlock Text="块跨度(寄存器)：" VerticalAlignment="Center" Margin="0,6,0,0"
                                                       ToolTip="相邻两块（架）的地址间隔；缺省 0x20=32。地址=起始+(块号-1)×跨度"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDeviceStride, FallbackValue=0x20}" Margin="0,6,0,0"/>
                                            <TextBlock Text="每块点数：" VerticalAlignment="Center" Margin="0,6,0,0"
                                                       ToolTip="每块占用寄存器位数（1~16），缺省 16"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDevicePointsPerBlock, FallbackValue=16}" Margin="0,6,0,0"/>
                                            <TextBlock Text="超时(ms)：" VerticalAlignment="Center" Margin="0,6,0,0"
                                                       ToolTip="TCP 连接/读写超时，缺省 3000"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDeviceTimeoutMs, FallbackValue=3000}" Margin="0,6,0,0"/>
                                            <TextBlock Text="轮询周期(ms)：" VerticalAlignment="Center" Margin="0,6,0,0"
                                                       ToolTip="IO 扫描周期，最小 50，缺省 250"/>
                                            <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditDevicePollIntervalMs, FallbackValue=250}" Margin="0,6,0,0"/>
                                        </UniformGrid>
                                        <CheckBox IsChecked="{Binding EditDeviceInvertInputs, FallbackValue=False}"
                                                  Content="输入取反（现场 DI 高电平=灭时勾）" Margin="0,8,0,0"/>
                                        <CheckBox IsChecked="{Binding EditDeviceInvertOutputs, FallbackValue=False}"
                                                  Content="输出取反（现场 DO 低电平=亮时勾）" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>
                                <!-- 批量生成机台耦合器（V0.0.41 现场口径）：10 列 × 3 层、
                                     每列 1 台 GFNB——缺省参数即现场现值（IP .20~.29 已预填），
                                     点一下覆盖重建 10 台，逐台改 IP/名字即可保存 -->
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}"
                                               Text="批量生成机台耦合器（推荐）"/>
                                    <TextBlock Text="一台机台 N 列 × 3 层 = N 台耦合器，一台管一列（每台 1 架 3 层）；IP 从首址按步长递增预填"
                                               Foreground="{DynamicResource Brush.Fresh.FgDim}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <UniformGrid Columns="2">
                                        <TextBlock Text="台数（列数）：" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding BatchCountText, FallbackValue=10}"/>
                                        <TextBlock Text="IP 首址：" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding BatchIpFirstText, FallbackValue=192.168.1.20}" Margin="0,6,0,0"/>
                                        <TextBlock Text="IP 递增步长：" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding BatchIpStepText, FallbackValue=1}" Margin="0,6,0,0"/>
                                    </UniformGrid>
                                    <Button Style="{StaticResource FreshButton}" Margin="0,8"
                                            Content="批量生成（覆盖全部设备，IP 预填现值）"
                                            Command="{Binding GenerateMachineCommand}"/>
                                </StackPanel>
                                <!-- 一键缺省模板（单台微调）：双架部署第二台耦合器用 -->
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}"
                                               Text="一键缺省模板"/>
                                    <TextBlock Text="按 IO 表布局生成全部绑定（IP/起始架号/架数/层数）"
                                               Foreground="{DynamicResource Brush.Fresh.FgDim}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <UniformGrid Columns="2">
                                        <TextBlock Text="IP：" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding TemplateIp, FallbackValue=192.168.1.20}"/>
                                        <TextBlock Text="起始架号：" VerticalAlignment="Center"
                                                   ToolTip="全局架号从几号起编（单架=1；双架第二台耦合器填 11，生成架 11~20）"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding TemplateRackStart, FallbackValue=1}"/>
                                        <TextBlock Text="架数：" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding TemplateRacks, FallbackValue=10}"/>
                                        <TextBlock Text="每架层数：" VerticalAlignment="Center"/>
                                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding TemplateLevels, FallbackValue=3}"/>
                                    </UniformGrid>
                                    <TextBlock Text="双架：第二台设备起始架号填 11（架号全局唯一，撞号保存时会被拦）。"
                                               Foreground="{DynamicResource Brush.Fresh.FgDim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource FreshButton}" Margin="0,8,0,2"
                                            Content="生成缺省模板（覆盖当前设备绑定）"
                                            Command="{Binding GenerateTemplateCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 右列：绑定表（直编）+ 加删行 + 测试 + 保存 -->
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                               Text="点位绑定（表格直接编辑：角色下拉/块/架/层/功能名，改完点保存）"/>
                    <!-- 当前设备归属提示（V0.0.41）：多台耦合器部署排障时，
                         这屏绑定属于哪台设备一眼定位（名称/IP 随左栏选中联动） -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentDeviceText, FallbackValue=当前设备：—}"
                               Foreground="{DynamicResource Brush.Fresh.FgDim}" Margin="0,0,0,4"/>
                    <!-- 按钮行：加删行（表格编辑配套）+ 连通测试（V0.0.41 补 UI 死命令：
                         测试期间两钮齐灰 IsTesting，不冻界面） -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                        <Button Tag="{StaticResource Geo.Plus}" Style="{StaticResource FreshButton}" Content="＋ 添加行"
                                Command="{Binding AddBindingCommand}" Margin="0,0,8,0" Width="110"
                                ToolTip="给当前设备加一行预留位（块1·位3·输入），在表格里接着改角色/架/层"/>
                        <Button Tag="{StaticResource Geo.Trash}" Style="{StaticResource FreshButton}" Content="－ 删除选中行"
                                Command="{Binding DeleteBindingCommand}" Margin="0,0,24,0" Width="110"
                                ToolTip="删除当前选中行（未保存前关窗可找回）"/>
                        <Button Style="{StaticResource FreshButton}" Content="测试连接" Width="110" Margin="0,0,8,0"
                                Command="{Binding TestConnectionCommand}"
                                ToolTip="直测当前选中设备（IP/端口/寄存器读回），不存盘"/>
                        <Button Style="{StaticResource FreshButton}" Content="测试全部" Width="110"
                                Command="{Binding TestAllCommand}"
                                ToolTip="逐台测试全部耦合器，结果进下方列表"/>
                    </StackPanel>
                    <!-- 绑定表（V0.0.45 直编）：方向/角色=下拉（中文文案与落盘英文枚举
                         同源转换），块/点号/架/层=数字直填（填错弹回原值），功能名=文本；
                         点号列 V0.0.47 起同行内可编辑（X/Y 前缀语义由方向列表达，
                         LostFocus 即提交）——全部写穿 Raw，保存前校验统一拦 -->
                    <!-- ★IsReadOnly="False" 是覆盖 App.xaml 隐式 DataGrid 样式的关键：
                         隐式样式（弹窗通用）缺省 IsReadOnly=True=只读展示表口径，
                         绑定表是编辑表，不显式覆盖则**全列改不了、点击没反应**（V0.0.46 修的根因）。
                         PreviewMouseLeftButtonDown=文本列"单击即编辑"（code-behind）。 -->
                    <DataGrid ItemsSource="{Binding Bindings, FallbackValue={x:Null}}"
                              SelectedItem="{Binding SelectedBinding}"
                              IsReadOnly="False"
                              PreviewMouseLeftButtonDown="OnBindingsGridPreviewMouseLeftButtonDown"
                              HeadersVisibility="Column" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              Margin="0,2,0,0">
                        <DataGrid.Columns>
                            <!-- ★方向/角色两列=TemplateColumn+常驻下拉（单击直接出下拉框）：
                                 DataGridComboBoxColumn 的下拉只见于编辑态，缺省单击只选中，
                                 现场手感像"没反应"——傻瓜式直编必须常驻控件。FreshCombo 点哪
                                 都开（ClickMode=Press 透明命中铺满全框），Height 32→24 免撑行高；
                                 数据源 x:Static（静态枚举文案，零 DataContext 依赖） -->
                            <DataGridTemplateColumn Header="方向" Width="96" SortMemberPath="IsInput">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource FreshCombo}" Height="24"
                                                  ItemsSource="{x:Static vm:PointTableViewModel.DirectionOptions}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Text"
                                                  SelectedValue="{Binding IsInput, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="块" Binding="{Binding Block}" Width="46"/>
                            <!-- 点号（V0.0.47 开放编辑）：DisplayIndex 紧跟块列。显示=纯序号
                                 0~15（端子 X0~XF/Y0~YF 的位号；X/Y 前缀由方向列表达不重复）；
                                 越界/同点重复由保存前校验弹框拦 -->
                            <DataGridTextColumn Header="点号" Binding="{Binding Bit}" Width="88"/>
                            <DataGridTemplateColumn Header="角色" Width="134" SortMemberPath="Role">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource FreshCombo}" Height="24"
                                                  ItemsSource="{x:Static vm:PointTableViewModel.RoleOptions}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Text"
                                                  SelectedValue="{Binding Role, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="架号" Binding="{Binding Rack}" Width="54"/>
                            <DataGridTextColumn Header="层号" Binding="{Binding Level}" Width="54"/>
                            <DataGridTextColumn Header="功能名" Binding="{Binding FunctionName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 测试结果列表（测试全部逐台出结果：时间/设备/IP/OK·NG/原因） -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource FreshCardBorder}" Padding="10" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="测试结果（最近 50 条）"/>
                            <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding TestResults, FallbackValue={x:Null}}"
                                      Height="170" Margin="0,8,0,0" IsReadOnly="True"
                                      HeadersVisibility="Column">
                                <!-- 列宽合计 276 ≤ 右栏可用 358（旧版 300>250 被裁，"结果"列
                                     只剩半字）；消息长文悬停展开（顶栏"短词+悬停全文"同款口径） -->
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText, FallbackValue=00:00:00}" Width="52"/>
                                    <DataGridTextColumn Header="设备" Binding="{Binding DeviceName, FallbackValue=IO耦合器1}" Width="88"/>
                                    <DataGridTextColumn Header="IP" Binding="{Binding Ip, FallbackValue=192.168.1.20}" Width="96"/>
                                    <DataGridTextColumn Header="结果" Binding="{Binding ResultText, FallbackValue=OK}" Width="40"/>
                                    <DataGridTextColumn Header="消息" Binding="{Binding Message, FallbackValue=''}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Message, FallbackValue=''}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Button Tag="{StaticResource Geo.Save}" DockPanel.Dock="Bottom" Style="{StaticResource FreshButton}"
                            Content="保存（校验后写配置文件）"
                            Command="{Binding SaveCommand}" Margin="0,8" Height="40"/>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>

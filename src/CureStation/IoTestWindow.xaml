<Window x:Class="CureStation.IoTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IoTestViewModel, IsDesignTimeCreatable=False}"
        Title="IO 通讯测试（点表通道验证）"
        Height="760" Width="1280" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Fresh.FgMid}"
        Icon="Assets/app.ico" FontSize="12">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（V0.0.27 弹窗统一）：标题条命中拖动 + 边沿 6px 缩放 -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <!--★★ IO 通讯测试窗（移植 AgingTestSystem 通讯测试思路 + 本项目点表通用化）：
         通道清单完全来自 config/pointtable.json（界面可配）——换项目/换耦合器
         零代码，改点表即适配。仓位卡网格与主窗同源布局；DI 只读灯（快照轮询
         500ms 刷新）、DO 点击灯钮（Task.Run 后台写，真机走总线 RMW 不误伤
         同寄存器其它通道）；一键遍历=500ms/路跑马灯快速验接线。
         三态灯色：绿=ON / 灰=OFF / 浅虚灰=未读到（断连或未轮询到）——
         色走 Fresh 键板（Success/DotOff/DotNoRead，Dark 同名换深色灯珠）。
         连接共享：复用主窗 IPointTableBus，本窗不建 TCP（关窗 Detach 退订）。-->
    <!-- 圆角弹窗骨架（全弹窗统一）：透明窗 + 外层圆角 Border（10px）+ Fx.WinShadow 浮层投影，
         根 Grid Margin=14 给阴影渲染留白 -->
    <Grid Margin="14">
    <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
            Effect="{StaticResource Fx.WinShadow}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                <Grid>
                    <TextBlock Style="{StaticResource WinTitleText}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=IO 通讯测试（点表通道验证）}"/>
                    <Button Style="{StaticResource WinTitleClose}" Content="✕" HorizontalAlignment="Right"
                            Click="OnCloseClick" ToolTip="关闭（Esc）"/>
                </Grid>
            </Border>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：连接状态 + 操作按钮 -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Fresh.CardBg}"
                        BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Fresh.Danger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected, FallbackValue=False}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Fresh.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText, FallbackValue=未启动}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Fresh.FgMid}"/>
                            <!-- 机台选择（多机台=双架及以上才显示）：一次只测一台固化架，
                                 界面固定 30 库位（每行 10 个，主窗同款行优先）；单机台隐藏，
                                 视觉与旧版一致 -->
                            <ComboBox ItemsSource="{Binding Machines, FallbackValue={x:Null}}"
                                      SelectedIndex="{Binding SelectedMachineOrdinal}"
                                      Style="{StaticResource FreshCombo}" Width="120" Height="28"
                                      Margin="14,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding IsMachinePickerVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                      ToolTip="多机台（双架及以上）时选择当前测试哪台固化架；一次显示一台机台的 30 个库位"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Tag="{StaticResource Geo.Eye}" Style="{StaticResource FreshButton}" Content="读取状态"
                                    Command="{Binding RefreshCommand}" Width="96" Height="32" Margin="0,0,8,0"
                                    ToolTip="立即按总线最新快照刷新全部通道灯（平时每 500ms 自动刷）"/>
                            <Button Tag="{StaticResource Geo.CloseX}" Content="全部关闭" Width="96" Height="32" Margin="0,0,8,0"
                                    Command="{Binding AllOffCommand}"
                                    ToolTip="把全部 DO 通道写 OFF（测完复位；逐路写并汇总结果）">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FreshButton}"/>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SweepCommand}" Width="140" Height="32" Margin="0,0,8,0"
                                    ToolTip="500ms/路跑马灯逐路点亮 DO，快速验证每路接线通断；再点停止并全部关闭">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FreshDangerButton}">
                                        <Setter Property="Content" Value="一键遍历"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sweeping, FallbackValue=False}" Value="True">
                                                <Setter Property="Content" Value="停止遍历"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource FreshButton}" Content="关 闭" Width="72" Height="32"
                                    IsCancel="True"/>
                        </StackPanel>
                        <TextBlock Text="DI=只读状态灯（灰底）；DO=可点击灯钮（点击切换 ON/OFF）；悬停看通道全名与状态"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Fresh.FgDim}" Margin="8,0"/>
                    </DockPanel>
                </Border>

                <!-- 中区：仓位卡网格（与主窗同布局；行优先铺格；多机台随顶部下拉
                     切换当前机台，一次只显示 30 库位=每行固定 10 个） -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Fresh.CardBg}"
                        BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Slots, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid
                                        Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=10}"
                                        Rows="{Binding DataContext.LevelCount, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=3}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Fresh.SubCardBg}"
                                            BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}" BorderThickness="1"
                                            CornerRadius="4" Margin="3" Padding="6,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title, FallbackValue=架1-层1}"
                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Fresh.FgStrong}"
                                                       HorizontalAlignment="Center"/>
                                            <!-- 输入通道（DI 只读灯珠） -->
                                            <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,4,0,0"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="15" Height="15" Margin="2,0"
                                                                 ToolTip="{Binding Tip, FallbackValue=左侧光栅OK}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Fresh.DotOff}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Fresh.Success}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOn}" Value="{x:Null}">
                                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Fresh.DotNoRead}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 输出通道（DO 可点击灯钮） -->
                                            <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,4,0,0"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="24" Height="24" Margin="2,0"
                                                                Command="{Binding DataContext.TogglePointCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Tip, FallbackValue=状态灯_红}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" CornerRadius="12"
                                                                            BorderThickness="1" BorderBrush="{DynamicResource Brush.Fresh.DotBorder}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.DotOff}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Fresh.Success}"/>
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.SuccessBorder}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsOn}" Value="{x:Null}">
                                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Fresh.DotNoRead}"/>
                                                                                    </DataTrigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Opacity" Value="0.85"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 底部：操作日志（边沿记：点写/遍历进度/总线事件） -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Fresh.CardBg}"
                        BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}" BorderThickness="1"
                        CornerRadius="4" Margin="0,8,0,0" Padding="4">
                    <ListBox ItemsSource="{Binding LogLines, FallbackValue={x:Null}}"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>

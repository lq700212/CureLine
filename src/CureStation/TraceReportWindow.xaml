<Window x:Class="CureStation.TraceReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:local="clr-namespace:CureStation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TraceReportViewModel, IsDesignTimeCreatable=False}"
        Title="固化追溯报表 - 固化程控"
        Width="1240" Height="700" MinWidth="1200" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.FgMid}"
        FontSize="12">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（与报警窗/日志窗同族）：头条即命中拖动区，边沿 6px 缩放；
             系统按钮全关，✕ 内置于头条右端 -->
        <shell:WindowChrome CaptionHeight="36" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:TraceReasonConverter x:Key="ReasonText"/>
        <local:BoolMarkConverter x:Key="BoolMark"/>
        <!-- ============ 时间筛选（V0.0.100 参考 HJVision mFormMesRecord 重做） ============
             HJVision 口径：一侧一个 "yyyy-MM-dd HH:mm" 整框（150px）——本窗同款：
             外层 FieldShell 输入框壳（FreshInput 同观感：悬停换边/聚焦变主蓝边），
             内部 = 无边框 DatePicker（自绘模板：日历图标钮 + PART_Calendar 弹出）
             + 1px 分隔线 + 无边框时刻下拉。日历弹出层保持系统缺省样式：弹层是
             瞬时交互控件，深浅主题差异可接受，不做整套 Calendar 深模板。 -->
        <Style x:Key="FieldShell" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 无边框日期段（DatePicker 四模板件名 PART_Root/PART_TextBox/PART_Button/
             PART_Calendar 必守——DatePicker.OnApplyTemplate 按名认件、自挂日历弹出）。
             文本层：WPF DatePicker 只有 Short/Long 两档格式（无 WinForms 的
             CustomFormat），要恒定 "yyyy-MM-dd" 就在模板里盖一层格式化 TextBlock
             （PART_TextBox 藏起不接键盘——本窗时间筛选是纯点选口径，无手输）。 -->
        <Style x:Key="BareDatePicker" TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 文本层与隐藏的 PART_TextBox 同列（列 0）；日历钮独占
                                 列 1——不分列时 Button 默认 Stretch 铺满整格，Path
                                 居中渲染会叠在文字上（探针 3x 放大实测） -->
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Visibility="Hidden"
                                               Background="Transparent" BorderThickness="0"/>
                            <TextBlock Grid.Column="0" Margin="8,0,2,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Fresh.FgMid}"
                                       Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent},
                                              FallbackValue=选择日期, TargetNullValue=选择日期,
                                              StringFormat=yyyy-MM-dd}"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Cursor="Hand"
                                    Margin="0,0,7,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <!-- 日历图标（galaxy 线性风格，Stroke 跟 Fresh 键板） -->
                                            <Path Data="{StaticResource Geo.Calendar}"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  Stroke="{DynamicResource Brush.Fresh.FgMid}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Opacity="0.8"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Calendar" Grid.Column="1" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 无边框时刻段（FreshCombo 的模板削壳版：透明 Bd/无边框——外壳观感由
             FieldShell 统一给，这里只留选中项展示 + 箭头 + 弹层） -->
        <Style x:Key="FreshComboBare" TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ContentPresenter x:Name="Selected" Margin="4,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{DynamicResource Brush.Fresh.FgMid}"
                                              IsHitTestVisible="False"/>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Brush.Fresh.FgMid}"
                                  HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource Brush.Fresh.CardBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                        CornerRadius="4" Padding="2" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============ 库位格子选择面板（V0.0.100） ============
             壳=ToggleButton（FreshCombo 观感：文字+箭头，点哪都开）；面板=Popup
             （IsOpen↔IsChecked 双向 + StaysOpen=False 点外自关——主窗"设置▾"同款
             搭配，无互踢）。面板内容按 VM.LocationGroups 铺格子：一台固化架一组，
             组内 UniformGrid 行优先=先层后站，与主窗"N号固化架"卡片网格同排布。 -->
        <Style x:Key="LocShellToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"/>
                            <ContentPresenter Margin="10,0,24,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Brush.Fresh.FgMid}"
                                  HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 库位格子小按钮（Fresh 键板：InputBg 底，悬停/按下随 FreshButton 模板） -->
        <Style x:Key="LocCell" TargetType="Button" BasedOn="{StaticResource FreshButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
        </Style>
        <!-- 组标题显隐（触发器死区纪律：缺省值必须写 Setter——多架才显示"N号
             固化架"，单架只有一排格子不摆标题，与主窗组标题条同口径） -->
        <Style x:Key="LocGroupHeader" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShowGroupHeaders,
                                       RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!--
      固化追溯报表（V0.0.97 新增）：
      - 布局参考 HJVision「视觉数据报表」：筛选行 → 统计卡行 → 表格 → 底栏
        分页/导出；配色走本项目主题键板（双主题同名），不照抄硬编码色；
      - 筛选行（V0.0.100 重做）：时间=一侧一个 "yyyy-MM-dd HH:mm" 整框
        （HJVision mFormMesRecord 同口径——日期点日历、时刻下拉点选）；库位=
        按固化架分组铺格子的面板（与主窗仓位卡排布一一对应，点格子选）；
      - 两个视图页签（Radio 互斥）：产品明细（一个 SN 一行流水）/ 库位汇总
        （一个库位一行，来自 SQLite 视图 slot_trace_summary）；
      - 统计卡与表格同一次查询口径（现场两处数字必须对得上）；
      - 导出 CSV 导当前筛选下的全部记录（不分页），后台线程写文件。
    -->
    <Grid Margin="14">
        <Border CornerRadius="10" Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                Effect="{StaticResource Fx.WinShadow}">
            <DockPanel>
                <!-- 标题条 -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.LfHeadGrad}"
                        BorderBrush="{DynamicResource Brush.TopbarBorder}" BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0"
                        Height="36" Padding="12,0">
                    <!-- 标题条用 Grid 两列（左标题* / 右关闭钮Auto）：
                         不用 DockPanel——它的最后一个子元素会被 LastChildFill
                         拉伸填充剩余空间，✕（Width=44）被拉宽后内容居中，
                         关闭钮就飘到标题栏中间（现场目检发现）。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="固化追溯报表" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.LfHeadFg}" VerticalAlignment="Center"/>
                            <TextBlock Text="库位 ↔ 产品 SN ↔ 固化时长"
                                       FontSize="11" Margin="10,0,0,0"
                                       Foreground="{DynamicResource Brush.LfHeadSubFg}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource WinTitleClose}"
                                Height="36" Foreground="{DynamicResource Brush.LfHeadFg}"
                                Content="✕" Click="OnCloseClick" ToolTip="关闭报表"/>
                    </Grid>
                </Border>

                <!-- 底栏：状态摘要 + 页码 + 翻页 + 导出 -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.DimLine}"
                        BorderThickness="0,1,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusText, FallbackValue=就绪}"
                                   Foreground="{DynamicResource Brush.FgDim}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageText, FallbackValue=第 1/1 页}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource Brush.FgMid}"/>
                            <Button Style="{StaticResource FreshButton}" Command="{Binding PrevPageCommand}"
                                    Content="上一页" MinWidth="80" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource FreshButton}" Command="{Binding NextPageCommand}"
                                    Content="下一页" MinWidth="80" Margin="0,0,16,0"/>
                            <Button Style="{StaticResource FreshPrimaryButton}" Command="{Binding ExportCommand}"
                                    Content="导出 CSV" MinWidth="100"
                                    ToolTip="导出当前筛选条件下的全部记录（不分页）"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ① 筛选行（标签统一固定宽 44 右对齐——同宽标签让每组
                         "标签+控件"的起点一致，栏面不因标签字数不同而参差）。
                         时间=单框合并（HJVision 口径：一侧一个整框，日期点日历、
                         时刻下拉点选）；库位=格子面板（按固化架分组铺格子，与
                         主窗仓位卡排布一一对应）——全部免键盘输入，防手输格式错 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="起始" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource Brush.FgMid}"/>
                        <Border Grid.Column="1" Style="{StaticResource FieldShell}" Width="150"
                                ToolTip="按绑定时刻筛选的起始时间（点日历选日期、下拉选时刻）；留空=不限">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Style="{StaticResource BareDatePicker}"
                                            SelectedDate="{Binding FromDate}"/>
                                <Border Grid.Column="1" Width="1" Margin="0,5"
                                        Background="{DynamicResource Brush.Fresh.Border}"/>
                                <ComboBox Grid.Column="2" Style="{StaticResource FreshComboBare}"
                                          ItemsSource="{Binding TimeOptions, FallbackValue={x:Null}}"
                                          SelectedItem="{Binding FromTime}"
                                          ToolTip="起始时刻（点选；缺省 00:00）"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="2" Text="结束" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="16,0,6,0"
                                   Foreground="{DynamicResource Brush.FgMid}"/>
                        <Border Grid.Column="3" Style="{StaticResource FieldShell}" Width="150"
                                ToolTip="按绑定时刻筛选的结束时间（点日历选日期、下拉选时刻）；留空=不限">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="62"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Style="{StaticResource BareDatePicker}"
                                            SelectedDate="{Binding ToDate}"/>
                                <Border Grid.Column="1" Width="1" Margin="0,5"
                                        Background="{DynamicResource Brush.Fresh.Border}"/>
                                <ComboBox Grid.Column="2" Style="{StaticResource FreshComboBare}"
                                          ItemsSource="{Binding TimeOptions, FallbackValue={x:Null}}"
                                          SelectedItem="{Binding ToTime}"
                                          ToolTip="结束时刻（点选；缺省 23:59=当天收尾）"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="4" Text="库位" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="16,0,6,0"
                                   Foreground="{DynamicResource Brush.FgMid}"/>
                        <Grid Grid.Column="5">
                            <ToggleButton x:Name="LocToggle" Style="{StaticResource LocShellToggle}"
                                          Width="110"
                                          ToolTip="库位码：点开按固化架铺格子的面板，点格子选择（与主页排布一致）；全部=不限。&#x0a;同一编码每台固化架各有一套，按编码查出所有架的同名库位">
                                <TextBlock Text="{Binding LocationText, FallbackValue=全部}"
                                           Foreground="{DynamicResource Brush.Fresh.FgMid}"/>
                            </ToggleButton>
                            <Popup x:Name="LocPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=LocToggle}"
                                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsChecked, ElementName=LocToggle, Mode=TwoWay}">
                                <Border Background="{DynamicResource Brush.Fresh.CardBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                        CornerRadius="4" Padding="8" Margin="0,2,0,0"
                                        MinWidth="150" MaxWidth="480" MaxHeight="360">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- 全部行：清掉库位筛选（=不限） -->
                                            <Button Style="{StaticResource FreshButton}" Content="全部（不限库位）"
                                                    HorizontalAlignment="Stretch"
                                                    Command="{Binding SelectLocationCommand}"
                                                    CommandParameter="全部"
                                                    Click="OnLocationPicked"/>
                                            <ItemsControl ItemsSource="{Binding LocationGroups, FallbackValue={x:Null}}"
                                                          Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Title, FallbackValue=固化架}"
                                                                       Style="{StaticResource LocGroupHeader}"
                                                                       FontSize="11" Margin="2,0,0,4"
                                                                       Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                                                            <!-- 格子铺列：UniformGrid 必须做 ItemsControl 的
                                                                 ItemsPanel（套在外面只会"1 个 child"——内层
                                                                 还是纵向 StackPanel，铺不出 10×3）；列数绑
                                                                 组的 Columns（面板模板里 item 的 DataContext
                                                                 是单个码，须 RelativeSource 找回组对象） -->
                                                            <ItemsControl ItemsSource="{Binding Codes, FallbackValue={x:Null}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="{Binding DataContext.Columns,
                                                                                                RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                                                FallbackValue=10}"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource LocCell}"
                                                                                Content="{Binding}"
                                                                                Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Click="OnLocationPicked"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock Text="SN" Width="44" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource Brush.FgMid}"/>
                            <TextBox Style="{StaticResource FreshInput}" Width="140"
                                     Text="{Binding SnText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="产品 SN 关键字（包含匹配）；留空=不限"/>
                            <TextBlock Text="结果" Width="44" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="16,0,6,0"
                                       Foreground="{DynamicResource Brush.FgMid}"/>
                            <ComboBox Style="{StaticResource FreshCombo}" Width="96"
                                      ItemsSource="{Binding ReasonOptions, FallbackValue={x:Null}}"
                                      SelectedItem="{Binding ReasonText}"
                                      ToolTip="按结束原因筛选；全部=不限"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FreshPrimaryButton}" Command="{Binding QueryCommand}"
                                    Content="查询" MinWidth="88" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource FreshButton}" Command="{Binding ResetCommand}"
                                    Content="重置" MinWidth="72"/>
                        </StackPanel>
                    </Grid>

                    <!-- ② 统计卡行（5 张：总数/正常/异常/在架/库位数） -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,10,0,10">
                        <Border Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="记录总数" FontSize="11"
                                           Foreground="{DynamicResource Brush.StatFg}"/>
                                <TextBlock Text="{Binding TotalText, FallbackValue=0}" FontSize="22"
                                           FontWeight="Bold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.StatNumFg}"/>
                                <TextBlock Text="件产品记录" FontSize="10"
                                           Foreground="{DynamicResource Brush.FgDim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="正常放行" FontSize="11"
                                           Foreground="{DynamicResource Brush.StatFg}"/>
                                <TextBlock Text="{Binding FinishedText, FallbackValue=0}" FontSize="22"
                                           FontWeight="Bold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.StateGreen}"/>
                                <TextBlock Text="固化到点取走" FontSize="10"
                                           Foreground="{DynamicResource Brush.FgDim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="异常终止" FontSize="11"
                                           Foreground="{DynamicResource Brush.StatFg}"/>
                                <TextBlock Text="{Binding AbnormalText, FallbackValue=0}" FontSize="22"
                                           FontWeight="Bold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.StateRed}"/>
                                <TextBlock Text="取出/终止/误报" FontSize="10"
                                           Foreground="{DynamicResource Brush.FgDim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="仍在架" FontSize="11"
                                           Foreground="{DynamicResource Brush.StatFg}"/>
                                <TextBlock Text="{Binding ActiveText, FallbackValue=0}" FontSize="22"
                                           FontWeight="Bold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.StateYellow}"/>
                                <TextBlock Text="未离架" FontSize="10"
                                           Foreground="{DynamicResource Brush.FgDim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FreshCardBorder}" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="涉及库位" FontSize="11"
                                           Foreground="{DynamicResource Brush.StatFg}"/>
                                <TextBlock Text="{Binding SlotCountText, FallbackValue=0}" FontSize="22"
                                           FontWeight="Bold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.StatNumFg}"/>
                                <TextBlock Text="个库位" FontSize="10"
                                           Foreground="{DynamicResource Brush.FgDim}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ③ 视图页签（Radio 互斥：产品明细 / 库位汇总）
                         ★命令链而非 IsChecked 双向绑定：Radio 未勾选时 IsChecked=null，
                         双向绑 bool 属性会把 null 写回 false，开窗瞬间视图被误切走
                         （WPF Radio 互踢坑的变体）。Command 切视图，勾选态由
                         GroupName 互斥自动管。 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton GroupName="TraceView" Content="产品明细" IsChecked="True"
                                     Command="{Binding ShowDetailCommand}"
                                     Style="{StaticResource FreshRadio}" Margin="0,0,16,0"
                                     ToolTip="一个产品 SN 一行：绑定/开计时/离架/实际固化时长/结束原因"/>
                        <RadioButton GroupName="TraceView" Content="库位汇总" Margin="0,0,0,0"
                                     Style="{StaticResource FreshRadio}"
                                     Command="{Binding ShowSummaryCommand}"
                                     ToolTip="一个库位一行：累计件数/正常/异常/在架/累计固化时长"/>
                    </StackPanel>

                    <!-- ④ 表格区（两表互斥；圆角边框板 = PanelBg + PanelBorder） -->
                    <Border Grid.Row="3" CornerRadius="8" Background="{DynamicResource Brush.CardBg}"
                            BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1">
                        <Grid>
                            <!-- 产品明细（流水表） -->
                            <DataGrid ItemsSource="{Binding Rows, FallbackValue={x:Null}}"
                                      ColumnHeaderHeight="30" RowHeight="26"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="True" HeadersVisibility="Column"
                                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="Transparent">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowDetail}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="绑定时刻" Binding="{Binding BoundAt}" Width="140"/>
                                    <DataGridTextColumn Header="库位" Binding="{Binding LocationCode}" Width="60"/>
                                    <DataGridTextColumn Header="产品 SN" Binding="{Binding ProductSn}" Width="180"/>
                                    <DataGridTextColumn Header="开计时" Binding="{Binding CuringStartedAt}" Width="140"/>
                                    <DataGridTextColumn Header="计划(分)" Binding="{Binding PlannedMinutes}" Width="70"/>
                                    <DataGridTextColumn Header="离架时刻" Binding="{Binding LeftAt}" Width="140"/>
                                    <DataGridTextColumn Header="实际固化(分)" Binding="{Binding CuredMinutes}" Width="90"/>
                                    <DataGridTemplateColumn Header="结束原因" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EndReason, Converter={StaticResource ReasonText}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 报警列用文字（是/空）而非复选框：复选框在窄表格里
                                         是个小方块，行内读不出"是否报警"，且勾框会挤
                                         掉末列宽度。 -->
                                    <DataGridTemplateColumn Header="报警" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AlarmFlag, Converter={StaticResource BoolMark}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="备注" Binding="{Binding OperatorNote}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 库位汇总（视图） -->
                            <DataGrid ItemsSource="{Binding SummaryRows, FallbackValue={x:Null}}"
                                      ColumnHeaderHeight="30" RowHeight="26"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="True" HeadersVisibility="Column"
                                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="Transparent">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowDetail}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="库位" Binding="{Binding LocationCode}" Width="90"/>
                                    <DataGridTextColumn Header="架" Binding="{Binding Rack}" Width="60"/>
                                    <DataGridTextColumn Header="层" Binding="{Binding Level}" Width="60"/>
                                    <DataGridTextColumn Header="产品数" Binding="{Binding ProductCount}" Width="80"/>
                                    <DataGridTextColumn Header="正常" Binding="{Binding FinishedCount}" Width="70"/>
                                    <DataGridTextColumn Header="异常" Binding="{Binding AbnormalCount}" Width="70"/>
                                    <DataGridTextColumn Header="在架" Binding="{Binding ActiveCount}" Width="70"/>
                                    <DataGridTextColumn Header="首次绑定" Binding="{Binding FirstBoundAt}" Width="150"/>
                                    <DataGridTextColumn Header="最近离架" Binding="{Binding LastLeftAt}" Width="150"/>
                                    <DataGridTextColumn Header="累计固化(分)" Binding="{Binding CuredMinutes}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="CureStation.WorkOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WorkOrderViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle, FallbackValue=工单信息}" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource Brush.Fresh.FgMid}"
        Icon="Assets/app.ico" FontSize="12">
    <Window.Resources>
        <!-- 面板/按钮显隐（与 IoTestWindow 同款窗内转换器） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（V0.0.27 弹窗统一）：标题条命中拖动 + 边沿 6px 缩放（系统缩放能力保留） -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <!--★★ 工单信息窗（对照参考 HMI"工单信息"页）：左列单/双工位工单 + 基础信息
         + 批次物料；右列制程代码 + 保存。工位布局由 [CuringMes] DualSide 决定
         （缺省单工位：只显一套面板、标题与按钮不带 R/L 字样；勾开=老 R/L 双
         面板口径）。门禁：途程/数量/清零 L2+（禁用态），制程代码 L3+，
         员工工号/条码 L1+。物料上传（API0032）：使能勾选 + 上传按钮（先保存
         工单再后台提交，结果看主窗顶栏过账状态）。取色全走 Brush.Fresh.*；
         窗口骨架统一自绘标题条（WinTitleBar 三样式）。-->
    <!-- 圆角弹窗骨架（全弹窗统一）：透明窗 + 外层圆角 Border（10px）+ Fx.WinShadow 浮层投影，
         根 Grid Margin=14 给阴影渲染留白 -->
    <Grid Margin="14">
    <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
            Effect="{StaticResource Fx.WinShadow}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                <Grid>
                    <TextBlock Style="{StaticResource WinTitleText}"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=工单信息}"/>
                    <Button Style="{StaticResource WinTitleClose}" Content="✕" HorizontalAlignment="Right"
                            Click="OnCloseClick" ToolTip="关闭"/>
                </Grid>
            </Border>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 顶：门禁说明 -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Style="{StaticResource FreshHintBorder}" Margin="0,0,0,8" Padding="8,4">
                    <TextBlock Text="{Binding GateText, FallbackValue=未登录——只读查看}"
                               Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                </Border>

                <!-- 左列：R/L 工位 + 基础信息 + 批次物料 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- R 侧工单（视图↔槽恒定映射：此组编辑属性永远对应 Right 槽） -->
                            <StackPanel Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding RightPanelTitle, FallbackValue=工单信息}"/>
                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <TextBlock Text="途程单号(RC_NO)：" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditRtRcNo}" IsEnabled="{Binding CanEditRoute}"/>
                                    <TextBlock Text="预设数量：" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditRtPreset, FallbackValue=0}" IsEnabled="{Binding CanEditRoute}" Margin="0,6,0,0"/>
                                    <TextBlock Text="已生产数量：" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditRtProduced, FallbackValue=0}" IsEnabled="{Binding CanEditRoute}" Margin="0,6,0,0"
                                             Background="{DynamicResource Brush.Fresh.LockedBg}"/>
                                </UniformGrid>
                                <Button Style="{StaticResource FreshButton}" Content="{Binding ClearRText, FallbackValue=计数清零}"
                                        Command="{Binding ClearCountRtCommand}" IsEnabled="{Binding CanEditRoute}"
                                        HorizontalAlignment="Right" Margin="0,6,0,0" Width="120" Height="28"/>
                            </StackPanel>

                            <!-- L 侧工单：双工位恒显；单工位 Side=L 时成为主面板（文案不带 L） -->
                            <StackPanel Visibility="{Binding ShowLeftPanel, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding LeftPanelTitle, FallbackValue=工单信息}" Margin="0,12,0,0"/>
                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <TextBlock Text="途程单号(RC_NO)：" VerticalAlignment="Center"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditLfRcNo}" IsEnabled="{Binding CanEditRoute}"/>
                                    <TextBlock Text="预设数量：" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditLfPreset, FallbackValue=0}" IsEnabled="{Binding CanEditRoute}" Margin="0,6,0,0"/>
                                    <TextBlock Text="已生产数量：" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditLfProduced, FallbackValue=0}" IsEnabled="{Binding CanEditRoute}" Margin="0,6,0,0"
                                             Background="{DynamicResource Brush.Fresh.LockedBg}"/>
                                </UniformGrid>
                                <Button Style="{StaticResource FreshButton}" Content="{Binding ClearLText, FallbackValue=计数清零}"
                                        Command="{Binding ClearCountLfCommand}" IsEnabled="{Binding CanEditRoute}"
                                        HorizontalAlignment="Right" Margin="0,6,0,0" Width="120" Height="28"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="基础信息" Margin="0,12,0,0"/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <TextBlock Text="员工工号(EMP_NO)：" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditEmpNo}"/>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="批次物料上报" Margin="0,12,0,0"/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <TextBlock Text="物料条码(BC_NO)：" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditBcNo}"/>
                            </UniformGrid>
                            <CheckBox IsChecked="{Binding EditUploadEnabled, FallbackValue=False}"
                                      IsEnabled="{Binding CanEditProcess}"
                                      Content="物料上传使能（勾选后可点下方上传按钮）" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <!-- 单工位=只显 Side 侧一枚（文案"物料上传"）；双工位=R/L 两枚（原口径） -->
                                <Button Style="{StaticResource FreshButton}" Content="{Binding UploadRText, FallbackValue=物料上传}"
                                        Command="{Binding UploadRMaterialCommand}" Width="110" Height="28"
                                        IsEnabled="{Binding CanUpload}"
                                        Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"/>
                                <Button Style="{StaticResource FreshButton}" Content="{Binding UploadLText, FallbackValue=物料上传}"
                                        Command="{Binding UploadLMaterialCommand}" Width="110" Height="28"
                                        IsEnabled="{Binding CanUpload}"
                                        Visibility="{Binding ShowLeftPanel, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding UploadStatusText}"
                                       Foreground="{DynamicResource Brush.Fresh.FgStrong}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 右列：制程代码 -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FreshCardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="制程代码输入"/>
                        <TextBlock Text="制程代码-1(PT_NO)：" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditPtNo1}" IsEnabled="{Binding CanEditProcess}"/>
                        <TextBlock Text="制程代码-2(PT_NO)：" Margin="0,12,0,2"/>
                        <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditPtNo2}" IsEnabled="{Binding CanEditProcess}"/>
                        <TextBlock Text="制程代码需 LEVEL.3（工程师）及以上可改。"
                                   Foreground="{DynamicResource Brush.Fresh.FgDim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底：保存 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Tag="{StaticResource Geo.Save}" Style="{StaticResource FreshButton}" Content="保存工单"
                            Command="{Binding SaveCommand}" Width="160" Height="34"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>

<Window x:Class="CureStation.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureStation.ViewModels"
        xmlns:local="clr-namespace:CureStation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OperatorViewModel, IsDesignTimeCreatable=False}"
        Title="权限管理（四级操作员）" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/app.ico" FontSize="12">
    <Window.Resources>
        <local:OperatorLevelNameConverter x:Key="LevelNameConverter"/>
    </Window.Resources>
    <!--★★ 权限管理窗（对照参考 HMI"权限管理"页）：账号列表（四级混排）+
         编辑面板（新增/改级/改密/删除）。仅 LEVEL.4 可开（主窗门禁）。
         防锁死：最后一个 LEVEL.4 删/降一律拒绝（Store 层红线）。-->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- 左：账号列表 -->
        <Border Grid.Column="0" Style="{StaticResource FreshCardBorder}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="操作员账号（LEVEL.1 操作员 / L2 班长 / L3 工程师 / L4 管理员）"/>
                <DataGrid ItemsSource="{Binding Users, FallbackValue={x:Null}}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="*"/>
                        <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 右：编辑面板 -->
        <Border Grid.Column="1" Style="{StaticResource FreshCardBorder}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="账号操作"/>

                <TextBlock Text="用户名：" Margin="0,8,0,2"/>
                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditUserName, FallbackValue=admin}"/>

                <TextBlock Text="级别：" Margin="0,8,0,2"/>
                <ComboBox Style="{StaticResource FreshCombo}" ItemsSource="{Binding AllLevels, FallbackValue={x:Null}}"
                          SelectedItem="{Binding EditLevel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LevelNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="密码（新增/改密用；改级别时忽略）：" Margin="0,8,0,2"/>
                <TextBox Style="{StaticResource FreshInput}" Text="{Binding EditPassword}" FontFamily="Consolas"/>

                <!-- 语义色按钮（V0.0.20 参考用户管理页编排）：蓝=新增（主操作）、
                     浅蓝=改级别、绿=重置密码、红=删除（危险操作） -->
                <Button Style="{StaticResource FreshPrimaryButton}" Content="＋ 新增账号"
                        Command="{Binding AddUserCommand}" Margin="0,12,0,0" Height="32"
                        ToolTip="按编辑区的用户名/级别/密码新增账号"/>
                <Button Style="{StaticResource FreshButton}" Content="改级别（按编辑区）"
                        Command="{Binding SetLevelCommand}" Margin="0,8,0,0" Height="32"
                        ToolTip="把编辑区的级别应用到选中账号"/>
                <Button Style="{StaticResource FreshSuccessButton}" Content="重置密码（按编辑区）"
                        Command="{Binding SetPasswordCommand}" Margin="0,8,0,0" Height="32"
                        ToolTip="把选中账号密码重置为编辑区密码（≥6 位）"/>
                <Button Style="{StaticResource FreshDangerButton}" Content="－ 删除选中账号"
                        Command="{Binding RemoveUserCommand}" Margin="0,8,0,0" Height="32"
                        ToolTip="删除选中账号（最后一个 LEVEL.4 会被拒绝——防锁死红线）"/>

                <TextBlock Text="红线：最后一个 LEVEL.4 账号不可删除或降级（防锁死）。密码 ≥6 位，存 PBKDF2 哈希。"
                           Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

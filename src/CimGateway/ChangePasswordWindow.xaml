<Window x:Class="CimGateway.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CimGateway.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ChangePasswordViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='修改密码'}" Width="360" Height="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--修改密码窗（MVVM：状态走 ChangePasswordViewModel，本文件纯绑定）。
        密码框经 PasswordChanged 事件转交 VM（Password 不可绑定）；
        旧密码行按 NeedOldPassword 显隐（dev 代改他人时隐藏）。
        设计时 DataContext 为空，展示文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <StackPanel Margin="20,14">
        <Label Content="{Binding HeadText, FallbackValue='修改密码'}"
               FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,4" VerticalAlignment="Center">
            <Label Content="{Binding UserLabel, FallbackValue='账号'}" Width="80" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                      IsEnabled="{Binding CanPickUser}"
                      Width="210" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center"
                    Visibility="{Binding NeedOldPassword,
                        Converter={StaticResource BoolToVisibilityConverter}}">
            <Label Content="{Binding OldLabel, FallbackValue='旧密码'}" Width="80" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtOld" Width="210" VerticalAlignment="Center"
                         PasswordChanged="PwdBox_Changed"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
            <Label Content="{Binding NewLabel, FallbackValue='新密码'}" Width="80" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtNew" Width="210" VerticalAlignment="Center"
                         PasswordChanged="PwdBox_Changed"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
            <Label Content="{Binding ConfirmLabel, FallbackValue='确认新密码'}" Width="80" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtConfirm" Width="210" VerticalAlignment="Center"
                         PasswordChanged="PwdBox_Changed"/>
        </StackPanel>
        <Label Content="{Binding Tip}" Foreground="Red" Height="26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button Content="{Binding OkText, FallbackValue='确定'}" Width="100" Height="36"
                    Margin="4" Command="{Binding OkCommand}" IsDefault="True"/>
            <Button Content="{Binding CancelText, FallbackValue='取消'}" Width="100" Height="36"
                    Margin="4" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
    </StackPanel>
</Window>

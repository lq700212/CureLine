<Window x:Class="CimGateway.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CimGateway.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ChangePasswordViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='修改密码'}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" FontSize="13"
        Foreground="{DynamicResource Brush.Fresh.FgMid}">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（弹窗统一骨架，对齐程序①口径） -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <!--修改密码窗（MVVM：状态走 ChangePasswordViewModel，本文件纯绑定）。
        密码框经 PasswordChanged 事件转交 VM（Password 不可绑定）；
        旧密码行按 NeedOldPassword 显隐（dev 代改他人时隐藏）。
        取色全走 Brush.Fresh.*；账号下拉用 FreshCombo（可编辑框 Margin 8 与
        密码框 FreshPwdInput 左 3 的文本左缘同线，程序①实测口径）。
        设计时 DataContext 为空，展示文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <Grid Margin="14">
        <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
                BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                Effect="{StaticResource Fx.WinShadow}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                    <Grid>
                        <TextBlock Style="{StaticResource WinTitleText}"
                                   Text="{Binding TitleText, FallbackValue=修改密码}"/>
                        <Button Style="{StaticResource WinTitleClose}" Content="✕"
                                HorizontalAlignment="Right"
                                Click="OnCloseClick" ToolTip="关闭（Esc）"/>
                    </Grid>
                </Border>

                <StackPanel Margin="36,18,36,18">
                    <TextBlock Text="{Binding HeadText, FallbackValue='修改密码'}" FontSize="20"
                               FontWeight="Bold" Foreground="{DynamicResource Brush.Fresh.FgStrong}"
                               HorizontalAlignment="Center"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding UserLabel, FallbackValue='账号'}"
                                   VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FreshCombo}"
                                  ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  IsEnabled="{Binding CanPickUser}" Margin="0,0,0,10"/>
                        <!-- 旧密码行：NeedOldPassword 显隐（dev 代改他人时隐藏）；
                             双面板同格显隐红线：缺省只留一个 Visible、其余 Collapsed -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding OldLabel, FallbackValue='旧密码'}"
                                   VerticalAlignment="Center" Margin="0,0,12,10"
                                   Visibility="{Binding NeedOldPassword,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <PasswordBox x:Name="TxtOld" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource FreshPwdInput}" Margin="0,0,0,10"
                                     PasswordChanged="PwdBox_Changed"
                                     Visibility="{Binding NeedOldPassword,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding NewLabel, FallbackValue='新密码'}"
                                   VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <PasswordBox x:Name="TxtNew" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource FreshPwdInput}" Margin="0,0,0,10"
                                     PasswordChanged="PwdBox_Changed"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ConfirmLabel, FallbackValue='确认新密码'}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <PasswordBox x:Name="TxtConfirm" Grid.Row="3" Grid.Column="1"
                                     Style="{StaticResource FreshPwdInput}"
                                     PasswordChanged="PwdBox_Changed"/>
                    </Grid>
                    <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Brush.Fresh.AlertErrFg}"
                               Margin="0,12,0,0"/>
                    <!-- 按钮行：取消（次级，左）+ 确定（实色蓝主按钮，右） -->
                    <Grid Margin="0,18,0,0">
                        <Button Style="{StaticResource FreshButton}"
                                Content="{Binding CancelText, FallbackValue='取消'}" Width="96" Height="32"
                                Command="{Binding CancelCommand}" IsCancel="True"
                                HorizontalAlignment="Left"/>
                        <Button Style="{StaticResource FreshPrimaryButton}"
                                Content="{Binding OkText, FallbackValue='确定'}" Width="128" Height="32"
                                Command="{Binding OkCommand}" IsDefault="True"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="CimGateway.MesDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CimGateway.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MesDebugViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='MES 接口调试界面'}" Width="834" Height="560"
        WindowStartupLocation="CenterScreen">
    <!--调试窗（MVVM：表单行走 MesDebugViewModel，本文件纯绑定）。
        字段行按接口显隐（Visible→Visibility）；值一改预览即刷新。
        设计时 DataContext 为空，展示文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Label Content="{Binding ApiLabel, FallbackValue='接口类型:'}" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Apis}" SelectedItem="{Binding SelectedApi}"
                      Width="140" Height="28"/>
            <Button Content="{Binding SaveText, FallbackValue='保存参数到本地'}" Width="130" Height="30"
                    Margin="12,0,0,0" Command="{Binding SaveCommand}"/>
            <Button Content="{Binding UploadText, FallbackValue='手动上传到MES'}" Width="130" Height="30"
                    Margin="8,0,0,0" Background="#1E88E5" Foreground="White"
                    Command="{Binding UploadCommand}"
                    IsEnabled="{Binding UploadEnabled}"/>
            <Button Content="{Binding LangText, FallbackValue='English'}" Width="70" Height="30"
                    Margin="8,0,0,0" Command="{Binding SwitchLanguageCommand}"/>
        </StackPanel>
        <Label Content="{Binding RespLabel, FallbackValue='MES 返回信息:'}" DockPanel.Dock="Bottom"/>
        <TextBox Text="{Binding Response, Mode=OneWay}" DockPanel.Dock="Bottom" Height="110"
                 IsReadOnly="True" Background="#F0F0F0" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,6"/>
        <Label Content="{Binding PreviewLabel, FallbackValue='发送报文预览:'}" DockPanel.Dock="Bottom"/>
        <TextBox Text="{Binding Preview, Mode=OneWay}" DockPanel.Dock="Bottom" Height="52"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,6"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="240" Height="52" Margin="5"
                                    Visibility="{Binding Visible,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <Label Content="{Binding Caption}" Foreground="DarkBlue"
                                   Padding="0"/>
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

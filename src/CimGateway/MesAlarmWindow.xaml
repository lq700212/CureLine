<Window x:Class="CimGateway.MesAlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CimGateway.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MesAlarmViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='MES 报警信息'}" Width="800" Height="450" Topmost="True"
        WindowStartupLocation="CenterScreen" MinWidth="480" MinHeight="280"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" FontSize="13"
        Foreground="{DynamicResource Brush.Fresh.FgMid}">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（弹窗统一骨架）：本窗可缩放——ResizeBorderThickness=6；
             Topmost 置顶语义保留（报警窗老项目口径） -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>
    <!--报警窗（MVVM：展示走 MesAlarmViewModel，本文件纯绑定）。
        V0.0.51 观感对齐设计稿：红左缘条 + 图标方块 + 红标题/机台时间副文 +
        报文等宽代码块（Fresh.CodeBg/CodeFg）+ 底部关闭钮。
        取色全走 Brush.Fresh.*（两主题字典同名异值，切字典即换肤）。
        设计时 DataContext 为空，展示文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <Grid Margin="14">
        <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
                BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                Effect="{StaticResource Fx.WinShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 红左缘条（设计稿 .alarm 左缘 4px，Danger 两主题异值） -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Fresh.Danger}"/>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 标题条：图标方块 + 红标题/机台时间副文 + 关闭钮
                         （本窗标题条两行文案，Height 覆盖 48——WinTitleBar 缺省 34 装不下） -->
                    <Border Grid.Row="0" Style="{StaticResource WinTitleBar}" Height="48">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Fresh.AlertErrBg}">
                                    <TextBlock Text="!" FontSize="16" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Fresh.AlertErrFg}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TitleText, FallbackValue='MES 报警信息'}"
                                               FontSize="13.5" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Fresh.AlertErrFg}"/>
                                    <TextBlock FontSize="10.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource Brush.Fresh.FgDim}">
                                        <Run Text="{Binding MachineName, Mode=OneWay, FallbackValue='机台名称'}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding AlarmTime, Mode=OneWay, FallbackValue='2026-11-02 10:24:02'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource WinTitleClose}" Content="✕"
                                    HorizontalAlignment="Right"
                                    Click="OnCloseClick" ToolTip="关闭"/>
                        </Grid>
                    </Border>
                    <!-- 报文代码块（等宽只读，深底两主题异值） -->
                    <TextBox Grid.Row="1" Text="{Binding Message, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" Margin="16,12,16,0" FontFamily="Consolas" FontSize="11.5"
                             Background="{DynamicResource Brush.Fresh.CodeBg}"
                             Foreground="{DynamicResource Brush.Fresh.CodeFg}"
                             BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}" BorderThickness="1"
                             Padding="12,10" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" VerticalAlignment="Stretch"/>
                    <Button Content="{Binding CloseText, FallbackValue='关闭'}" Width="110" Height="32"
                            Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,16,14"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource FreshPrimaryButton}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

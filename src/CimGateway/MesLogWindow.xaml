<Window x:Class="CimGateway.MesLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CimGateway.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MesLogViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='MES 交互实时日志'}" Width="784" Height="561" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <!--日志窗（MVVM：行集合走 MesLogViewModel，本文件纯绑定）。
        滚动到底部是纯视图行为，View 订阅集合变化调 ScrollIntoView。
        设计时 DataContext 为空，按钮文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{Binding ClearText, FallbackValue='清空当前显示'}" Width="120" Height="30"
                    Margin="0,0,8,0" Command="{Binding ClearCommand}"/>
            <Button Content="{Binding LangText, FallbackValue='English'}" Width="80" Height="30"
                    Command="{Binding SwitchLanguageCommand}"/>
        </StackPanel>
        <ListBox x:Name="BoxLogs" FontSize="12" ItemsSource="{Binding Lines}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DockPanel>
</Window>

<Window x:Class="CimGateway.GatewayConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CimGateway.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GatewayConfigViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='网关配置'}" Width="660" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" FontSize="13"
        Foreground="{DynamicResource Brush.Fresh.FgMid}">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（弹窗统一骨架，对齐程序①口径） -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <!--网关配置窗（MVVM：两页走 GatewayConfigViewModel，本文件纯绑定）。
        单机页与协议下拉已随三菱链路删除（P2.1：真机统一 Modbus TCP）。
        行内测试按钮经 RelativeSource 找父 VM 命令（DataTemplate 内 DataContext
        是行 VM，命令在父 VM，这是标准写法）。测试结果字色走语义名触发器
        （"Ok"/"Err"→主题 AlertOkFg/AlertErrFg，深浅主题跟随）。
        取色全走 Brush.Fresh.*；TabControl/TabItem 隐式主题样式在 App.xaml。
        设计时 DataContext 为空，展示文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <Grid Margin="14">
        <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
                BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                Effect="{StaticResource Fx.WinShadow}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                    <Grid>
                        <TextBlock Style="{StaticResource WinTitleText}"
                                   Text="{Binding TitleText, FallbackValue=网关配置}"/>
                        <Button Style="{StaticResource WinTitleClose}" Content="✕"
                                HorizontalAlignment="Right"
                                Click="OnCloseClick" ToolTip="关闭（Esc）"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            DockPanel.Dock="Bottom" Margin="0,12,0,16">
                    <Button Content="{Binding SaveText, FallbackValue='保存并生效'}" Width="120" Height="32"
                            Margin="0,0,8,0" Command="{Binding SaveCommand}" IsDefault="True"
                            Style="{StaticResource FreshPrimaryButton}"/>
                    <Button Content="{Binding CancelText, FallbackValue='取消'}" Width="100" Height="32"
                            Command="{Binding CancelCommand}" IsCancel="True"
                            Style="{StaticResource FreshButton}"/>
                </StackPanel>

                <DockPanel Margin="20,12,20,0">
                    <Border Style="{StaticResource FreshHintBorder}" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding HintText, FallbackValue='测试用表单值直测，保存后立即生效（自动重连，无需重启）'}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                    </Border>
                    <TabControl>
                        <!--多机页-->
                        <TabItem Header="{Binding TabMultiText, FallbackValue='机台连接'}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4">
                                    <ItemsControl ItemsSource="{Binding Stations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <CheckBox Content="{Binding TitleText}"
                                                              IsChecked="{Binding Enabled}" Width="70"
                                                              VerticalContentAlignment="Center"/>
                                                    <!-- 机台名（V0.0.32 配置化）：面板/日志文件名/视图下拉同源，
                                                         保存即生效；缺省已回填当前生效名 -->
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FreshInput}"
                                                             Width="170" Margin="0,0,4,0"
                                                             ToolTip="机台名（面板标题/日志文件名/视图下拉共用，保存即生效）"/>
                                                    <TextBox Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FreshInput}"
                                                             Width="120" Margin="4,0,0,0"/>
                                                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FreshInput}"
                                                             Width="60" Margin="4,0,0,0"/>
                                                    <Button Content="{Binding DataContext.TestText, FallbackValue='测试连接',
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource FreshButton}"
                                                            Height="32" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.TestStationCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}"/>
                                                    <!-- 测试结果字色：语义名→主题键映射（缺省中性字色） -->
                                                    <Label Content="{Binding ResultText}" Width="120"
                                                           VerticalContentAlignment="Center"
                                                           ToolTip="{Binding ResultTip}">
                                                        <Label.Style>
                                                            <Style TargetType="Label">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ResultForeground, FallbackValue=—}" Value="Ok">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.AlertOkFg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ResultForeground, FallbackValue=—}" Value="Err">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.AlertErrFg}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Label.Style>
                                                    </Label>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                        <Label Content="{Binding ScanIntervalLabel, FallbackValue='扫描周期ms'}"
                                               VerticalContentAlignment="Center"
                                               ToolTip="每台机台触发字轮询间隔（50~5000，缺省 200）；保存即热生效，无需重连"/>
                                        <TextBox Text="{Binding ScanIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FreshInput}"
                                                 Width="60" Margin="4,0,16,0"/>
                                        <Button Content="{Binding TestAllText, FallbackValue='全部测试'}" Height="32"
                                                Command="{Binding TestAllStationsCommand}"
                                                Style="{StaticResource FreshButton}"/>
                                        <Button Content="{Binding RestoreText, FallbackValue='恢复缺省'}" Height="32"
                                                Margin="8,0,0,0" Command="{Binding RestoreStationsCommand}"
                                                Style="{StaticResource FreshButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <!--接口地址页-->
                        <TabItem Header="{Binding TabApiText, FallbackValue='接口地址'}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Label Content="{Binding DataLengthLabel, FallbackValue='数据长度'}" Width="110"
                                               VerticalContentAlignment="Center"/>
                                        <TextBox Text="{Binding DataLengthText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FreshInput}" Width="80"/>
                                        <Label Content="{Binding DataSegmentOffsetsLabel, FallbackValue='分段偏移'}" Width="110"
                                               Margin="16,0,0,0" VerticalContentAlignment="Center"
                                               ToolTip="API0030/0031 返回 DATA 三段拆写偏移，逗号分隔两段（缺省 30,60）"/>
                                        <TextBox Text="{Binding DataSegmentOffsetsText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FreshInput}" Width="80"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ApiSections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ApiCode}" FontWeight="Bold" Margin="0,10,0,2"
                                                               Style="{StaticResource SectionTitle}"
                                                               Foreground="{DynamicResource Brush.Fresh.Accent}"/>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                                    <Label Content="{Binding Caption}" Width="110"
                                                                           VerticalContentAlignment="Center"/>
                                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource FreshInput}"
                                                                             Width="{Binding BoxWidth}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

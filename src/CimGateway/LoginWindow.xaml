<Window x:Class="CimGateway.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CimGateway.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='登录'}" Width="340" Height="290"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--登录窗（MVVM：状态走 LoginViewModel，本文件纯绑定）。
        两档账号：admin（普通管理），dev（最高权限，设置下全选项）；
        记住密码跟随账号。PasswordBox 密码经 PasswordChanged 事件转交 VM
        （Password 非依赖属性不可绑定，见 LoginViewModel 注释）。
        设计时 DataContext 为空，展示文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <StackPanel Margin="20,14">
        <Label Content="{Binding HeadText, FallbackValue='请登录'}"
               FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,4" VerticalAlignment="Center">
            <Label Content="{Binding UserLabel, FallbackValue='用户名'}" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUser"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Width="210" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
            <Label Content="{Binding PwdLabel, FallbackValue='密码'}" Width="70" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtPwd" Width="210" VerticalAlignment="Center"
                         PasswordChanged="TxtPwd_Changed"/>
        </StackPanel>
        <CheckBox IsChecked="{Binding Remember}" Content="{Binding RememberText, FallbackValue='记住密码'}"
                  Margin="70,6,0,0"
                  VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <Label Content="{Binding Tip}" Foreground="Red" Height="26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button Content="{Binding OkText, FallbackValue='确定'}" Width="100" Height="36"
                    Margin="4" Command="{Binding OkCommand}" IsDefault="True"/>
            <Button Content="{Binding CancelText, FallbackValue='取消'}" Width="100" Height="36"
                    Margin="4" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
    </StackPanel>
</Window>

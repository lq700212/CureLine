<Window x:Class="CimGateway.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CureLine.ViewModels;assembly=CureLine.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LicenseActivationViewModel, IsDesignTimeCreatable=False}"
        Title="软件激活" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True" FontSize="13"
        Foreground="{DynamicResource Brush.Fresh.FgMid}">
    <shell:WindowChrome.WindowChrome>
        <!-- 无边框自绘（与登录窗同骨架）：CaptionHeight 撑标题条命中拖动，
             NoResize 窗不需要缩放边沿，系统按钮全关（自绘 ✕ 走取消链） -->
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <!--★★ 软件激活窗（程序②）：设备码展示 + 激活码粘贴 + 状态/错误提示。
         业务编排全在 CureLine.Core 的 LicenseActivationViewModel（两程序共用），
         本文件只管布局与剪贴板/关窗转发（MVVM：VM 不碰 Clipboard/Window）。
         设备码固定 Consolas 等宽字体：现场报码/抄码时 0/O、1/I 易混，等宽提高可读性。 -->
    <Grid Margin="14">
        <Border CornerRadius="10" Background="{DynamicResource Brush.Fresh.WinBg}"
                BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                Effect="{StaticResource Fx.WinShadow}">
            <DockPanel>
                <!-- 品牌标题条：与主窗/登录窗同源渐变；右侧关闭钮 -->
                <Border DockPanel.Dock="Top" Style="{StaticResource WinTitleBar}">
                    <Grid>
                        <TextBlock Text="软件激活" Style="{StaticResource WinTitleText}"/>
                        <Button Style="{StaticResource WinTitleClose}" Content="✕"
                                HorizontalAlignment="Right"
                                Click="OnCloseClick" ToolTip="关闭（Esc）"/>
                    </Grid>
                </Border>

                <StackPanel Margin="30,16,30,20">
                    <!-- 标题 + 所属程序（活动窗口标题区） -->
                    <TextBlock Text="软件激活" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Fresh.FgStrong}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppName, StringFormat=适用范围：{0}, FallbackValue=适用范围：CIM通信网关}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"
                               Foreground="{DynamicResource Brush.Fresh.FgMid}"/>

                    <!-- 当前授权状态条（状态+补充说明） -->
                    <Border Style="{StaticResource FreshHintBorder}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText, FallbackValue=激活状态：未激活}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                            <TextBlock Text="{Binding DetailText, FallbackValue=请把设备码提供给厂商}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Brush.Fresh.FgMid}"/>
                        </StackPanel>
                    </Border>

                    <!-- 设备码 -->
                    <TextBlock Text="设备码（发给厂商换取激活码）" Margin="0,14,0,5"
                               Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DeviceCodeBox" Grid.Column="0" Style="{StaticResource FreshInput}"
                                 Height="58" Padding="8,6,8,6" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Text="{Binding DeviceCode, Mode=OneWay, FallbackValue=CURE-XXXXXXXX-XXXXXXXX-XXXX}"/>
                        <Button Grid.Column="1" Style="{StaticResource FreshButton}" Content="复制"
                                Command="{x:Null}" Click="OnCopyDeviceCode"
                                VerticalAlignment="Top" Height="32" Margin="8,0,0,0"
                                ToolTip="复制设备码到剪贴板"/>
                    </Grid>

                    <!-- 激活码 -->
                    <TextBlock Text="激活码（粘贴厂商返回的完整激活码）" Margin="0,14,0,5"
                               Foreground="{DynamicResource Brush.Fresh.FgStrong}"/>
                    <TextBox Style="{StaticResource FreshInput}" Height="86" Padding="8,6,8,6"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="Consolas" FontSize="12"
                             Text="{Binding LicenseCode, UpdateSourceTrigger=PropertyChanged,
                                    FallbackValue=''}"/>

                    <!-- 提示条（错误/操作引导；Tip 为空整条收起）。
                         底/边/字全走 AlertErr* 键，Dark=低透明状态浸染。 -->
                    <Border CornerRadius="4" Padding="10,6" Margin="0,12,0,0"
                            Background="{DynamicResource Brush.Fresh.AlertErrBg}"
                            BorderBrush="{DynamicResource Brush.Fresh.AlertErrBorder}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tip, FallbackValue=提示占位}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Tip, FallbackValue=提示占位}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Fresh.AlertErrFg}"/>
                    </Border>

                    <!-- 按钮行：主操作=激活，次操作=关闭 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource FreshPrimaryButton}" Content="激 活"
                                Command="{Binding ActivateCommand}" Width="120" Height="32"
                                Margin="0,0,10,0"/>
                        <Button Style="{StaticResource FreshButton}" Content="关 闭"
                                Command="{Binding CloseCommand}" Width="96" Height="32"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

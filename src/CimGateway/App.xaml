<Application x:Class="CimGateway.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
    <!--
      CimGateway（CIM 通信网关，程序②）资源字典：
      双主题架构（2026-10-30 UI 对齐程序① CureStation，同构不同文件）：
      - Themes/Light.xaml（G2 浅色渐变浸染）/ Themes/Dark.xaml（G1 深空玻璃舱）
        各持一套【语义键】（Brush.WindowBg / Brush.CardBg / Brush.Fresh.* …），
        ThemeManager 替换 MergedDictionaries[0] 即全程序换皮（主窗 + 机台卡 +
        各弹窗全键化）；缺省挂 Light，App.OnStartup 按 config.ini [setting] Theme 再应用。
      - 旧 Styles/FreshBlue.xaml（单一浅色键板）已废止删除——其 FreshPrimaryButton/
        FreshCancelButton/FreshMenu* 等键由本文件 Fresh.* 样式族与主题字典接管。
      - 弹窗窗体统一 WindowStyle=None + WindowChrome（CaptionHeight 命中拖动 +
        ResizeBorderThickness 缩放）+ 自绘标题条（WinTitleBar 三样式，色复用主窗
        HeaderGrad/TopbarFg——品牌渐变条全程序一贯之）。
      - 主题键板是程序私有资产（与程序①同构不同文件，分机部署独立演进）。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 缺省浅色（XAML 期兜底）；运行时 ThemeManager 按 ini 覆换 -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--MVVM 布尔→显隐（机台卡显隐/旧密码行等用，全局一个）-->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- ============ 图标几何库（Geo.*，来源 galaxy 本地镜像） ============ -->
            <!-- 全部取自 E:\Project\galaxy（uiverse-io/galaxy 本地镜像）按钮样例内嵌
                 SVG 的 path d（24×24 stroke 线性风格，来源文件见每条注释；Geo.Link 为
                 feather icons link 直译同风格补拼）；配色不走固定值——按钮模板里
                 Path.Stroke 绑定 TemplateBinding Foreground，自动跟随各按钮样式的
                 主题前景键（GhostFg/PrimaryGhostFg/Fresh.FgStrong）。
                 WPF Path 与 SVG path 语法兼容（含紧凑弧参数），原样搬 d。 -->
            <Geometry x:Key="Geo.Login">M11.68 14.62 L14.24 12.06 L11.68 9.5 M4 12.06 H14.17 M12 4 C16.42 4 20 7 20 12 C20 17 16.42 20 12 20</Geometry>             <!-- galaxy/Buttons/catraco_blue-bulldog-58 -->
            <Geometry x:Key="Geo.Log">M5 7h14 M5 12h14 M5 17h14</Geometry>                                                                                        <!-- galaxy/Buttons/LeryLey_white-monkey-16 -->
            <Geometry x:Key="Geo.Debug">M11 15H6L13 1V9H18L11 23V15Z</Geometry>                                                                                   <!-- galaxy/Buttons/SelfMadeSystem_white-stingray-85 -->
            <Geometry x:Key="Geo.Config">m3 7h17c.5523 0 1 .44772 1 1v11c0 .5523-.4477 1-1 1h-16c-.55228 0-1-.4477-1-1z m3-2.5c0-.27614.22386-.5.5-.5h6.29289c.13261 0 .25981.05268.35351.14645l2.8536 2.85355h-10z</Geometry> <!-- galaxy/Buttons/andrew-demchenk0_swift-octopus-68 -->
            <Geometry x:Key="Geo.Edit">M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z</Geometry>                                                         <!-- galaxy/Buttons/barisdogansutcu_lovely-walrus-42 -->
            <Geometry x:Key="Geo.Link">M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71</Geometry> <!-- feather icons "link" 同风格直译 -->
            <Geometry x:Key="Geo.Reconnect">M8.288 14.212A5.25 5.25 0 1 1 17.25 10.5 M15.042 21.672 13.684 16.6l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672z</Geometry> <!-- galaxy/Buttons/seyed-mohsen-mousavi_weak-parrot-44 -->
            <Geometry x:Key="Geo.Save">m19 21H5c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2h11l5 5v11c0 1.1-.9 2-2 2z M7 3v5h8 M17 20v-7H7v7z</Geometry>                     <!-- galaxy/Buttons/ilkhoeri_chilly-sloth-36 -->
            <Geometry x:Key="Geo.Check">M4.5 12.75l6 6 9-13.5</Geometry>                                                                                          <!-- galaxy/Buttons/Creatlydev_dull-chicken-81 -->
            <Geometry x:Key="Geo.Posting">M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2 M7 9l5-5 5 5 M12 4v12</Geometry>                                              <!-- galaxy/Buttons/Itskrish01_chatty-lionfish-23 -->

            <!-- ============ 全站字体（老项目原样：微软雅黑） ============ -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="微软雅黑"/>
            </Style>
            <!-- Label 缺省字色走主题中阶（原系统黑字深色下不可读；个别强调处 XAML 自行覆盖） -->
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource Brush.FgMid}"/>
            </Style>

            <!-- ============ 主窗专用样式（色走语义键，随主题换皮） ============ -->
            <!-- 幽灵按钮：主窗顶栏胶囊（HTML .btn 直译 padding 5px 13px ≈ 27px 高）；
                 VerticalAlignment=Center 必守——顶栏按钮组与 Height=44 的系统三钮同池
                 （水平 StackPanel 子元素垂直默认 Stretch，不居中会被拉到 44 高"顶到顶"） -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.GhostBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.GhostBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.GhostFg}"/>
                <Setter Property="Padding" Value="13,5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <!-- 主窗无边框化后整个品牌顶栏都是 caption 拖动区，
                     顶栏里的按钮必须声明"chrome 可命中"否则点不到（样式级一次声明） -->
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <!-- 图标位（可选）：Tag 挂 Geo.* 几何即显示（Stroke 跟随按钮前景，
                                     随主题/悬停联动），不挂 Tag 时由触发器折叠——兼容纯文字钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Margin="0,0,5,0"
                                          VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostHoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GhostBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostPressedBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 主按钮态幽灵按钮（顶栏高亮钮用）：Light=白底蓝字 / Dark=蓝玻璃底 + 霓虹蓝字；
                 悬停边框沿用 Ghost 分键随主题变 -->
            <Style x:Key="PrimaryGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimaryGhostBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryGhostBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryGhostFg}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <!-- ============ 弹窗样式（色全部 DynamicResource 走主题字典 Fresh.* 键板） ============ -->
            <Style x:Key="FreshCardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
            <Style x:Key="FreshHintBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.HintBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <!-- 次级按钮（淡底浅蓝边）：圆角 + 悬停加深，弹窗内次操作/取消钮观感 -->
            <Style x:Key="FreshButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.ButtonBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <!-- 图标位（可选）：Tag 挂 Geo.* 几何即显示（Stroke 跟随前景键），
                                     不挂 Tag 时折叠——与 GhostButton 同构，见其注释 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Margin="0,0,5,0"
                                          VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonPressedBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 实色主按钮（CTA）：登录/保存/上传等主操作，蓝底白字悬停变深 -->
            <Style x:Key="FreshPrimaryButton" TargetType="Button" BasedOn="{StaticResource FreshButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.AccentBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.OnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.AccentPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 危险操作按钮（清空日志等破坏性操作）：红底白字 -->
            <Style x:Key="FreshDangerButton" TargetType="Button" BasedOn="{StaticResource FreshPrimaryButton}">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.Danger}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.DangerBorder}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.DangerHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.DangerPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 统一输入框（弹窗表单）：圆角 4、聚焦变主蓝边。
                 注意：PART_ContentHost 必须 Stretch 填满内容区，文字垂直居中交给
                 VerticalContentAlignment（TextBoxView 自己算）——模板里给 ScrollViewer
                 设 VerticalAlignment=Center 会收缩内容宿主、裁掉文字下半截（程序①实测教训） -->
            <Style x:Key="FreshInput" TargetType="TextBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="6,0,8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 密码输入框：与 FreshInput 同款（PasswordBox 是独立控件需独立模板）。
                 左 Padding 10 的来历（V0.0.40 像素实测校准，勿凭感觉改）：
                 自定义模板 ScrollViewer 已 Margin=Padding，控件内部又消费一次 Padding
                 ——文本左缘 = 框内白 + 2×左Padding + 控件基础内缩（TextBox 系 7px，
                 PasswordBox 3px）。登录窗用户名 TextBox 左 8（墨迹=框内+23），
                 密码框须 2×P+3 = 23 → P=10 两框首字符左缘同线；
                 动此值须按"冒烟截图+像素扫描"复核两框墨迹 x 坐标 -->
            <Style x:Key="FreshPwdInput" TargetType="PasswordBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0,8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 下拉框统一：与 FreshInput/按钮同高（32）同字号（继承窗口）——
                 全项目输入区"框=按钮=32"口径。完整自绘模板：透明 ToggleButton 全框命中
                 （ClickMode=Press 点哪都展开）+ 非可编辑态 SelectionBoxItem 展示 +
                 可编辑态 PART_EditableTextBox（叠在 ToggleButton 之上接住文本区点击）+
                 PART_Popup（主题弹层：CardBg 底 / Border 边 / 圆角 4 / MaxHeight 220 滚动）。
                 非可编辑态 ContentPresenter IsHitTestVisible=False 让点击穿透到 ToggleButton。 -->
            <Style x:Key="FreshCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Bd" Background="{DynamicResource Brush.Fresh.InputBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}"
                                        BorderThickness="1" CornerRadius="4"/>
                                <!-- 非可编辑态：显示选中项（可编辑态隐藏） -->
                                <ContentPresenter x:Name="Selected" Margin="10,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{DynamicResource Brush.Fresh.FgMid}"
                                                  IsHitTestVisible="False"/>
                                <!-- 点哪都开（透明命中铺满全框） -->
                                <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- 可编辑态文本框（改密窗用户下拉等：叠在 Toggle 之上接住文本区） -->
                                <TextBox x:Name="PART_EditableTextBox" Margin="8,0,26,0" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                         Padding="0" CaretBrush="{DynamicResource Brush.Fresh.FgMid}"
                                         Foreground="{DynamicResource Brush.Fresh.FgMid}" Visibility="Collapsed"/>
                                <!-- 箭头 -->
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Brush.Fresh.FgMid}"
                                      HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                                      IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                       Focusable="False">
                                    <Border Background="{DynamicResource Brush.Fresh.CardBg}"
                                            BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="2" Margin="0,2,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 下拉项（隐式）：圆角 3 胶囊行，悬停/选中=ButtonHoverBg -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 页签（网关配置窗两页，隐式全站生效） ============ -->
            <!-- 选中页签=卡底与内容框连体（页签行 Margin 底 -1 下压盖住内容框顶边线），
                 未选=透明纯文字；内容框=CardBg 底 + Border 边 + 右下圆角 -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Fresh.PanelBorder}"
                                        BorderThickness="0,0,0,1">
                                    <TabPanel IsItemsHost="True" Margin="0,0,0,-1" Background="Transparent"/>
                                </Border>
                                <Border Grid.Row="1" Background="{DynamicResource Brush.Fresh.CardBg}"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                        CornerRadius="0,6,6,6" Padding="10">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                    CornerRadius="6,6,0,0" Padding="14,7" Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 通用控件主题化（隐式，全程序弹窗+机台卡共用） ============ -->
            <!-- ListBox 容器本体：缺省 Aero2 底是白（dark 下刺眼大白块）——换 CardBg
                 无边框，与卡片面板融底；滚动条/列表行走下方各自样式。 -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            <!-- 列表行：选中=ButtonHoverBg 淡底；hover 提亮不换底(日志流连点不闪)。 -->
            <Style TargetType="ListBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 复选框（简约方框勾）：未选=InputBg 底 Border 边、选中=Accent 蓝底白勾 -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                        Background="{DynamicResource Brush.Fresh.InputBg}" VerticalAlignment="Center">
                                    <Path x:Name="Check" Data="M2.5,7.5 L6,11 L12,3.5"
                                          Stroke="{DynamicResource Brush.Fresh.OnAccent}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.AccentBorder}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 提示气泡：深浅跟随主题（CardBg 底/PanelBorder 边/FgMid 字——原系统白气泡深色下刺眼） -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.PanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 滚动条（胶囊化，4px 圆角拇指；默认隐藏轨道/分页区透明） ============ -->
            <!-- 透明 RepeatButton：Track 上下分页区（点击=翻页）不留视觉 -->
            <Style TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Bd" CornerRadius="4" Margin="2"
                                                            Background="{DynamicResource Brush.Fresh.ScrollThumb}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ScrollThumbHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- 横向：条高 8、分页方向不反转（纵向才反——右上往左下天经地义）。
                     属性元素纪律：Style.Triggers 只能有一个且置于全部 Setter 之后 -->
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False"
                                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="Bd" CornerRadius="4" Margin="2"
                                                                    Background="{DynamicResource Brush.Fresh.ScrollThumb}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ScrollThumbHover}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ============ 弹窗自绘标题条（WindowStyle=None + WindowChrome 窗体公用） ============ -->
            <!-- 色复用主窗品牌键：HeaderGrad 渐变条（Light 蓝渐变 / Dark 深蓝实底）+ TopbarFg 字，
                 底边 TopbarBorder——全程序一条品牌线。高 34（各窗 CaptionHeight 与其对齐）。
                 顶部圆角 10 与各弹窗外层圆角 Border 对齐（方角标题条会盖住外框圆角）。
                 阴影资源 Fx.WinShadow：圆角透明窗的浮层投影（窗根 Grid 需留 Margin≈14 给阴影渲染）。 -->
            <DropShadowEffect x:Key="Fx.WinShadow" Color="#000000" BlurRadius="24"
                              ShadowDepth="2" Opacity="0.55" Direction="270"/>
            <Style x:Key="WinTitleBar" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.HeaderGrad}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.TopbarBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="CornerRadius" Value="10,10,0,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>
            <Style x:Key="WinTitleText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TopbarFg}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- 关闭钮：命中区在标题条要 IsHitTestVisibleInChrome=True（落 caption 拖动区外）；
                 悬停红换白字（Win32 惯例）；焦点策略关闭（Alt 遍历不路过纯装饰钮） -->
            <Style x:Key="WinTitleClose" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TopbarFg}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.CloseHoverBg}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 主窗顶栏系统钮（无边框化专用，弹窗对齐口径） ============ -->
            <!-- 主窗品牌顶栏 44 高（弹窗标题条 34），系统钮铺满行高：宽 40 高 44；
                 hover 用主窗幽灵键（品牌条半透明白，与顶栏按钮 hover 同源），关闭沿用红色惯例。 -->
            <Style x:Key="WinSysBtn" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TopbarFg}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GhostPressedBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 关闭钮：业界惯例 hover 红（Fresh.CloseHoverBg）换白字，与弹窗 WinTitleClose 一致 -->
            <Style x:Key="WinSysClose" TargetType="Button" BasedOn="{StaticResource WinSysBtn}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.CloseHoverBg}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

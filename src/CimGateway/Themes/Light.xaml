<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Light 主题色板（G2 · 浅色渐变浸染，程序② CIM 通信网关版）：
      - 与程序① CureStation/Themes/Light.xaml 同源同值（G2 对比稿直译），只保留
        本程序有消费者的键——主窗（品牌顶栏/机台卡/状态灯）+ 弹窗键板 Fresh.*；
        程序①专用的仓位卡/统计胶囊/工单卡/日志悬浮窗键不随搬（无消费者不放键）；
      - 键名与 Dark.xaml 完全同名异值——ThemeManager 切字典即换肤，主窗/机台卡/
        各弹窗全 DynamicResource 取色，窗体 XAML 零主题分支；
      - 键名勿改：App.xaml 样式 Setter 与各窗 XAML 全按键名取色（改键名要同步
        两字典 + 所有 DynamicResource 引用点，ThemeDictionaryTests 文本级断言锁键）。
    -->

    <!-- ══════════ 窗底 / 品牌顶栏 ══════════ -->
    <!-- 主窗底 = G2 stage：160° 淡蓝下的白（HTML linear-gradient(160deg,#EAF1FA,#F5F8FC)） -->
    <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="0.45,1">
        <GradientStop Color="#EAF1FA" Offset="0"/>
        <GradientStop Color="#F5F8FC" Offset="1"/>
    </LinearGradientBrush>
    <!-- 品牌顶栏：品牌蓝横渐变（HTML linear-gradient(90deg,#1E90FF,#3AA9F7)） -->
    <LinearGradientBrush x:Key="Brush.HeaderGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E90FF" Offset="0"/>
        <GradientStop Color="#3AA9F7" Offset="1"/>
    </LinearGradientBrush>
    <!-- 顶栏底边（G2 无边=全透明；Dark 同名键给深色底边） -->
    <SolidColorBrush x:Key="Brush.TopbarBorder" Color="#00FFFFFF"/>
    <!-- 顶栏字：主字白、连接/时钟文本淡蓝白（HTML #FFFFFF / #EAF5FF） -->
    <SolidColorBrush x:Key="Brush.TopbarFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.HeaderSubFg" Color="#EAF5FF"/>
    <SolidColorBrush x:Key="Brush.HeaderChipBg" Color="#33FFFFFF"/>

    <!-- ══════════ 文字三阶（HTML 深 #17334F / 中 #52739C / 淡 #7A8CA0） ══════════ -->
    <SolidColorBrush x:Key="Brush.FgStrong" Color="#17334F"/>
    <SolidColorBrush x:Key="Brush.FgMid" Color="#52739C"/>
    <SolidColorBrush x:Key="Brush.FgDim" Color="#7A8CA0"/>
    <SolidColorBrush x:Key="Brush.FgOnAccent" Color="#FFFFFF"/>

    <!-- ══════════ 主色 ══════════ -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#1E90FF"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E3F0FC"/>

    <!-- ══════════ 面板玻璃（弹层共用） ══════════ -->
    <SolidColorBrush x:Key="Brush.PanelBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#CBD9E6"/>

    <!-- ══════════ 机台卡（主窗 8 实例卡：白卡底 / 淡蓝边 / 悬停提亮） ══════════ -->
    <SolidColorBrush x:Key="Brush.CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#80BED2EB"/>
    <SolidColorBrush x:Key="Brush.CardBorderHover" Color="#8FC1EC"/>

    <!-- ══════════ 状态点色（通讯灯/连接灯语义） ══════════ -->
    <SolidColorBrush x:Key="Brush.StateIdle" Color="#C3CBD3"/>   <!-- 待机/灭灯 -->
    <SolidColorBrush x:Key="Brush.StateRed" Color="#D32F2F"/>    <!-- 断连/报警 -->
    <SolidColorBrush x:Key="Brush.StateYellow" Color="#F59E0B"/> <!-- 暂态黄 -->
    <SolidColorBrush x:Key="Brush.StateGreen" Color="#43A047"/>  <!-- 在线/心跳正常 -->

    <!-- ══════════ 顶栏按钮（HTML .btn→半透明白玻璃 4px 圆角；高亮钮=白底蓝字） ══════════ -->
    <SolidColorBrush x:Key="Brush.GhostBg" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorder" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostHoverBg" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorderHover" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostPressedBg" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBorder" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostFg" Color="#1E90FF"/>

    <!-- ══════════ 弹窗键板 Fresh.*（弹窗跟主题，与程序① Light 同值） ══════════ -->
    <!-- 功能弹窗（登录/改密/网关配置/调试/日志/报警/图片）样式 Setter 全部
         DynamicResource 指向本段键；Dark.xaml 同名异值 G1 深空玻璃口径。
         键名勿改：App.xaml 弹窗样式的 DynamicResource 引用点与本段须同步。 -->
    <SolidColorBrush x:Key="Brush.Fresh.CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.HintBg" Color="#EFF6FD"/>
    <SolidColorBrush x:Key="Brush.Fresh.Border" Color="#B8D4EE"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgStrong" Color="#1F4E79"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgMid" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgDim" Color="#888888"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonBg" Color="#F5FAFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBg" Color="#E3F0FC"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBorder" Color="#8FC1EC"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonPressedBg" Color="#D0E6F9"/>
    <SolidColorBrush x:Key="Brush.Fresh.Accent" Color="#1E90FF"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentBorder" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentHover" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentPressed" Color="#135EA8"/>
    <SolidColorBrush x:Key="Brush.Fresh.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.Danger" Color="#D9534F"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerBorder" Color="#C9302C"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerHover" Color="#C9302C"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerPressed" Color="#AC2925"/>
    <SolidColorBrush x:Key="Brush.Fresh.InputBg" Color="#FFFFFF"/>
    <!-- 窗体骨架（弹窗 WindowStyle=None 自绘：窗底 / 关闭钮悬停红） -->
    <SolidColorBrush x:Key="Brush.Fresh.WinBg" Color="#F2F7FC"/>
    <SolidColorBrush x:Key="Brush.Fresh.CloseHoverBg" Color="#E81123"/>
    <!-- 变体面板（分区底边 + 子卡只读框） -->
    <SolidColorBrush x:Key="Brush.Fresh.PanelBorder" Color="#D7E4F2"/>
    <SolidColorBrush x:Key="Brush.Fresh.SubCardBg" Color="#FBFDFF"/>
    <!-- 提示条两族（错误红 / 成功绿：底-边-字） -->
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrBg" Color="#FDECEA"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrBorder" Color="#F5C6CB"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertErrFg" Color="#C8102E"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkBg" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkBorder" Color="#C8E6C9"/>
    <SolidColorBrush x:Key="Brush.Fresh.AlertOkFg" Color="#2E7D32"/>
    <!-- 滚动条胶囊（常态/悬停） -->
    <SolidColorBrush x:Key="Brush.Fresh.ScrollThumb" Color="#BFD3E8"/>
    <SolidColorBrush x:Key="Brush.Fresh.ScrollThumbHover" Color="#8FC1EC"/>
</ResourceDictionary>

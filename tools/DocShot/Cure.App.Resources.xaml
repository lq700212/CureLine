            <!-- ============ 主窗专用样式（色走语义键，随主题换皮） ============ -->
            <!-- 细进度条（4px 圆角胶囊）：仓位卡计时 / 工单带产出共用。
                 Foreground 由使用处定（本样式统一给状态绿）；模板依赖 ProgressBar
                 约定名 PART_Track / PART_Indicator——勿改名。 -->
            <Style x:Key="SlotProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="4"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.StateGreen}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="2"
                                        Background="{DynamicResource Brush.BarTrack}"/>
                                <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 弹窗样式（色全部 DynamicResource 走主题字典 Fresh.* 键板） ============ -->
            <Style x:Key="FreshCardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
            <Style x:Key="FreshHintBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.HintBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <!-- 下拉项（隐式）：圆角 3 胶囊行，悬停/选中=ButtonHoverBg（Fresh.AccentSoft 未入键板——
                 本样式随弹层走 Fresh 键板，借按钮悬停底色一档即可） -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 密码输入框：与 FreshInput 同款（PasswordBox 是独立控件需独立模板）。
                 Padding 左 3 非 6 是实测校准值：PasswordBox 内部渲染无 TextBoxView 的
                 额外内缩，同抄 6 会让密码首字符比用户名编辑框文本（模板 Margin 8）
                 靠右约 3 逻辑 px——登录窗"账号/密码文本左缘对齐" UI 契约（AGENTS.md），
                 动此值须跑目检截图像素比对两框首字符左缘 -->
            <Style x:Key="FreshPwdInput" TargetType="PasswordBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="3,0,8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.InputBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 数据网格（弹窗通用，随主题换皮） ============ -->
            <!-- 行底透明露卡底（嵌在 FreshCardBorder 内）；行宽横线走 GridLine 键；
                 单元格字色走 Cell Foreground（TextElement.Foreground 沿树继承到 TextBlock）；
                 选中格=GridSelBg + FgStrong（行模板的系统蓝选中底会被透明格底盖住） -->
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="Transparent"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Fresh.GridLine}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Fresh.GridLine}"/>
            </Style>
            <!-- 列头（不重模板：默认模板 Background/Foreground 走 TemplateBinding，setter 即生效） -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.GridHeaderBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.GridLine}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Fresh.GridSelBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 单选按钮（追溯报表页签用，V0.0.97）：不重模板（系统圆点外观两主题
                 都可辨），只统一前景色/间距/垂直对齐——文字色走主题键，深色主题下
                 不发黑。互斥靠 RadioButton 的 GroupName（同组自动取消另一只），
                 回写链唯一：一只双向绑 bool，另一只 OneWay + 反向转换器只显示。 -->
            <Style x:Key="FreshRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- ============ 通用控件主题化（隐式，全程序弹窗+日志窗共用） ============ -->
            <!-- ListBox 容器本体：缺省 Aero2 底是白（dark 下刺眼大白块）——V0.0.27 换 CardBg
                 无边框，与卡片面板融底；滚动条/列表行走下方各自样式。 -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            <!-- 列表行：选中=ButtonHoverBg 淡底；hover 提亮不换底(日志流连点不闪)。
                 显式 ItemContainerStyle（如 LogWindow 日志行）会整体覆盖本隐式样式，不受影响。 -->
            <Style TargetType="ListBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ButtonHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 复选框（简约方框勾）：未选=InputBg 底 Border 边、选中=Accent 蓝底白勾 -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                        BorderBrush="{DynamicResource Brush.Fresh.Border}" BorderThickness="1"
                                        Background="{DynamicResource Brush.Fresh.InputBg}" VerticalAlignment="Center">
                                    <Path x:Name="Check" Data="M2.5,7.5 L6,11 L12,3.5"
                                          Stroke="{DynamicResource Brush.Fresh.OnAccent}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.AccentBorder}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Fresh.ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 折叠面板（点表窗"设备高级参数"）：标题行简绘箭头（展开=下指，折叠=右旋 -90°），
                 只做向下展开一种方向（全部使用处皆缺省方向） -->
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgStrong}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,2">
                                                <Path x:Name="Arrow" Data="M1,1 L4,4 L7,1"
                                                      Stroke="{DynamicResource Brush.Fresh.FgMid}" StrokeThickness="1.5"
                                                      VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  TextElement.Foreground="{DynamicResource Brush.Fresh.FgStrong}"
                                                                  TextElement.FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Brush.Fresh.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 提示气泡：深浅跟随主题（CardBg 底/PanelBorder 边/FgMid 字——原系统白气泡深色下刺眼） -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Brush.Fresh.CardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fresh.FgMid}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fresh.PanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ 滚动条（胶囊化，4px 圆角拇指；默认隐藏轨道/分页区透明） ============ -->
            <!-- 透明 RepeatButton：Track 上下分页区（点击=翻页）不留视觉 -->
            <Style TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Bd" CornerRadius="4" Margin="2"
                                                            Background="{DynamicResource Brush.Fresh.ScrollThumb}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ScrollThumbHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- 横向：条高 8、分页方向不反转（纵向才反——右上往左下天经地义）。
                     属性元素纪律：Style.Triggers 只能有一个且置于全部 Setter 之后 -->
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False"
                                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="Bd" CornerRadius="4" Margin="2"
                                                                    Background="{DynamicResource Brush.Fresh.ScrollThumb}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Fresh.ScrollThumbHover}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

        
</ResourceDictionary>

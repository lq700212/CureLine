<Window x:Class="LicenseIssuer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件激活码签发工具"
        Width="780" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="微软雅黑" FontSize="13"
        Background="#F2F7FC" Foreground="#1F2A3A">
    <!--
      签发工具窗（厂商内部，绝不随客户现场部署包分发）。
      布局三段：设备信息 → 授权类型 → 激活码输出；底部状态行 + 主操作。
      产品识别自动完成：粘贴 CURE-… 设备码签 CureLine 码，HUAJI-… 签 HJVision 码，
      payload 产品 ID 与设备码前缀同源（LicenseCodec），两个产品共用同一把密钥对。
    -->
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9D6E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9D6E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#EDF4FB"/>
            <Setter Property="BorderBrush" Value="#B7D0E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="#1F6FB2"/>
            <Setter Property="BorderBrush" Value="#1A5E96"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7C90"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="软件激活码签发工具" FontSize="20" FontWeight="Bold"
                       Foreground="#173B60"/>
            <TextBlock Text="厂商内部使用 · 私钥 LicenseSignKey.dat 禁止外发；支持 CureLine（CURE-…）与 HJVision（HUAJI-…）双产品"
                       Style="{StaticResource Hint}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 设备信息 -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="设备信息" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DeviceBox" Grid.Column="0" Style="{StaticResource Input}"
                             FontFamily="Consolas" FontSize="12"
                             TextChanged="OnDeviceChanged"
                             ToolTip="客户在激活窗点【复制设备码】整串发来（含校验位，勿手抄）"/>
                    <Button Grid.Column="1" Style="{StaticResource Button}" Content="粘贴设备码"
                            Margin="8,0,0,0" Click="OnPasteDevice"/>
                </Grid>
                <TextBlock x:Name="ProductText" Style="{StaticResource Hint}" Margin="0,7,0,0"
                           Text="识别产品：等待输入设备码"/>
            </StackPanel>
        </Border>

        <!-- 授权类型 -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="授权类型与有效期" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PermRadio" Content="永久授权" IsChecked="True"
                                 VerticalAlignment="Center" Checked="OnTypeChanged"/>
                    <RadioButton x:Name="TrialRadio" Content="试用授权" Margin="24,0,0,0"
                                 VerticalAlignment="Center" Checked="OnTypeChanged"/>
                    <TextBlock Text="试用天数" VerticalAlignment="Center" Margin="32,0,8,0"/>
                    <TextBox x:Name="DaysBox" Style="{StaticResource Input}" Width="90"
                             Text="30" VerticalContentAlignment="Center"
                             TextAlignment="Center" TextChanged="OnDaysChanged"/>
                    <TextBlock x:Name="ExpiryText" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="到期日 = 签发日 + N 天（到期当天 24 点前仍可用）"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 激活码 -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="激活码" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="CodeBox" Height="92" Padding="7,6"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True"
                         Background="#F7FAFD" BorderBrush="#C9D6E6" BorderThickness="1"
                         ToolTip="生成的激活码整串发给客户，在激活窗粘贴即可"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource Button}" Content="复制激活码" Click="OnCopyCode"/>
                    <Button Style="{StaticResource Button}" Content="清空" Margin="8,0,0,0" Click="OnClear"/>
                    <Button x:Name="GenKeyButton" Style="{StaticResource Button}"
                            Content="生成密钥对" Margin="8,0,0,0" Click="OnGenKey"
                            ToolTip="首次使用先生成；已有私钥时禁用，防止误覆盖信任根"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部：状态 + 主操作 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="#6B7C90"/>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                    Content="生成激活码" Width="150" Click="OnIssue"/>
        </Grid>
    </Grid>
</Window>
